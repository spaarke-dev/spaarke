<?xml version="1.0" encoding="utf-8"?>
<!--
  The ONE authored definition of the shared "Access" form group (unified-access-control-r2 task 142; owner round 3 R3
  "Update Access" + round 3b UX, disposition row 4: ONE group, ONE source file, ONE script - task 150 added Make Secure /
  Remove Secure HERE, never a second group or script). Make Secure is a release-gated item: it is generated only with
  Merge-AccessRibbon.ps1 -SecureTransitionDeployed (task 148's transition deployed in the target environment, the same
  release); without it the merge removes it, and Update Access + Remove Secure ship alone.

  NEVER hand-edit a per-entity copy. Merge-AccessRibbon.ps1 instantiates this template for one entity ({{entity}} =
  the LOGICAL name: sprk_project | sprk_matter | sprk_workassignment) and merges it into a FRESH export of that entity's
  RibbonDiffXml, removing any earlier sprk.Access.* nodes first (idempotent), so every other command on the form is kept.

  Realisation (Unified Interface): a ribbon Group does not render as a visual container in the UCI command bar, so the
  group is ONE FlyoutAnchor holding the commands as menu items - the FORM precedent is the "Dark Mode" flyout
  (ThemeMenuRibbons/Other/Customizations.xml, sprk.ThemeMenu.Project.Form.CustomAction on
  Mscrm.Form.sprk_project.MainTab.Actions.Controls._children). UCI HIDES a command whose enable rule is false, so the
  flyout is hidden when none of its items is available (isAccessMenuVisible), and Update Access is hidden for a caller
  without Write (canUpdateAccess asks GET /api/v1/external-access/can-manage-access - the server's own verdict).

  Libraries: ribbon commands do not load form libraries, so EVERY action and enable rule lists, in order,
  bff_auth.js -> assignedaccess_postsave.js -> access_ribbon.js (the leading two as FunctionName="isNaN": loads the
  library, no side effect, and isNaN() is true so an AND-ed CustomRule is unaffected).
-->
<AccessRibbon xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <CustomActions>
    <CustomAction Id="sprk.Access.{{entity}}.Form.CustomAction"
                  Location="Mscrm.Form.{{entity}}.MainTab.Actions.Controls._children"
                  Sequence="905">
      <CommandUIDefinition>
        <FlyoutAnchor Id="sprk.Access.{{entity}}.Form.Flyout"
                      Command="sprk.Access.{{entity}}.Menu.Command"
                      LabelText="$LocLabels:sprk.Access.{{entity}}.Menu.LabelText"
                      Alt="$LocLabels:sprk.Access.{{entity}}.Menu.LabelText"
                      ToolTipTitle="$LocLabels:sprk.Access.{{entity}}.Menu.LabelText"
                      ToolTipDescription="$LocLabels:sprk.Access.{{entity}}.Menu.ToolTipDescription"
                      ModernImage="Permissions"
                      PopulateDynamically="false"
                      TemplateAlias="o1">
          <Menu Id="sprk.Access.{{entity}}.Form.Menu">
            <MenuSection Id="sprk.Access.{{entity}}.Form.Section" Title="Access" Sequence="10">
              <Controls Id="sprk.Access.{{entity}}.Form.Controls">
                <Button Id="sprk.Access.{{entity}}.Form.UpdateAccess"
                        Command="sprk.Access.{{entity}}.UpdateAccess.Command"
                        LabelText="$LocLabels:sprk.Access.{{entity}}.UpdateAccess.LabelText"
                        Alt="$LocLabels:sprk.Access.{{entity}}.UpdateAccess.LabelText"
                        ToolTipTitle="$LocLabels:sprk.Access.{{entity}}.UpdateAccess.LabelText"
                        ToolTipDescription="$LocLabels:sprk.Access.{{entity}}.UpdateAccess.ToolTipDescription"
                        ModernImage="Refresh"
                        Sequence="10" />
                <!-- Task 150. Make Secure ships only where task 148's transition is deployed: Merge-AccessRibbon.ps1
                     removes every sprk.Access.{{entity}}.MakeSecure.* node unless -SecureTransitionDeployed. -->
                <Button Id="sprk.Access.{{entity}}.Form.MakeSecure"
                        Command="sprk.Access.{{entity}}.MakeSecure.Command"
                        LabelText="$LocLabels:sprk.Access.{{entity}}.MakeSecure.LabelText"
                        Alt="$LocLabels:sprk.Access.{{entity}}.MakeSecure.LabelText"
                        ToolTipTitle="$LocLabels:sprk.Access.{{entity}}.MakeSecure.LabelText"
                        ToolTipDescription="$LocLabels:sprk.Access.{{entity}}.MakeSecure.LabelText"
                        ModernImage="Permissions"
                        Sequence="20" />
                <Button Id="sprk.Access.{{entity}}.Form.RemoveSecure"
                        Command="sprk.Access.{{entity}}.RemoveSecure.Command"
                        LabelText="$LocLabels:sprk.Access.{{entity}}.RemoveSecure.LabelText"
                        Alt="$LocLabels:sprk.Access.{{entity}}.RemoveSecure.LabelText"
                        ToolTipTitle="$LocLabels:sprk.Access.{{entity}}.RemoveSecure.LabelText"
                        ToolTipDescription="$LocLabels:sprk.Access.{{entity}}.RemoveSecure.LabelText"
                        ModernImage="Cancel"
                        Sequence="30" />
              </Controls>
            </MenuSection>
          </Menu>
        </FlyoutAnchor>
      </CommandUIDefinition>
    </CustomAction>
  </CustomActions>

  <CommandDefinitions>
    <CommandDefinition Id="sprk.Access.{{entity}}.Menu.Command">
      <EnableRules>
        <EnableRule Id="sprk.Access.{{entity}}.MenuVisible.EnableRule" />
      </EnableRules>
      <DisplayRules />
      <Actions />
    </CommandDefinition>
    <CommandDefinition Id="sprk.Access.{{entity}}.UpdateAccess.Command">
      <EnableRules>
        <EnableRule Id="sprk.Access.{{entity}}.CanUpdateAccess.EnableRule" />
      </EnableRules>
      <DisplayRules />
      <Actions>
        <JavaScriptFunction Library="$webresource:sprk_/scripts/bff_auth.js" FunctionName="isNaN" />
        <JavaScriptFunction Library="$webresource:sprk_/scripts/assignedaccess_postsave.js" FunctionName="isNaN" />
        <JavaScriptFunction Library="$webresource:sprk_/scripts/access_ribbon.js"
                            FunctionName="Spaarke.Access.Ribbon.updateAccess">
          <CrmParameter Value="PrimaryControl" />
        </JavaScriptFunction>
      </Actions>
    </CommandDefinition>
    <CommandDefinition Id="sprk.Access.{{entity}}.MakeSecure.Command">
      <EnableRules>
        <EnableRule Id="sprk.Access.{{entity}}.MakeSecure.EnableRule" />
      </EnableRules>
      <DisplayRules />
      <Actions>
        <JavaScriptFunction Library="$webresource:sprk_/scripts/bff_auth.js" FunctionName="isNaN" />
        <JavaScriptFunction Library="$webresource:sprk_/scripts/assignedaccess_postsave.js" FunctionName="isNaN" />
        <JavaScriptFunction Library="$webresource:sprk_/scripts/access_ribbon.js"
                            FunctionName="Spaarke.Access.Ribbon.makeSecure">
          <CrmParameter Value="PrimaryControl" />
        </JavaScriptFunction>
      </Actions>
    </CommandDefinition>
    <CommandDefinition Id="sprk.Access.{{entity}}.RemoveSecure.Command">
      <EnableRules>
        <EnableRule Id="sprk.Access.{{entity}}.RemoveSecure.EnableRule" />
      </EnableRules>
      <DisplayRules />
      <Actions>
        <JavaScriptFunction Library="$webresource:sprk_/scripts/bff_auth.js" FunctionName="isNaN" />
        <JavaScriptFunction Library="$webresource:sprk_/scripts/assignedaccess_postsave.js" FunctionName="isNaN" />
        <JavaScriptFunction Library="$webresource:sprk_/scripts/access_ribbon.js"
                            FunctionName="Spaarke.Access.Ribbon.removeSecure">
          <CrmParameter Value="PrimaryControl" />
        </JavaScriptFunction>
      </Actions>
    </CommandDefinition>
  </CommandDefinitions>

  <EnableRules>
    <EnableRule Id="sprk.Access.{{entity}}.MenuVisible.EnableRule">
      <CustomRule Library="$webresource:sprk_/scripts/bff_auth.js" FunctionName="isNaN" Default="false" />
      <CustomRule Library="$webresource:sprk_/scripts/assignedaccess_postsave.js" FunctionName="isNaN" Default="false" />
      <CustomRule Library="$webresource:sprk_/scripts/access_ribbon.js"
                  FunctionName="Spaarke.Access.Ribbon.isAccessMenuVisible" Default="false">
        <CrmParameter Value="PrimaryControl" />
      </CustomRule>
    </EnableRule>
    <EnableRule Id="sprk.Access.{{entity}}.CanUpdateAccess.EnableRule">
      <CustomRule Library="$webresource:sprk_/scripts/bff_auth.js" FunctionName="isNaN" Default="false" />
      <CustomRule Library="$webresource:sprk_/scripts/assignedaccess_postsave.js" FunctionName="isNaN" Default="false" />
      <CustomRule Library="$webresource:sprk_/scripts/access_ribbon.js"
                  FunctionName="Spaarke.Access.Ribbon.canUpdateAccess" Default="false">
        <CrmParameter Value="PrimaryControl" />
      </CustomRule>
    </EnableRule>
    <EnableRule Id="sprk.Access.{{entity}}.MakeSecure.EnableRule">
      <CustomRule Library="$webresource:sprk_/scripts/bff_auth.js" FunctionName="isNaN" Default="false" />
      <CustomRule Library="$webresource:sprk_/scripts/assignedaccess_postsave.js" FunctionName="isNaN" Default="false" />
      <CustomRule Library="$webresource:sprk_/scripts/access_ribbon.js"
                  FunctionName="Spaarke.Access.Ribbon.canMakeSecure" Default="false">
        <CrmParameter Value="PrimaryControl" />
      </CustomRule>
    </EnableRule>
    <!-- Task 114 (owner round 67 amendment 4(a)): appended to the PLATFORM's own form Share command, which
         Merge-AccessRibbon.ps1 copies from the live ribbon (-ShareCommandXml) - never authored here, so the platform's
         own enable and display rules are kept. Hides Share on a Restricted record. -->
    <EnableRule Id="sprk.Access.{{entity}}.ShareAllowed.EnableRule">
      <CustomRule Library="$webresource:sprk_/scripts/bff_auth.js" FunctionName="isNaN" Default="false" />
      <CustomRule Library="$webresource:sprk_/scripts/assignedaccess_postsave.js" FunctionName="isNaN" Default="false" />
      <CustomRule Library="$webresource:sprk_/scripts/access_ribbon.js"
                  FunctionName="Spaarke.Access.Ribbon.isShareAllowed" Default="false">
        <CrmParameter Value="PrimaryControl" />
      </CustomRule>
    </EnableRule>
    <!-- Task 114 follow-up: appended to the PLATFORM's own GRID and SUBGRID Share command(s) (Merge-AccessRibbon.ps1
         -GridShareCommandXml, copied from the live ribbon). A grid has no single record: hides Share when ANY selected
         row is Restricted. -->
    <EnableRule Id="sprk.Access.{{entity}}.ShareAllowedSelection.EnableRule">
      <CustomRule Library="$webresource:sprk_/scripts/bff_auth.js" FunctionName="isNaN" Default="false" />
      <CustomRule Library="$webresource:sprk_/scripts/assignedaccess_postsave.js" FunctionName="isNaN" Default="false" />
      <CustomRule Library="$webresource:sprk_/scripts/access_ribbon.js"
                  FunctionName="Spaarke.Access.Ribbon.isShareAllowedForSelection" Default="false">
        <CrmParameter Value="SelectedControlSelectedItemIds" />
        <CrmParameter Value="SelectedEntityTypeName" />
      </CustomRule>
    </EnableRule>
    <EnableRule Id="sprk.Access.{{entity}}.RemoveSecure.EnableRule">
      <CustomRule Library="$webresource:sprk_/scripts/bff_auth.js" FunctionName="isNaN" Default="false" />
      <CustomRule Library="$webresource:sprk_/scripts/assignedaccess_postsave.js" FunctionName="isNaN" Default="false" />
      <CustomRule Library="$webresource:sprk_/scripts/access_ribbon.js"
                  FunctionName="Spaarke.Access.Ribbon.canRemoveSecure" Default="false">
        <CrmParameter Value="PrimaryControl" />
      </CustomRule>
    </EnableRule>
  </EnableRules>

  <LocLabels>
    <LocLabel Id="sprk.Access.{{entity}}.Menu.LabelText">
      <Titles><Title description="Access" languagecode="1033" /></Titles>
    </LocLabel>
    <LocLabel Id="sprk.Access.{{entity}}.Menu.ToolTipDescription">
      <Titles><Title description="Access commands for this record" languagecode="1033" /></Titles>
    </LocLabel>
    <LocLabel Id="sprk.Access.{{entity}}.UpdateAccess.LabelText">
      <Titles><Title description="Update Access" languagecode="1033" /></Titles>
    </LocLabel>
    <LocLabel Id="sprk.Access.{{entity}}.UpdateAccess.ToolTipDescription">
      <Titles><Title description="Give this record's assigned people their access now and re-apply its No Access list" languagecode="1033" /></Titles>
    </LocLabel>
    <LocLabel Id="sprk.Access.{{entity}}.MakeSecure.LabelText">
      <Titles><Title description="Make Secure" languagecode="1033" /></Titles>
    </LocLabel>
    <LocLabel Id="sprk.Access.{{entity}}.RemoveSecure.LabelText">
      <Titles><Title description="Remove Secure" languagecode="1033" /></Titles>
    </LocLabel>
  </LocLabels>
</AccessRibbon>
