<?xml version="1.0" encoding="utf-8"?>
<!--
  DRY-RUN FIXTURE ONLY - never imported, and NOT a copy of the platform's definition.

  unified-access-control-r2 task 114 (owner round 67 amendment 4(a)). Set-AccessRibbon.ps1's dry run has no Dataverse to
  read the platform's form Share command from, so it hands Merge-AccessRibbon.ps1 this stand-in, which has the SHAPE the
  merge works on (one CommandDefinition with EnableRules, DisplayRules and Actions) so the transformation - copy, strip
  sprk.Access.* rule references, append sprk.Access.<entity>.ShareAllowed.EnableRule, idempotent - is exercised before
  any import. -Apply never uses this file: it reads the live command with RetrieveEntityRibbon (the Command of the
  Mscrm.Form.<entity>.Share button) and merges THAT, so the platform's real rules are what ship.
-->
<CommandDefinition Id="Mscrm.SharePrimaryRecord">
  <EnableRules>
    <EnableRule Id="Mscrm.FormStateNotNew" />
  </EnableRules>
  <DisplayRules>
    <DisplayRule Id="Mscrm.SharePrimaryEntityPermission" />
  </DisplayRules>
  <Actions>
    <JavaScriptFunction FunctionName="isNaN" Library="$webresource:sprk_/scripts/access_ribbon.js" />
  </Actions>
</CommandDefinition>
