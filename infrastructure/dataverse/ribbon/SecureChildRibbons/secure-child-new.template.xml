<?xml version="1.0" encoding="utf-8"?>
<!--
  The ONE authored definition of the secure-record child "New" commands (unified-access-control-r2 task 147 r1; owner
  round 28 item 2, "E2"). Instantiated per CHILD entity by Merge-SecureChildRibbon.ps1 ({{entity}} = the child's logical
  name, {{label}} = its display noun) and merged into a FRESH export of that entity's RibbonDiffXml. Never hand-edit a
  per-entity copy.

  Two parts, one per command a subgrid of the child shows:

  1. The platform's own subgrid "+ New" (Mscrm.AddNewRecordFromSubGridStandard - the parent-prefilled create) gets ONE
     extra enable rule, sprk.SecureChild.{{entity}}.NativeNewAllowed.EnableRule: allowed only when the host record is a
     project / matter / work assignment read (through Xrm.WebApi) as NOT secure, or a party (contact, organization,
     account - never an ownership parent; task 147 r1c). Any other host - a child of a secure record's child - hides it
     and shows the BFF command. Everything else in the definition below is the platform's,
     copied from RetrieveEntityRibbon on spaarkedev1 (2026-10-04) - the merge script re-checks it against the live
     definition before an import (Deploy-SecureChildNewCommands.ps1 dry run) and refuses on drift.

  2. A "New {{label}}" button on the same subgrid (Mscrm.SubGrid.{{entity}}.MainTab.Management.Controls._children) whose
     enable rule is the exact complement: shown when the host is secure, or cannot be told. It opens the product's
     BFF-backed create surface (sprk_secure_child_ribbon.js - Spaarke.SecureChild.Ribbon.newChild).

  Libraries: every action and enable rule lists bff_auth.js -> assignedaccess_postsave.js -> secure_child_ribbon.js (the
  leading two as FunctionName="isNaN": loads the library, no side effect; isNaN() is true so an AND-ed rule is unaffected).
-->
<SecureChildRibbon xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <CustomActions>
    <CustomAction Id="sprk.SecureChild.{{entity}}.SubGrid.New.CustomAction"
                  Location="Mscrm.SubGrid.{{entity}}.MainTab.Management.Controls._children"
                  Sequence="4">
      <CommandUIDefinition>
        <Button Id="sprk.SecureChild.{{entity}}.SubGrid.New"
                Command="sprk.SecureChild.{{entity}}.New.Command"
                LabelText="$LocLabels:sprk.SecureChild.{{entity}}.New.LabelText"
                Alt="$LocLabels:sprk.SecureChild.{{entity}}.New.LabelText"
                ToolTipTitle="$LocLabels:sprk.SecureChild.{{entity}}.New.LabelText"
                ToolTipDescription="$LocLabels:sprk.SecureChild.{{entity}}.New.ToolTipDescription"
                ModernImage="Add"
                Sequence="4"
                TemplateAlias="o1" />
      </CommandUIDefinition>
    </CustomAction>
  </CustomActions>

  <CommandDefinitions>
    <CommandDefinition Id="Mscrm.AddNewRecordFromSubGridStandard">
      <EnableRules>
        <EnableRule Id="Mscrm.AppendToPrimary" />
        <EnableRule Id="Mscrm.EntityFormIsEnabled" />
        <EnableRule Id="Mscrm.IsEntityAvailableForUserInMocaOffline" />
        <EnableRule Id="sprk.SecureChild.{{entity}}.NativeNewAllowed.EnableRule" />
      </EnableRules>
      <DisplayRules>
        <DisplayRule Id="Mscrm.ShowForOneToManyGrids" />
        <DisplayRule Id="Mscrm.AppendToPrimary" />
        <DisplayRule Id="Mscrm.CreateSelectedEntityPermission" />
        <DisplayRule Id="Mscrm.AppendSelected" />
        <DisplayRule Id="Mscrm.HideAddNewForChildEntities" />
      </DisplayRules>
      <Actions>
        <JavaScriptFunction FunctionName="XrmCore.Commands.Open.addNewFromSubGridStandard" Library="$webresource:Main_system_library.js">
          <CrmParameter Value="SelectedEntityTypeName" />
          <CrmParameter Value="PrimaryEntityTypeName" />
          <CrmParameter Value="FirstPrimaryItemId" />
          <CrmParameter Value="PrimaryControl" />
          <CrmParameter Value="SelectedControl" />
        </JavaScriptFunction>
      </Actions>
    </CommandDefinition>
    <CommandDefinition Id="sprk.SecureChild.{{entity}}.New.Command">
      <EnableRules>
        <EnableRule Id="sprk.SecureChild.{{entity}}.NewAvailable.EnableRule" />
      </EnableRules>
      <DisplayRules>
        <DisplayRule Id="Mscrm.CreateSelectedEntityPermission" />
      </DisplayRules>
      <Actions>
        <JavaScriptFunction Library="$webresource:sprk_/scripts/bff_auth.js" FunctionName="isNaN" />
        <JavaScriptFunction Library="$webresource:sprk_/scripts/assignedaccess_postsave.js" FunctionName="isNaN" />
        <JavaScriptFunction Library="$webresource:sprk_/scripts/secure_child_ribbon.js"
                            FunctionName="Spaarke.SecureChild.Ribbon.newChild">
          <CrmParameter Value="PrimaryControl" />
          <CrmParameter Value="SelectedControl" />
          <StringParameter Value="{{entity}}" />
        </JavaScriptFunction>
      </Actions>
    </CommandDefinition>
  </CommandDefinitions>

  <EnableRules>
    <EnableRule Id="sprk.SecureChild.{{entity}}.NativeNewAllowed.EnableRule">
      <CustomRule Library="$webresource:sprk_/scripts/secure_child_ribbon.js"
                  FunctionName="Spaarke.SecureChild.Ribbon.nativeNewAllowed" Default="false">
        <CrmParameter Value="PrimaryControl" />
      </CustomRule>
    </EnableRule>
    <EnableRule Id="sprk.SecureChild.{{entity}}.NewAvailable.EnableRule">
      <CustomRule Library="$webresource:sprk_/scripts/bff_auth.js" FunctionName="isNaN" Default="false" />
      <CustomRule Library="$webresource:sprk_/scripts/assignedaccess_postsave.js" FunctionName="isNaN" Default="false" />
      <CustomRule Library="$webresource:sprk_/scripts/secure_child_ribbon.js"
                  FunctionName="Spaarke.SecureChild.Ribbon.newChildAvailable" Default="false">
        <CrmParameter Value="PrimaryControl" />
      </CustomRule>
    </EnableRule>
  </EnableRules>

  <LocLabels>
    <LocLabel Id="sprk.SecureChild.{{entity}}.New.LabelText">
      <Titles><Title description="New {{label}}" languagecode="1033" /></Titles>
    </LocLabel>
    <LocLabel Id="sprk.SecureChild.{{entity}}.New.ToolTipDescription">
      <Titles><Title description="Add a {{label}} to this secure record (saved by Spaarke so it stays as private as the record)" languagecode="1033" /></Titles>
    </LocLabel>
  </LocLabels>
</SecureChildRibbon>
