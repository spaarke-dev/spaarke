<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- unified-access-control-r2 task 167 f2-v2 (main-session round 52): the route guard proves sign-in, the
         development-only mappings and retired-route absence against the REAL BFF booted in-process
         (BootedBff.cs), in Development and in Production. Same package and version the three BFF test
         projects already use; test-only, so nothing reaches the BFF publish. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- System.Net.Http pin removed (dotnet-10-upgrade-r1 task 030): net10 framework-superseded
         (NU1510, promoted to error by root TreatWarningsAsErrors=true). CVE-2018-8292 (HIGH) fix is
         inbox on net10 (inbox System.Net.Http ≫ 4.3.4). Mirrors the System.Text.RegularExpressions
         removal task 005 did here; this pin was missed then because ArchTests is not in Spaarke.sln. -->
    <!-- System.Text.RegularExpressions pin removed (task 005): net10 framework-superseded (NU1510);
         the CVE-2019-0820 fix is inbox on net10. -->

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\server\api\Sprk.Bff.Api\Sprk.Bff.Api.csproj" />
    <ProjectReference Include="..\..\src\server\shared\Spaarke.Core\Spaarke.Core.csproj" />
    <ProjectReference Include="..\..\src\server\shared\Spaarke.Dataverse\Spaarke.Dataverse.csproj" />
  </ItemGroup>

  <!-- The one shared test-host helper the booted BFF needs (task 167 f2-v2): every WebApplicationFactory<Program>
       stubs its TokenCredential (TestHostCredentialGuardTests). Linked, not copied, so there is ONE definition. -->
  <ItemGroup>
    <Compile Include="..\integration\Shared\TestTokenCredential.cs" Link="SharedTestHelpers\TestTokenCredential.cs" />
  </ItemGroup>

  <!--
    NOTE: Sprk.Provisioning.ControlPlane is intentionally NOT a <ProjectReference>.
    CosmosProvisioningSecretGuardTests (task 025 — customer-provisioning-orchestration-r1
    spec FR-27) loads the L2 assembly at TEST RUNTIME via Assembly.LoadFrom, resolving
    the DLL from src/server/services/Sprk.Provisioning.ControlPlane/bin/**. Two reasons:
      1) Sprk.Bff.Api and Sprk.Provisioning.ControlPlane are BOTH Web SDK projects with a
         compiler-synthesized top-level `Program` class; a plain ProjectReference collides
         (CS0433) with `typeof(Program)` used across ADR001/007/008/... An extern alias
         would fix that, but option (2) is a stronger reason for runtime loading anyway.
      2) L2 is a POCO surface in this project's Wave 2 phase — its NuGet stack evolves
         through parallel Wave 2 tasks (Cosmos SDK via task 037, Service Bus via 038,
         AppInsights via 039). A compile-time ProjectReference would couple this test to
         the composite build health of a fast-moving sibling package graph. Runtime
         reflection over the already-published L2 DLL keeps this ArchTest robust across
         sibling churn — the invariant it enforces is a POCO-shape invariant, not a
         wiring invariant, so the DLL is the right artifact to inspect.
    Consequence: L2 must be built at least once before this test runs.

    THAT CONSEQUENCE WAS NOT SATISFIED, 2026-08-27. This note previously read "CI's full-sln
    `dotnet build` satisfies this automatically". It does not. The Tier 2 `adr-compliance` job
    runs `dotnet restore` then `dotnet test tests/Spaarke.ArchTests/Spaarke.ArchTests.csproj`,
    which builds this project and its ProjectReferences only — never the L2 projects. So the
    guard threw FileNotFoundException on every CI run and evaluated nothing, which is the same
    dead-guard state task 025 repaired it out of.

    The BuildL2ForCosmosGuard target below closes that without a ProjectReference, so BOTH
    reasons above still hold: MSBuild builds the L2 projects as a separate graph and discards
    their outputs (ReferenceOutputAssembly is not involved at all), so there is no CS0433
    `Program` collision and no compile-time coupling to L2's package graph. The DLLs land in
    their own bin/ where Assembly.LoadFrom finds them.
  -->
  <Target Name="BuildL2ForCosmosGuard" AfterTargets="Build">
    <ItemGroup>
      <_L2Project Include="..\..\src\server\services\Sprk.Provisioning.ControlPlane.Core\Sprk.Provisioning.ControlPlane.Core.csproj" />
      <_L2Project Include="..\..\src\server\services\Sprk.Provisioning.ControlPlane.Api\Sprk.Provisioning.ControlPlane.Api.csproj" />
      <_L2Project Include="..\..\src\server\services\Sprk.Provisioning.ControlPlane.Worker\Sprk.Provisioning.ControlPlane.Worker.csproj" />
    </ItemGroup>
    <!--
      Core carries the POCOs the FR-27 shape invariant is about; Api is included because the
      loader scans every Sprk.Provisioning.ControlPlane* assembly and a partially-built set
      would silently shrink the guard's coverage. Sidecar (a folder with no .csproj) is not built:
      it declares no provisioning POCOs. If a secret-shaped POCO is ever added to it, add it here —
      the loader will not tell you it is missing, it will simply scan less.

      WORKER IS BUILT TOO (unified-access-control-r2 task 167 f2-v2, main-session round 52 item 2):
      RouteAuthorizationGuardTests.NoServerCodeWritesTheHostEnvironmentName (RouteAuthorizationGuardTests.Compiled.cs)
      reads the COMPILED code of every production project under src/server — the Worker is one — for a
      write to the host environment's EnvironmentName, and fails closed when one is not built. It references only Core, which is built anyway, so it adds one project's compile.
    -->
    <!--
      RESTORE THEN BUILD. `Targets="Build"` alone fails with NETSDK1004 ("Assets file
      project.assets.json not found") in every job that restores only this project rather
      than the full solution. Observed 2026-08-28 on the Tier 1 `tenant-isolation` job and
      on a clean local worktree. Those jobs are correct to restore narrowly; it is this
      target that reaches outside the restore graph, so it is this target's job to bring its
      own assets. Restore is a no-op when the assets file is already current, so the
      full-solution path pays nothing.
    -->
    <MSBuild Projects="@(_L2Project)"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)"
             ContinueOnError="false" />
  </Target>

  <!--
    unified-access-control-r2 task 132, main-session round 55 item 3: PoaShareClientSingletonGuardTests C8
    (NoCompiledSrcServerAssemblyCarriesAnUnsafeAccessor) reads the compiled custom-attribute table of EVERY project under
    src/server, so each must be built. The ProjectReferences above build the BFF and its shared libraries; the target
    above builds the L2 Core and Api; this one builds the rest of src/server — the L2 Worker and the L2 test project —
    the same way (separate graph, outputs in each project's own bin/, no ProjectReference, so no `Program` collision).
    It also lets CosmosProvisioningSecretGuardTests load the Worker, which its loader already scans when built.
    A NEW src/server project not built by any of these fails C8 loudly, naming the project: add it here.
  -->
  <Target Name="BuildServerProjectsForCompiledScans" AfterTargets="BuildL2ForCosmosGuard">
    <ItemGroup>
      <_ServerProjectForScan Include="..\..\src\server\services\Sprk.Provisioning.ControlPlane.Worker\Sprk.Provisioning.ControlPlane.Worker.csproj" />
      <_ServerProjectForScan Include="..\..\src\server\services\Sprk.Provisioning.ControlPlane.Tests\Sprk.Provisioning.ControlPlane.Tests.csproj" />
    </ItemGroup>
    <MSBuild Projects="@(_ServerProjectForScan)"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)"
             ContinueOnError="false" />
  </Target>

</Project>
