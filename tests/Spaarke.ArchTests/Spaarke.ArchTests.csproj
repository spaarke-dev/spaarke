<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- System.Net.Http pin removed (dotnet-10-upgrade-r1 task 030): net10 framework-superseded
         (NU1510, promoted to error by root TreatWarningsAsErrors=true). CVE-2018-8292 (HIGH) fix is
         inbox on net10 (inbox System.Net.Http ≫ 4.3.4). Mirrors the System.Text.RegularExpressions
         removal task 005 did here; this pin was missed then because ArchTests is not in Spaarke.sln. -->
    <!-- System.Text.RegularExpressions pin removed (task 005): net10 framework-superseded (NU1510);
         the CVE-2019-0820 fix is inbox on net10. -->

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\server\api\Sprk.Bff.Api\Sprk.Bff.Api.csproj" />
    <ProjectReference Include="..\..\src\server\shared\Spaarke.Core\Spaarke.Core.csproj" />
    <ProjectReference Include="..\..\src\server\shared\Spaarke.Dataverse\Spaarke.Dataverse.csproj" />
  </ItemGroup>

  <!--
    NOTE: Sprk.Provisioning.ControlPlane is intentionally NOT a <ProjectReference>.
    CosmosProvisioningSecretGuardTests (task 025 — customer-provisioning-orchestration-r1
    spec FR-27) loads the L2 assembly at TEST RUNTIME via Assembly.LoadFrom, resolving
    the DLL from src/server/services/Sprk.Provisioning.ControlPlane/bin/**. Two reasons:
      1) Sprk.Bff.Api and Sprk.Provisioning.ControlPlane are BOTH Web SDK projects with a
         compiler-synthesized top-level `Program` class; a plain ProjectReference collides
         (CS0433) with `typeof(Program)` used across ADR001/007/008/... An extern alias
         would fix that, but option (2) is a stronger reason for runtime loading anyway.
      2) L2 is a POCO surface in this project's Wave 2 phase — its NuGet stack evolves
         through parallel Wave 2 tasks (Cosmos SDK via task 037, Service Bus via 038,
         AppInsights via 039). A compile-time ProjectReference would couple this test to
         the composite build health of a fast-moving sibling package graph. Runtime
         reflection over the already-published L2 DLL keeps this ArchTest robust across
         sibling churn — the invariant it enforces is a POCO-shape invariant, not a
         wiring invariant, so the DLL is the right artifact to inspect.
    Consequence: L2 must be built at least once before this test runs (CI's full-sln
    `dotnet build` satisfies this automatically; local dev is guided by the assertion
    diagnostic when the DLL is missing).
  -->

</Project>
