<fetch distinct="true">
  <entity name="sprk_event">
    <attribute name="sprk_eventid" />
    <order attribute="sprk_eventid" />
    <filter type="and">
      <condition attribute="sprk_eventtype_ref" operator="eq" value="124f5fc9-98ff-f011-8406-7c1e525abd8b" />
      <condition attribute="statuscode" operator="eq" value="659490001" />
      <condition attribute="sprk_duedate" operator="lt" value="2026-10-02T00:00:00Z" />
    </filter>
  </entity>
</fetch>
