<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Moq" Version="4.20.70" />

    <!-- Security: Override vulnerable transitive dependency -->
    <!-- System.Text.RegularExpressions pin removed (task 005): net10 framework-superseded (NU1510). -->

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\server\api\Sprk.Bff.Api\Sprk.Bff.Api.csproj" />
    <ProjectReference Include="..\..\..\src\server\shared\Spaarke.Dataverse\Spaarke.Dataverse.csproj" />
  </ItemGroup>

  <!--
    InternalsVisibleTo: the Dataverse projection endpoints + filter + DTOs are intentionally
    `internal sealed` (per project conventions). Integration tests must reach the internal
    DataverseAuthorizationFilter / IDataversePrivilegeChecker / IFetchXmlEntityExtractor /
    EntitySource types and Models DTOs. We declare InternalsVisibleTo on the BFF project so
    tests can DI-substitute internal services without making them public.

    Sprk.Bff.Api's csproj does NOT need to be modified — InternalsVisibleTo is declared at
    consumer-side via this metadata file: tests/integration/Sprk.Bff.Api.IntegrationTests/
    InternalsVisibleTo.cs (added alongside the test files).
  -->


  <!-- spaarkeai-mcp-bff-api-r1 task 011 (FR-09): the signal worklist golden contract baselines. They live on the KEEP path
       tests/integration/contract/ but are a part of SignalReadRouteTests (they reuse its World fixture), so they compile here;
       Sprk.Bff.Api.Tests removes SignalWorklistRouteContractBaselineTests.cs from its contract glob. GoldenContract.cs compiles into both. -->
  <ItemGroup>
    <Compile Include="..\contract\Api\Signals\GoldenContract.cs" LinkBase="ContractTests" />
    <Compile Include="..\contract\Api\Signals\SignalWorklistRouteContractBaselineTests.cs" LinkBase="ContractTests" />
  </ItemGroup>

  <!-- spaarkeai-mcp-bff-api-r1 task 015 (FR-05): the Decide-lane paging tests, also a part of SignalReadRouteTests (its World fixture). They live on
       the KEEP path tests/integration/regression/; Sprk.Bff.Api.Tests removes the file from its regression glob. -->
  <ItemGroup>
    <Compile Include="..\regression\Signals\DecideLanePagingTests.cs" LinkBase="RegressionTests" />
  </ItemGroup>

  <!-- Shared test helpers (TestSessionOwner, TestHttpContexts, TestTokenCredential).
       Linked rather than copied so every test project sees ONE definition; a second copy is how
       two projects drift into disagreeing about what a test callers oid is. -->
  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" LinkBase="SharedTestHelpers" />
  </ItemGroup>
</Project>
