<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TESTS ONLY (spaarkeai-mcp-bff-api-r1 task 025, NFR-09). A console host that starts the real BFF (Program) in this process on
    loopback, with a test JwtBearer scheme and seeded fakes, so the published modelcontextprotocol/conformance suite (a Node CLI)
    can call /mcp/legal-operations over HTTP. Nothing under src/ knows this project exists: no test-auth path, switch or bypass there.
    Run by the mcp-conformance CI job (notes/task-025-ci-job.md) and by run-conformance.sh in this folder.

    It references Sprk.Bff.Api.Tests only to reuse CustomWebAppFactory (the config and fakes every other BFF-Program test host uses),
    so a new required BFF setting is fixed in one place. It is deliberately NOT in Spaarke.sln: the job builds it by path.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Spaarke.Mcp.ConformanceHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\server\api\Sprk.Bff.Api\Sprk.Bff.Api.csproj" />
    <ProjectReference Include="..\..\unit\Sprk.Bff.Api.Tests\Sprk.Bff.Api.Tests.csproj" />
  </ItemGroup>

</Project>
