<task id="057" project="customer-provisioning-orchestration-r1">
  <metadata>
    <title>Implement L2 REST endpoints per §4.2 API surface (all 9 endpoints)</title>
    <phase>C Wave C5 — L2 REST + Reconciler</phase>
    <gate>blocked</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Task tags include 'l2-controlplane','bff-api','auth'; modifies .cs files; implements the public control-plane surface consumed by L3 skill; FR-21 acceptance scope; PR-time /conflict-check obligated.</rigor-reason>
    <model-tier>opus</model-tier>
    <model-tier-reason>Public API surface for the L2 control plane spanning 9 endpoints with app-role authorization, OpenAPI export, audit-log wiring, and 202-Accepted enqueue semantics. High-blast-radius (any endpoint bug is a control-plane defect) per Step 3.5.5b Opus/Fable tier criteria.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>true</parallel-safe>
    <deps>036, 042</deps>
    <tags>l2-controlplane, bff-api, auth, azure-deployment</tags>
    <estimated-effort>6-8 hours</estimated-effort>
