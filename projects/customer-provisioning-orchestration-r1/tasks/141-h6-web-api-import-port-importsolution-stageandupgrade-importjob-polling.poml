<task id="141" project="customer-provisioning-orchestration-r1">
  <metadata>
    <title>H6: Web-API import port (ImportSolution/StageAndUpgrade + ImportJob polling) + ZIP artifact packaging</title>
    <phase>C'' Wave G-4 -- Dataverse chain</phase>
    <gate>blocked</gate>
    <status>not-started</status>
