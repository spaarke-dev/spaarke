<task id="053" project="customer-provisioning-orchestration-r1">
  <metadata>
    <title>Implement H10 Dataverse App User + Graph App-Role Parity Handler (T2 + T3 owner)</title>
    <phase>C Wave C4 — Handler Implementations</phase>
    <gate>blocked</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Task tags include 'l2-controlplane','job-handler','auth','dataverse'; modifies .cs files; owns T2 + T3 silent-fail traps; touches App User registration + Graph app-role parity — auth-sensitive.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Handler consumes GraphAppRoles.cs compile-time constant; complete spec (FR-13 + T2 + T3); dual-trap ownership + escalation gate (10-of-14 GUIDs) lift effort to xhigh.</model-tier-reason>
    <effort>xhigh</effort>
    <parallel-group>none</parallel-group>
