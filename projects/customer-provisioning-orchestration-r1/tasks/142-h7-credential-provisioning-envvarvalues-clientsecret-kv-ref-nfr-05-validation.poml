<task id="142" project="customer-provisioning-orchestration-r1">
  <metadata>
    <title>H7: credential provisioning (EnvVarValues:ClientSecret KV ref) + NFR-05 validation</title>
    <phase>C'' Wave G-4 -- Dataverse chain</phase>
    <gate>clear</gate>
    <status>completed</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>Config-only task per DS-4 ('~0 code; provision EnvVarValues:ClientSecret KV ref... Config-only') -- no handler logic change, STANDARD per root CLAUDE.md §8.</rigor-reason>
    <model-tier>sonnet</model-tier>
