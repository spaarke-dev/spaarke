<?xml version="1.0" encoding="UTF-8"?>
<task id="240b" project="customer-provisioning-orchestration-r1">
  <metadata>
    <title>Live test (owner-approved 2026-10-07): a work-account B2B guest gets a Spaarke-tenant token in Outlook/Word (NAA, desktop + web) and Teams, and can read its own group memberships</title>
    <phase>Model 1 dedicated-stamp remediation — plan §7 T240 (G14; owner D11 "spike first")</phase>
    <gate>after 240a can run in parallel; needs a guest account + spaarkeai-word-add-in-r1</gate>
    <status>pending</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>A live test with recorded results; any code is a dev-only test build owned by spaarkeai-word-add-in-r1.</rigor-reason>
    <model-tier>opus</model-tier>
    <model-tier-reason>The outcome decides the T240 client design.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>Needs the owner at the keyboard (sign-in) and another project's add-in.</parallel-reason>
    <tags>auth, m365-clients, spike, model1-dedicated</tags>
    <deps>233</deps>
  </metadata>

  <prompt>Prove (or disprove) that a B2B guest can use the shared add-in and Teams clients against Spaarke's tenant.</prompt>

  <goal>Recorded answers to S1–S3 in `notes/t240-plan.md`, each with the account type, client (Outlook/Word desktop, web, Teams), authority, scope and result.</goal>

  <context>
    <background>
      `notes/t240-plan.md`. The add-in signs in through `@spaarke/auth` OfficeNaaStrategy and may not construct MSAL itself
      (spaarkeai-word-add-in-r1 binding rule). Today it falls back to `/organizations`, i.e. the guest's HOME tenant.
      The only guest in Spaarke's tenant is a personal Microsoft account; the test needs a work account from another
      Entra tenant (owner to provide), invited as a guest and added to a test `sprk-*-users` group.
    </background>
  </context>

  <constraints>
    <constraint source="owner">Live actions (inviting the test guest, group membership, a dev test build) each need the owner's OK; record each in this POML.</constraint>
    <constraint source="coordination">Add-in and Teams client changes are spaarkeai-word-add-in-r1's; request them through the owner's relay or that project directly.</constraint>
  </constraints>

  <steps mode="directional">
    <step order="1">Owner provides a work-account guest; invite it to Spaarke's tenant; add it to a test environment group.</step>
    <step order="2">S1: with a dev test build whose authority is Spaarke's tenant, acquire `api://{devBffAppId}/user_impersonation` through NAA in Outlook desktop + web and Word desktop + web; record the token's `tid`, `oid`, `idtyp`.</step>
    <step order="3">S2: same session, Graph `/me/memberOf` (or `checkMemberGroups`) as the guest; record whether the `sprk-*-users` group is visible.</step>
    <step order="4">S3: Teams — the tab inside Spaarke's tenant (guest switched in) and in the home tenant; record what signs in.</step>
    <step order="5">Write the results and the design consequence into `notes/t240-plan.md`; update 240c.</step>
  </steps>

  <acceptance-criteria>
    <criterion testable="true">S1–S3 each have a recorded result for each client listed, with the token claims that prove it.</criterion>
    <criterion testable="true">`notes/t240-plan.md` states the confirmed or changed discovery design.</criterion>
  </acceptance-criteria>

  <notes/>
</task>
