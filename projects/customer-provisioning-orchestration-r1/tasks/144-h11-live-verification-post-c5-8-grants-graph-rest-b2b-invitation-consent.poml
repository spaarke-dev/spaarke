<task id="144" project="customer-provisioning-orchestration-r1">
  <metadata>
    <title>H11: live verification post C5.8 grants (Graph REST + B2B invitation + consent verifier, code already real)</title>
    <phase>C'' Wave G-4 -- Dataverse chain</phase>
    <gate>open</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>H11 is the terminal handler in the Dataverse chain and its consent-gate correctness matters for the acceptance-target run; live verification before Wave G-7 trusts it.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Verification-only task against already-real code -- Sonnet @ high, no new implementation.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>true</parallel-safe>
