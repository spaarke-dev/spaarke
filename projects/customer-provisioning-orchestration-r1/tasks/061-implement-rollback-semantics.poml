    <output type="code">src/server/services/Sprk.Provisioning.ControlPlane/Rollback/FailureClass.cs</output>
    <output type="code">src/server/services/Sprk.Provisioning.ControlPlane/Rollback/IFailureClassifier.cs</output>
    <output type="code">src/server/services/Sprk.Provisioning.ControlPlane/Rollback/FailureClassifier.cs</output>
    <output type="code">src/server/services/Sprk.Provisioning.ControlPlane/Rollback/QuarantineClearService.cs</output>
