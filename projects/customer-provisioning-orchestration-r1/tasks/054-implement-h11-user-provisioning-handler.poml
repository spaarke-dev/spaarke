<task id="054" project="customer-provisioning-orchestration-r1">
  <metadata>
    <title>Implement H11 User Provisioning Handler (identity preset — B2BGuest vs NativeAccount per D6)</title>
    <phase>C Wave C4 — Handler Implementations</phase>
    <gate>blocked</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Task tags include 'l2-controlplane','job-handler','auth'; modifies .cs files; user provisioning + license assignment; auth-sensitive.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Handler reuses r1 registration flow (DemoProvisioningService 9-step + GraphUserService); complete spec (FR-14); identity-preset branching is deterministic; not cross-cutting.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>waveC4-parallel</parallel-group>
    <parallel-safe>true</parallel-safe>
