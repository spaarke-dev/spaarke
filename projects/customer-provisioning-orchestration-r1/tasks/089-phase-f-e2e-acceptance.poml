  <acceptance-criteria>
    <criterion testable="true">Fresh trial-{yyyymmdd} customer stamp exists in dev Azure; sprk_dataverseenvironment.sprk_provisioning_setupstatus = Ready.</criterion>
    <criterion testable="true">All 6 §4B traps (T1-T6) verified cleared; per-trap query documented + result cited in report.</criterion>
    <criterion testable="true">All 5 §4D invariants (I1-I5) sample-verified; per-invariant sample-query documented + result cited.</criterion>
    <criterion testable="true">scripts/naming-conformance-check.ps1 -Scope r1-owned exits 0.</criterion>
    <criterion testable="true">Cost envelope report shows Model 1 marginal ≤ $430/mo AND shared platform floor ≤ $400/mo; deviations &gt;20% flagged.</criterion>
    <criterion testable="true">Model 1 provisioning invoked via /provision-environment skill (not manual REST/script bypass).</criterion>
    <criterion testable="true">Model 2 dry-run documented — either performed with §4.1a differences verified, OR explicit skip rationale.</criterion>
    <criterion testable="true">Report notes/phase-f-e2e-acceptance-2026-XX-XX.md exists with per-check verdict + evidence.</criterion>
    <criterion testable="true">Negative: any failure triggers escalation, NOT silent proceed to task 090.</criterion>
  </acceptance-criteria>

