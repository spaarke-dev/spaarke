  <constraints>
    <constraint source="spec.md FR-18">SCOPE: H13 acceptance gate exits 0 AND registry Setup Status = Ready; both required.</constraint>
    <constraint source="spec.md SC #5">SCOPE: E2E acceptance target = trial-{yyyymmdd} Model 1 stamp reaches Ready via new pipeline (not manual invocation).</constraint>
    <constraint source="spec.md SC #6">SCOPE: All 6 §4B T1-T6 traps verified cleared by owning handler post-conditions.</constraint>
    <constraint source="spec.md §4D">SCOPE: All 5 I1-I5 invariants sample-verified — I1 (no hardcoded tenant), I2 (tenantId filter on AI Search), I3 (Cosmos partition key), I4 (SPE container-id resolver), I5 (Graph per-tenant token).</constraint>
    <constraint source="spec.md FR-35">SCOPE: naming-conformance-check.ps1 exits 0 on r1-owned surfaces post-provisioning.</constraint>
    <constraint source="spec.md §15 #14">SCOPE: Cost envelope — Model 1 marginal ≤ $430/mo; shared platform floor ≤ $400/mo; deviations &gt;20% flagged.</constraint>
    <constraint source="CLAUDE.md-§10">SCOPE: If E2E surfaces a BFF issue, remediation follows §10 BFF Hygiene; /conflict-check before any fix PR.</constraint>
    <constraint source="project">SCOPE: E2E provisioning uses REAL L3 skill invocation via /provision-environment against dev L2 — NOT a scripted bypass. Skill invocation is the acceptance path.</constraint>
    <constraint source="project">SCOPE: Model 2 dry-run is discretionary per plan.md §4 Phase F — Model 1 is MANDATORY; document Model 2 result or explicit skip rationale.</constraint>
    <constraint source="project">SCOPE: If ANY trap OR invariant OR cost check fails, STOP + escalate per CLAUDE.md §6.5 rather than lowering the threshold.</constraint>
  </constraints>

