    <criterion testable="true">Negative: audit does NOT skip any BFF service directory under src/server/api/Sprk.Bff.Api/Services/** — coverage verified by cross-referencing directory count vs report table.</criterion>
    <criterion testable="true">dotnet build exits 0; dotnet test exits 0; zero analyzer warnings.</criterion>
  </acceptance-criteria>

