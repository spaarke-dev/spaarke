    <patterns>
      <pattern name="Dedicated branch is the reference" location="H2bAiSearchIndexHandler.HandleModel2BranchAsync; H12cRuntimeReferencesHandler Model2 arm">
        Model 1 converges onto the existing Model2 logic (endpoint from H2a output). Do not write a third branch.
      </pattern>
    </patterns>
