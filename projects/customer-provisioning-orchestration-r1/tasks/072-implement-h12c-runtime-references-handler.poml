<task id="072" project="customer-provisioning-orchestration-r1">
  <metadata>
    <title>Implement H12c runtime references handler — sprk_aimodeldeployment rows point at customer or shared OpenAI</title>
    <phase>C' Config-Seed Manifest + H12/H14 Implementations</phase>
    <gate>blocked</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Task tags include 'l2-controlplane','job-handler','ai','dataverse'; handler in the DAG whose failure blocks Setup Status = Ready. FR-17 acceptance scope; tier-branch (Model 1 vs Model 2) is critical for cost + isolation semantics.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Single-component IJobHandler with tier-branching logic per §4.1a Model 1/2 differences table; well-specified. Step 3.5.5b sonnet @ high.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>true</parallel-safe>
