    </files>
    <patterns>
      <pattern name="Reference handler shape" location="src/server/api/Sprk.Bff.Api/Services/Jobs/">Any handler is a shape exemplar.</pattern>
      <pattern name="Dataverse alt-key upsert" location="src/server/api/Sprk.Bff.Api/Services/Registration/RegistrationDataverseService.cs">Reuse for sprk_aimodeldeployment upsert.</pattern>
    </patterns>
  </knowledge>

  <steps mode="directional">
    <step order="0" name="Rigor + load">Emit RIGOR LEVEL (FULL). Load spec.md FR-17 + §4.1a + task 044 H2a output shape.</step>
    <step order="1" name="Author">Author H12cRuntimeReferencesHandler.cs — inject IIdempotencyService, ICosmosRunStore, IDataverseService, IArmOpenAiEndpointReader.</step>
    <step order="2" name="Tier branch">HandleAsync reads customer.sprk_tenancymodel; branches Model 1 vs Model 2 per §4.1a.</step>
    <step order="3" name="Model 2 path">Read H2a-provisioned OpenAI endpoint from customer resource group; upsert sprk_aimodeldeployment rows with dedicated endpoint URIs (pinned model versions per ADR-020).</step>
    <step order="4" name="Model 1 path">Read shared platform OpenAI endpoint from platform config; upsert sprk_aimodeldeployment rows with shared endpoint + metering-attribution tenantId field (integrates with task 077).</step>
    <step order="5" name="Register">Register in L2 Program.cs DI.</step>
    <step order="6" name="Tests">Unit tests: Model 2 happy; Model 1 happy; idempotency (second invocation same-key no-op); tier-branch coverage (both paths tested).</step>
    <step order="7" name="Verify">dotnet build + dotnet test = green; dotnet format; zero analyzer warnings.</step>
    <step order="8" name="Index update">Update TASK-INDEX.md: task 072 → ✅.</step>
    <step order="9" name="Deviations">Document any deviation in projects/customer-provisioning-orchestration-r1/notes/.</step>
  </steps>

  <tools>
    <tool name="dotnet">Build and test the L2 control-plane project</tool>
    <tool name="terminal">Run shell commands</tool>
  </tools>

  <outputs>
    <output type="code">src/server/services/Sprk.Provisioning.ControlPlane/Handlers/H12cRuntimeReferencesHandler.cs</output>
    <output type="code">src/server/services/Sprk.Provisioning.ControlPlane/Program.cs (DI registration)</output>
    <output type="test">src/server/services/Sprk.Provisioning.ControlPlane/Handlers/H12cRuntimeReferencesHandler.Tests.cs</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">H12cRuntimeReferencesHandler implements IJobHandler and registers in L2 DI.</criterion>
    <criterion testable="true">Given customer.sprk_tenancymodel = Model2Dedicated, when HandleAsync runs, then sprk_aimodeldeployment rows are upserted with the customer's dedicated OpenAI endpoint URIs.</criterion>
    <criterion testable="true">Given customer.sprk_tenancymodel = Model1Shared, when HandleAsync runs, then sprk_aimodeldeployment rows are upserted with the shared platform OpenAI endpoint + metering-attribution tenantId.</criterion>
    <criterion testable="true">Endpoint URIs reference pinned model deployment versions per ADR-020 (gpt-4o 2024-08-06, gpt-4o-mini 2024-07-18, text-embedding-3-large v1).</criterion>
    <criterion testable="true">Idempotency key = h12c-{customerId}-{tenancyModel}-{endpointHash}; second invocation same-key is a no-op.</criterion>
    <criterion testable="true">Negative: HandleAsync invoked with unknown tenancyModel value returns Failed with clear diagnostic; does NOT upsert.</criterion>
    <criterion testable="true">dotnet build exits 0; dotnet test exits 0; zero analyzer warnings.</criterion>
  </acceptance-criteria>

  <notes>Reference: spec.md FR-17 + §4.1a + ADR-020 + design.md §4.1 H12c row. Interlocks with task 077 (per-tenant metering) for Model 1 attribution.</notes>

