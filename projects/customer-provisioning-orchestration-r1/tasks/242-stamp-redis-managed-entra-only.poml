  <outputs>
    <output type="file-modified">redis.bicep, redis-{env}.bicepparam, customer.bicep (+ json), manifest + generated, control-plane handlers/models/options/DispatchModule (+ tests), BFF CacheModule/RedisOptions/csproj/template (+ tests), Directory.Packages.props, prereqs.yaml, Rotate-Secrets.ps1, Decommission-Customer.ps1, docs, .claude</output>
