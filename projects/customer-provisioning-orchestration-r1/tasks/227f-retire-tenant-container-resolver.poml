  <constraints>
    <constraint source="tests">Deleting tests under a KEEP path needs a same-PR replacement covering the same scenario — the scenario (no fallback container; tenant-scoped container) is now covered by SpeAppOnlyContainerIsolationTests; cite it.</constraint>
    <constraint source="scope">Do not change SpeContainerOwnershipGuard's rules.</constraint>
  </constraints>

  <steps mode="directional">
    <step order="1">git grep the full reference list; delete the resolver, endpoint, registration, unregistered L2 probe and tests.</step>
    <step order="2">Remove StagingContainerId (option + reads); update the ArchTest lists and the FR-31 / MUST / §4D wording.</step>
    <step order="3">BFF + ControlPlane builds, BFF tests, ControlPlane.Tests, ArchTests; Step 9.5; close.</step>
  </steps>

  <acceptance-criteria>
    <criterion testable="true">`git grep -n "ITenantContainerResolver\|tenant-container-resolver\|StagingContainerId\|SpeContainerResolverInvariantProbe" -- src tests` returns nothing (docs/history excepted).</criterion>
    <criterion testable="true">FR-31, the project CLAUDE.md MUST row and design §4D I4 name SpeContainerOwnershipGuard as the single definition of the stamp's containers.</criterion>
    <criterion testable="true">BFF tests, ControlPlane.Tests and ArchTests pass; ADR010 ceiling lowered by exactly the removed interface.</criterion>
