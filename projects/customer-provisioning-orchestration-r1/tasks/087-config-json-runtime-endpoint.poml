    <output type="test">src/server/api/Sprk.Bff.Api/Api/ConfigEndpoints.Tests.cs</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">GET /api/config returns 200 Anonymous with a structured JSON body containing bffUrl + msalClientId + tenantId + featureFlags.</criterion>
    <criterion testable="true">Response body contains ZERO secrets (grep of response for KV references, connection strings, client secrets returns zero matches).</criterion>
    <criterion testable="true">Response has ETag or Cache-Control (short cache).</criterion>
    <criterion testable="true">External-spa + code-pages fetch /api/config at bootstrap before MSAL init (verified via manual dev bootstrap trace).</criterion>
    <criterion testable="true">Grep of consumer bundles for hardcoded env-config values returns zero matches post-migration.</criterion>
    <criterion testable="true">PublicConfigOptions classified Tier-1 + validated-on-start; BFF /health fails on missing config (NFR-05).</criterion>
    <criterion testable="true">BFF publish-size delta reported per NFR-01.</criterion>
    <criterion testable="true">Negative: coord conflict with external-spa worktree triggers escalation, not unilateral merge.</criterion>
    <criterion testable="true">dotnet build exits 0; dotnet test exits 0; zero analyzer warnings; zero new HIGH CVEs.</criterion>
  </acceptance-criteria>

  <notes>Reference: spec.md FR-36 + §7.9 close-pattern + hot-path overlap with spaarke-SPA-external-access-platform-r1/r2 per this project's CLAUDE.md coordination table.</notes>

