<task id="022" project="spaarkeai-compose-fidelity-r4.5">
  <metadata>
    <title>WS-2: full OOXML run/block construct audit + missing projection tests</title>
    <phase>2 WS-2 Harden read</phase>
    <gate>blocked until 021</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies `.cs` (any construct found silently dropped is fixed here) + adds tests; `bff-api`/`compose`/`testing` tags. The `testing` tag alone triggers the TEST-MODIFYING override; Step 9.5 code-review + adr-check run unconditionally.</rigor-reason>
    <model-tier>sonnet</model-tier>
