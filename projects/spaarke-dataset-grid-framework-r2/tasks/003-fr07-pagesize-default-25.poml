  <metadata>
    <title>FR-07: Change framework `pageSize` default 100 → 25 + doc alignment</title>
    <phase>1: Framework Schema + Consumer Unwind</phase>
    <status>not-started</status>
    <estimated-hours>1</estimated-hours>
    <dependencies>none</dependencies>
    <blocks>006</blocks>
