  <acceptance-criteria>
    <criterion testable="true">LegalWorkspace builds without changes to functionality.</criterion>
    <criterion testable="true">WorkspaceLayoutWizard builds without changes to functionality.</criterion>
    <criterion testable="true">Both consumers can import from `@spaarke/legal-workspace` if they choose to.</criterion>
