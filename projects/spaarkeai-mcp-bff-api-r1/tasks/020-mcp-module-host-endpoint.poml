      <file role="new">tests/integration/contract/Api/Mcp/McpTestHost.cs (in-process host + test token helper, tests only)</file>
      <file role="canonical-reference">src/server/api/Sprk.Bff.Api/Infrastructure/DI/NotificationsModule.cs:20-55 (options + null object)</file>
      <file role="canonical-reference">src/server/api/Sprk.Bff.Api/Infrastructure/DI/SignalsModule.cs (module shape)</file>
