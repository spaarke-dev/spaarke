    <patterns>
      <pattern name="Single-file Vite build" location="src/solutions/CreateMatterWizard/vite.config.ts">vite-plugin-singlefile with shared-lib source aliases; mirror it.</pattern>
      <pattern name="MCP App hook" location="knowledge/mcp-apps/trey-research/src/mcpserver/widgets/src/hooks/useMcpApp.tsx">Host connection and callServerTool usage; check ext-apps 2.0.4 API drift from this 1.x sample.</pattern>
    </patterns>
