<task id="022" project="email-communication-intelligence-r1">
  <metadata>
    <title>`TRIAGE-EMAIL` Action authoring via `jps-action-create` — `{category, summary, obligations[], priority, reviewOutcome}` reusing `AiClassificationRung` signal, no 2nd full LLM pass</title>
    <phase>P2 — Lean intelligence spine</phase>
    <gate>none (STANDARD — Step 9.5 skipped; catalog-data authoring with constraints)</gate>
