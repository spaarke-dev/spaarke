    <tool name="jps-action-create">Author the `TRIAGE-EMAIL` `sprk_analysisaction` JPS JSON</tool>
    <tool name="jps-validate">Schema + render validation of the authored Action</tool>
    <tool name="write">The authored Action JSON + the authoring note</tool>
  </tools>

  <outputs>
