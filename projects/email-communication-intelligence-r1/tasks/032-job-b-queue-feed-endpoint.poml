    </files>
    <patterns>
      <pattern name="Extend the suggest-associations family" location="src/server/api/Sprk.Bff.Api/Api/CommunicationEndpoints.cs">
        Add the queue-feed to the existing `/api/communications` group; ADR-008 filter; ADR-019 ProblemDetails; unconditional mapping; read-only.
      </pattern>
      <pattern name="Reuse existing ranking signals" location="sprk_communication (Dataverse)">
        Rank by the triage priority + RI-confidence already computed (024/025); do not re-score or introduce a second priority scheme.
      </pattern>
