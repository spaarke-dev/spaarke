      <file>projects/email-communication-intelligence-r1/CLAUDE.md</file>
      <file>projects/email-communication-intelligence-r1/notes/email-intelligence-r1-coordination.md</file>
      <file>src/server/api/Sprk.Bff.Api/Api/CommunicationEndpoints.cs</file>
