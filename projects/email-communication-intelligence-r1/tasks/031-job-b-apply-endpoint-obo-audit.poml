    <patterns>
      <pattern name="OBO record write" location="src/server/api/Sprk.Bff.Api/Services/Ai/PublicContracts/IActionSeam.cs">
        Resolve the confirming caller from `HttpContext.User`; call `UpdateRecordAsync` under their OBO token so Dataverse RLS applies under their identity; never app-only for the apply.
      </pattern>
      <pattern name="Apply-time allow-list re-validation" location="sprk_emailupdatefield (Dataverse)">
        Re-read the enabled allow-list row for the proposal's `(entity, field)` at apply time; refuse if absent/disabled — do not trust client-side gating.
      </pattern>
      <pattern name="Audit-on-apply" location="sprk_emailreviewlog (Dataverse)">
        Write the human-approved decision row (actor, action, prior AI suggestion + confidence, old→new, citation, timestamp) as part of the same apply operation.
      </pattern>
    </patterns>
