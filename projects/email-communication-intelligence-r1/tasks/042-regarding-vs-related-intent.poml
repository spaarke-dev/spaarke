    <patterns>
      <pattern name="Intent demotes auto-file" location="src/server/api/Sprk.Bff.Api/Services/Communication/Engine/AutoFileGate.cs">
        On "new filing based on X" intent, suppress the auto-file the rung would otherwise do; surface create-new / file-onto / link-related as options instead of silently filing onto X.
      </pattern>
      <pattern name="Related-to without a second regarding" location=".claude/adr/ADR-024-polymorphic-resolver-pattern.md">
        Represent "related-to" as a documented distinct relationship; DO NOT add a second regarding map/mechanism (ADR-024 path-A exception); the one resolver mechanism still owns "regarding".
      </pattern>
