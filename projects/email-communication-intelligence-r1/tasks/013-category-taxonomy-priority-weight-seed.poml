<task id="013" project="email-communication-intelligence-r1">
  <metadata>
    <title>Category taxonomy + priority-weight config seed (`sprk_triagecategory` config table + starter seed)</title>
    <phase>P1 — Schema &amp; catalog foundation</phase>
    <gate>none (STANDARD — Step 9.5 skipped; new-surface config table with constraints)</gate>
    <status>not-started</status>
