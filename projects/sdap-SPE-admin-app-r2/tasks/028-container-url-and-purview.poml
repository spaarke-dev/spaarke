<task id="028" project="sdap-SPE-admin-app-r2">
  <metadata>
    <title>Expose container URL and add Purview guidance + deep-link</title>
    <phase>3 Workstream C — Correct the API surface</phase>
    <gate>020 complete</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies .cs (Graph read + DTO) and .tsx; tags include bff-api and frontend.</rigor-reason>
    <model-tier>sonnet</model-tier>
