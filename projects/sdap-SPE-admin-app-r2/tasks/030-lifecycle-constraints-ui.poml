<?xml version="1.0" encoding="UTF-8"?>
<task id="030" project="sdap-SPE-admin-app-r2">
  <metadata>
    <title>Model container-type lifecycle constraints in the UI</title>
    <phase>3 Workstream C — Correct the API surface</phase>
    <gate>011 complete</gate>
    <status>completed</status>
    <!-- 2026-08-23. Constraints 1 (already satisfied) and 2 (delivered in full, broadened to five
         further constraints the POML omitted) are done. Constraint 3 (quota) fired this task's own
         escalation trigger on its named case and is knowingly partial. Constraint 4 (conditional
         delete) is undeliverable client-only — no delete affordance exists to make conditional.
         Constraint 5 is stated but cannot show the owning-app value, which the BFF never sends.
         See notes/task-030-findings.md. -->
    <constraint-status>1 ✅ · 2 ✅ · 3 🔔 partial (escalated) · 4 ❌ not deliverable client-only · 5 ⚠️ stated only</constraint-status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies .tsx across the container-types screen; tags include frontend and fluent-ui.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Well-specified UI constraint modelling against a closed list of documented rules.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>W4</parallel-group>
    <parallel-safe>true</parallel-safe>
    <deps>011</deps>
    <tags>frontend, fluent-ui, react, e2e-test</tags>
    <estimated-effort>4-6 hours</estimated-effort>
  </metadata>

  <prompt>Container types carry irreversible, quota-bound lifecycle constraints that the UI does not model. Each unmodelled constraint is a trap: the admin discovers it by failing. Model all of them so nothing is discoverable only by failure.</prompt>

  <role>SPAARKE platform developer. Expert in Fluent UI v9 forms, disabled/conditional affordances, and irreversible-action confirmation patterns. Follow ADRs strictly.</role>

  <goal>Every lifecycle constraint is enforced or communicated before submit — none is discoverable only by an API failure.</goal>

  <context>
    <background>Spec FR-C13 / §4.2b. The constraints: one owning Entra app maps to exactly one container type (1:1); container-type ID and owning app ID are immutable; trial cannot convert to production and standard cannot convert to pass-through; max 25 per tenant with at most one trial; only trial types are deletable. Billing choice is permanent at creation, so the UI must say so BEFORE submit, not after.</background>
    <relevant-files>
      <file role="modify">src/solutions/SpeAdminApp/src/components/container-types</file>
      <file role="canonical-reference">src/server/api/Sprk.Bff.Api/Models/SpeAdmin/ContainerTypeDtos.cs</file>
      <file role="canonical-reference">projects/sdap-SPE-admin-app-r2/notes/obo-spike-findings.md</file>
    </relevant-files>
    <dependencies>
      <dependency task="011" status="pending">Working container-type operations — the constraints govern real create/delete paths.</dependency>
    </dependencies>
  </context>

  <constraints>
    <constraint source="project">Scope: immutability. Container-type ID and owning app ID MUST have no edit affordance at all — not a disabled input that looks editable on hover.</constraint>
    <constraint source="project">Scope: permanence. The no-conversion rules (trial→production, standard→pass-through) and the permanent billing choice MUST be stated BEFORE submit, in the creation flow — not surfaced as an error afterwards.</constraint>
    <constraint source="project">Scope: quota. Show remaining quota against the 25-per-tenant and one-trial limits. At the limit, block with a real message naming the limit — do not offer an action that will fail.</constraint>
    <constraint source="project">Scope: conditional delete. Only trial container types are deletable. The delete affordance MUST be conditional, not universally rendered and then rejected.</constraint>
    <constraint source="project">Scope: creation. Because owning app to container type is 1:1, creation implies an app-registration decision — the flow MUST make that explicit rather than presenting a generic CRUD grid.</constraint>
    <constraint source="ADR-021">Scope: this screen. Fluent v9 semantic tokens; dark-mode correct; no hex literals.</constraint>
    <constraint source="ADR-050">Scope: any confirmation dialog. Use the canonical SprkModal shell and its presets (ConfirmModal) — no bespoke chrome or hand-rolled overlays.</constraint>
  </constraints>

  <knowledge>
    <topic>Container-type lifecycle rules + Fluent v9 constraint UI</topic>
    <files>
      <file>.claude/adr/ADR-021-fluent-design-system.md</file>
      <file>.claude/adr/ADR-050-canonical-modal-shell.md</file>
      <file>.claude/constraints/pcf.md</file>
      <file>.claude/constraints/theme-consistency.md</file>
      <file>docs/standards/MODAL-DECISION-CRITERIA.md</file>
      <file>knowledge/sharepoint-embedded/docs/learn-containertypes.md</file>
      <file>projects/sdap-SPE-admin-app-r2/spec.md</file>
    </files>
    <patterns>
      <pattern name="modal-shell" location=".claude/patterns/ui/modal-shell.md">SprkModal + ConfirmModal usage.</pattern>
      <pattern name="theme-management" location=".claude/patterns/pcf/theme-management.md">Semantic token usage.</pattern>
    </patterns>
  </knowledge>

  <steps mode="directional">
    <step order="0" name="Context + rigor declaration">Declare rigor FULL. Load spec §4.2b and the constraint table.</step>
    <step order="1">Enumerate the constraints and map each to a concrete UI treatment (absent affordance / pre-submit statement / quota display / conditional action).</step>
    <step order="2">Remove edit affordances on immutable fields entirely.</step>
    <step order="3">Add pre-submit statements for the permanent choices in the creation flow.</step>
    <step order="4">Add quota display (used / 25, trial used / 1) with blocking behaviour and a real message at the limit.</step>
    <step order="5">Make delete conditional on trial classification; use ConfirmModal for the confirmation.</step>
    <step order="6">Make the 1:1 owning-app relationship explicit in the creation flow.</step>
    <step order="7">Build the code page; verify each constraint against Spaarke Dev without performing a destructive or irreversible action.</step>
    <step order="8">Update TASK-INDEX.md: task 030 → ✅. Document deviations in notes/.</step>
  </steps>

  <escalation>
    <trigger>If any constraint value cannot be determined from the API (e.g. tenant-wide container-type count is not readable under the app's permissions, making the 25-limit quota display impossible), STOP and escalate — displaying a guessed quota is worse than displaying none, and omitting it silently is the defect class this project removes.</trigger>
  </escalation>

  <ui-tests>
    <test name="Immutable fields have no edit affordance">
      <steps><step>Open a container type and inspect its ID and owning app ID</step></steps>
      <expected>Neither offers an edit affordance — not even a disabled-looking input.</expected>
    </test>
    <test name="Permanent choices stated before submit">
      <steps><step>Begin creating a container type and inspect the billing/classification step</step></steps>
      <expected>The permanence of the billing choice and the no-conversion rules are stated BEFORE submit.</expected>
    </test>
    <test name="Quota displayed and enforced">
      <steps><step>Inspect the quota display; if at the limit, attempt to create</step></steps>
      <expected>Remaining quota is shown against 25-per-tenant and one-trial. At the limit, creation is blocked with a message naming the limit.</expected>
    </test>
    <test name="Delete is conditional">
      <steps><step>Inspect the delete affordance on a trial type and on a standard type</step></steps>
      <expected>Delete is offered for trial only. It is not rendered-then-rejected for standard types.</expected>
    </test>
    <test name="Dark Mode Compliance">
      <steps><step>Toggle dark mode and inspect the screen and any confirmation modal</step></steps>
      <expected>Fluent v9 semantic tokens per ADR-021; modal uses the canonical SprkModal shell per ADR-050; no hex literals.</expected>
    </test>
  </ui-tests>

  <tools>
    <tool name="npm">Build the SpeAdminApp code page</tool>
  </tools>

  <outputs>
    <output type="code">src/solutions/SpeAdminApp/src/components/container-types</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">Container-type ID and owning app ID present no edit affordance.</criterion>
    <criterion testable="true">The permanent billing choice and both no-conversion rules are stated before submit in the creation flow.</criterion>
    <criterion testable="true">Remaining quota is displayed against 25-per-tenant and one-trial; at the limit, creation is blocked with a message naming the limit.</criterion>
    <criterion testable="true">Delete is offered only for trial container types.</criterion>
    <criterion testable="true">The 1:1 owning-app relationship is explicit in the creation flow.</criterion>
    <criterion testable="true">Negative: no constraint is discoverable only by an API failure — each is enforced or communicated first.</criterion>
    <criterion testable="true">Negative: no destructive or irreversible action was performed during verification.</criterion>
    <criterion testable="true">Confirmations use the canonical SprkModal/ConfirmModal (ADR-050); screen is dark-mode correct (ADR-021).</criterion>
    <criterion testable="true">Code page builds cleanly.</criterion>
  </acceptance-criteria>

  <notes>Spec FR-C13. Parallel-safe: client-only — does NOT modify SpeAdminGraphService.cs, so it pairs with a GraphService task in Wave 4.</notes>

  <execution><skill>.claude/skills/task-execute/SKILL.md</skill></execution>
</task>
