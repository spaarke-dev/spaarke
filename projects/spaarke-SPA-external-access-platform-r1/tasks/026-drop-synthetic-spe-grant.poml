<task id="026" project="spaarke-SPA-external-access-platform-r1">
  <metadata>
    <title>Remove vestigial synthetic SPE container grant from GrantExternalAccessEndpoint</title>
    <phase>2 Identity + provisioning + document content</phase>
    <gate>startable</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies the grant path on the external access surface; broker-only correctness matters</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Targeted cleanup with clear scope</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-safe-reason>modifies GrantExternalAccessEndpoint</parallel-safe-reason>
    <deps>none</deps>
    <tags>bff-api</tags>
