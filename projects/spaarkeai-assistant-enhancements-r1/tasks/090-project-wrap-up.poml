      <file>.claude/skills/repo-cleanup/SKILL.md</file>
      <file>.claude/skills/devops-project-sync/SKILL.md</file>
    </files>
  </knowledge>

  <steps mode="prescriptive">
    <step order="1">Run /code-review + /adr-check on all project code; fix criticals or file issues.</step>
    <step order="2">Run /test-diet (ADR-038 §7); save projects/spaarkeai-assistant-enhancements-r1/notes/test-diet-report.md; apply reviewer-approved git rm/mv.</step>
    <step order="3">File deferral 1: sprk_userpreferences plural client-reference bug (~6 refs, no schema change) via project-defer-issue-tracking.</step>
    <step order="4">File deferral 2: R1.5 proactive-push spec-pass follow-on (link design.md §14.1a/§14.1b/§12.5/§15.4).</step>
    <step order="5">Update README → Complete (check graduation criteria) + plan → Complete.</step>
    <step order="6">Append lessons-learned.md (corrections + confirmed non-obvious approaches).</step>
    <step order="7">Run /repo-cleanup projects/spaarkeai-assistant-enhancements-r1; approve removals.</step>
    <step order="8">Run /devops-project-sync (Status → Completed candidate; Tasks Completed). Update TASK-INDEX.md 090 → ✅.</step>
  </steps>

  <tools>
    <tool name="git">Cleanup + status updates</tool>
    <tool name="gh">File deferral issues + sync portfolio</tool>
  </tools>

  <outputs>
    <output type="docs">README.md + plan.md set to Complete</output>
    <output type="docs">projects/spaarkeai-assistant-enhancements-r1/notes/test-diet-report.md</output>
    <output type="docs">projects/spaarkeai-assistant-enhancements-r1/notes/lessons-learned.md</output>
    <output type="report">Two filed deferral issues + portfolio sync</output>
