      <file>.claude/constraints/bff-extensions.md</file>
      <file>src/server/api/Sprk.Bff.Api/CLAUDE.md</file>
    </files>
  </knowledge>

  <steps mode="directional">
    <step order="1">Read PendingPlanManager.RequiresConfirmation + the Gate folder; find where risk is currently sourced.</step>
    <step order="2">Thread the resolved Binding's sprk_risk into RequiresConfirmation.</step>
    <step order="3">Verify Always Confirm → suggestion-that-launches; None → no gate.</step>
    <step order="4">Add tests/integration/seam/** vertical-slice tests covering each risk tier + unit tests.</step>
    <step order="5">Build + publish-size. Update TASK-INDEX.md 021 → ✅.</step>
  </steps>

  <escalation>
    <trigger>If sprk_risk is not present/resolvable on the Binding at dispatch time, STOP and escalate (the catalog authoring in 002/050 must supply it) rather than defaulting silently.</trigger>
  </escalation>

  <tools>
    <tool name="dotnet">Build + test BFF (unit + seam)</tool>
  </tools>

  <outputs>
    <output type="code">src/server/api/Sprk.Bff.Api/Services/Ai/Chat/ (risk wiring)</output>
    <output type="test">tests/integration/seam/ + unit tests</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">sprk_risk = Always Confirm renders a suggestion-that-launches gate.</criterion>
    <criterion testable="true">sprk_risk = None runs without a gate.</criterion>
    <criterion testable="true">tests/integration/seam/** vertical-slice tests cover the risk tiers (ADR-043 DoD); publish-size ≤60 MB.</criterion>
