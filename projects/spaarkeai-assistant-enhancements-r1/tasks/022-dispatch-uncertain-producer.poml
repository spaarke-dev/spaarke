  <acceptance-criteria>
    <criterion testable="true">Low-confidence dispatch triggers the Confirm When Uncertain gate; high-confidence does not.</criterion>
    <criterion testable="true">The confidence derives from the single agent turn; no second scorer/classifier exists (asserted).</criterion>
