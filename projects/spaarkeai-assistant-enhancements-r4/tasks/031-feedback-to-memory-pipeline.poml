<task id="031" project="spaarkeai-assistant-enhancements-r4">
  <metadata>
    <title>Feedback→memory pipeline — thumbs-down/comment / "do this every time" → governed preference item (FR-08)</title>
    <phase>3 — E3 feedback→memory loop</phase>
    <gate>startable</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>NEW wiring connecting the one-way feedback sink to the governed memory write path — governance-sensitive persistence.</rigor-reason>
    <model-tier>opus</model-tier>
    <model-tier-reason>Governance-sensitive — must write with correct MemoryOrigin/ConfirmedByUser semantics and must not auto-mutate anything beyond the user's own preference.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>Wave3-E3</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>Edits Services/Ai/Feedback + the memory write path (BFF) — coordinate BFF PRs via /conflict-check; depends on 030 (the Preference fact type).</parallel-reason>
    <deps>030</deps>
    <tags>bff-api, ai</tags>
    <estimated-effort>4-6 hours</estimated-effort>
