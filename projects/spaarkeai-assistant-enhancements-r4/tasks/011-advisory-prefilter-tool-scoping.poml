<task id="011" project="spaarkeai-assistant-enhancements-r4">
  <metadata>
    <title>Advisory pre-filter bounded-tool allow-list scoping on the one decider (FR-02)</title>
    <phase>1 — E1 grounded-recommend tier</phase>
    <gate>startable</gate>
    <status>completed</status>
