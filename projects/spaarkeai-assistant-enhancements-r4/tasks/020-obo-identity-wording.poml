<task id="020" project="spaarkeai-assistant-enhancements-r4">
  <metadata>
    <title>OBO-identity wording on user-scoped tool descriptions (FR-05 / QW1)</title>
    <phase>2 — E2 follow-ons</phase>
    <gate>startable</gate>
    <status>pending</status>
    <rigor>FULL</rigor>
    <rigor-reason>Edits a BFF AI tool handler description + its byte-equal seed row guarded by the D-4 parity test; touches shared Services/Ai; BFF-touching change requires code-review + adr-check.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Contained wording edit mirrored across a C# handler description and its byte-equal JSON seed row; the only subtlety is preserving byte-equality (D-4 parity) — well-specified, no architectural judgment.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>Wave1-independent</parallel-group>
    <parallel-safe>false</parallel-safe>
