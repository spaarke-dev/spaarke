  <acceptance-criteria>
    <criterion testable="true">With the Briefing tab already open, its card is suppressed (negative case).</criterion>
    <criterion testable="true">With the Briefing tab closed, the card appears and clicking it opens the Briefing tab with no duplicate.</criterion>
