<task id="018" project="spaarke-SPA-external-access-platform-r2">
  <metadata>
    <title>Delete inert ExternalCallerAuthorizationFilter + remove transitional /api/v1/collab group</title>
    <phase>P1 Module-host foundation</phase>
    <gate>blocked-until:015,016</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>BFF deletion with blast radius (endpoints + filter + policy wiring); brownfield; must prove zero callers before removal; tags bff-api.</rigor-reason>
    <model-tier>opus</model-tier>
    <model-tier-reason>High-blast-radius BFF deletion requiring caller-graph judgment before an irreversible removal — opus per CLAUDE.md §8.5.</model-tier-reason>
    <effort>xhigh</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
