<task id="025" project="spaarke-SPA-external-access-platform-r2">
  <metadata>
    <title>D1: grade workforce within-project rights by ADR-034 role→level via WorkforcePrincipalStrategy</title>
    <phase>P2 Access-control + entitlement</phase>
    <gate>blocked-until:024</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Tags `bff-api`, `auth`; edits the shipped `WorkforcePrincipalStrategy` (Tier-2 grading) on the shared surface; brownfield mapping with security implications — FULL per CLAUDE.md §8.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Well-specified brownfield mapping: replace flat `Collaborate` with a byRole→level map at a named extension point (:328); the role→level table is given by the owner.</model-tier-reason>
    <effort>xhigh</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
