<task id="022" project="record-header-and-notepad-r2">
  <metadata>
    <title>useRecordHeaderFields — hoist form-buffer staging, pending buffer, and lookup projection; unify the throwing path</title>
    <phase>2 Metadata + Machinery</phase>
