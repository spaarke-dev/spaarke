<task id="023" project="record-header-and-notepad-r2">
  <metadata>
    <title>OOB lookup cell — editable lookups open Xrm.Utility.lookupObjects; retire the custom type-ahead from the header path</title>
    <phase>2 Metadata + Machinery</phase>
    <gate>unblocked (deps 020, 022 complete)</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Tags include 'pcf' and modifies .ts/.tsx code files — Step 3.5.5 code-implementation trigger</rigor-reason>
