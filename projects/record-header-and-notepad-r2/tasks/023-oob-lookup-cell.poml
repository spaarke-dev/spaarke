    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>Serial after 020 (metadata targets) and 022 (saveLookup write path); edits hooks/useRecordHeaderFields.ts created by 022.</parallel-reason>
