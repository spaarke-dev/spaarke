      <file role="canonical-reference">scripts/ (Deploy-Release.ps1 token substitution + provisioning scripts)</file>
      <file role="canonical-reference">docs/guides/auth-deployment-setup.md + docs/guides/CONFIGURATION-MATRIX.md</file>
