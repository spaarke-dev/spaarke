<?xml version="1.0" encoding="UTF-8"?>
<task id="033" project="code-quality-and-assurance-r3">
  <metadata>
    <title>Horizontal: observability sweep (logging, correlation IDs, PII, telemetry)</title>
    <phase>3 Horizontals</phase>
    <gate>startable</gate>
    <status>not-started</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>Observability audit producing findings + tasks (assessment-style); not test-modifying — STANDARD.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Pattern sweep across logging/correlation/PII/telemetry; Sonnet default.</model-tier-reason>
    <effort>medium</effort>
    <parallel-group>P3</parallel-group>
    <parallel-safe>true</parallel-safe>
    <deps>none</deps>
    <tags>observability,logging</tags>
  </metadata>

  <prompt>Sweep logging consistency, correlation IDs, PII-in-logs, and telemetry on critical paths. Track findings; ensure no PII in logs on audited paths.</prompt>
  <role>SPAARKE platform developer with observability expertise. Follow the rubric D9 (Observability).</role>
  <goal>An observability report exists in notes/ with findings tracked; no PII appears in logs on audited critical paths; correlation-ID + structured-logging gaps are filed as tasks.</goal>

  <context>
    <background>spec.md FR-20 / design.md §8 + rubric D9. Sweep logging consistency, correlation IDs, PII-in-logs, and telemetry on critical paths. Findings become tracked work.</background>
    <relevant-files>
      <file role="output">projects/code-quality-and-assurance-r3/notes/observability-sweep-report.md</file>
      <file role="canonical-reference">docs/standards/CODE-QUALITY-RUBRIC.md</file>
    </relevant-files>
    <dependencies>
      <dependency task="none" status="complete">Independent horizontal.</dependency>
    </dependencies>
  </context>

  <constraints>
    <constraint source="project">Scope: audit logging + correlation IDs + PII-in-logs + telemetry on critical paths; produce findings + tracked tasks. No PII may appear in logs on audited paths.</constraint>
    <constraint source="project">Scope: this is a sweep — remediation of each finding is a separate task unless a PII-in-log leak is found (fix those inline as security-adjacent).</constraint>
  </constraints>

  <knowledge>
    <topic>Observability sweep</topic>
    <files>
      <file>docs/standards/CODE-QUALITY-RUBRIC.md</file>
    </files>
  </knowledge>

  <steps mode="directional">
    <step order="0" name="Context + rigor declaration">Output the rigor-level declaration (STANDARD + reason).</step>
    <step order="1">Sweep logging consistency (structured logs) + correlation-ID propagation on critical paths.</step>
    <step order="2">Scan for PII in logs on audited paths; fix any leak inline.</step>
    <step order="3">Check telemetry coverage on critical paths; file gaps as tasks.</step>
    <step order="4">Write notes/observability-sweep-report.md.</step>
    <step order="5">Update TASK-INDEX.md: set task 033 status to ✅.</step>
    <step order="6">Document any deviation in projects/code-quality-and-assurance-r3/notes/.</step>
  </steps>

  <outputs>
    <output type="doc">projects/code-quality-and-assurance-r3/notes/observability-sweep-report.md</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">Given the sweep, notes/observability-sweep-report.md exists with findings tracked.</criterion>
    <criterion testable="true">Negative: no PII appears in logs on audited critical paths (any leak fixed inline).</criterion>
    <criterion testable="true">Given the report, correlation-ID / structured-logging / telemetry gaps are filed as tasks.</criterion>
  </acceptance-criteria>

  <notes>Maps spec.md FR-20 / design.md §8 + rubric D9.</notes>

  <execution><skill>.claude/skills/task-execute/SKILL.md</skill></execution>
</task>
