    <parallel-group>none</parallel-group>
    <parallel-safe>true</parallel-safe>
    <deps>010,011,012,013,014,015</deps>
    <tags>quality,docs</tags>
  </metadata>

  <prompt>Consolidate all surface assessments (BFF already seeded + the six new surface rows from tasks 010–015) into the honest re-baseline aggregate in notes/SCORECARD.md. Explicitly supersede the stale March "A (95/100)". Publish NO aggregate until every surface is scored.</prompt>
  <role>SPAARKE platform developer holding program grade-authority (self-score per design §15 Q5). Follow the rubric strictly; be honest, not flattering.</role>
  <goal>notes/SCORECARD.md holds a complete D1–D11 matrix (all seven surfaces scored) with a published program aggregate grade that explicitly supersedes the March "A (95/100)".</goal>

  <context>
    <background>spec.md FR-04: re-score every surface against the rubric via the verified method; publish honest current grades — no aggregate until every surface is scored; the stale March "A (95/100)" is explicitly superseded. All six surface assessment tasks (010–015) plus the seeded BFF row (task 002) must be complete before this runs.</background>
    <relevant-files>
      <file role="output">projects/code-quality-and-assurance-r3/notes/SCORECARD.md</file>
      <file role="canonical-reference">docs/standards/CODE-QUALITY-RUBRIC.md</file>
      <file role="canonical-reference">projects/code-quality-and-assurance-r3/workstreams/shared-client-libs/design.md</file>
      <file role="canonical-reference">projects/code-quality-and-assurance-r3/workstreams/shared-server-libs/design.md</file>
      <file role="canonical-reference">projects/code-quality-and-assurance-r3/workstreams/pcf-controls/design.md</file>
      <file role="canonical-reference">projects/code-quality-and-assurance-r3/workstreams/dataverse-model-alm/design.md</file>
      <file role="canonical-reference">projects/code-quality-and-assurance-r3/workstreams/code-pages-build-sprawl/design.md</file>
      <file role="canonical-reference">projects/code-quality-and-assurance-r3/workstreams/plugins/design.md</file>
    </relevant-files>
    <dependencies>
      <dependency task="010" status="pending">Shared-client-libs assessment row.</dependency>
      <dependency task="011" status="pending">Shared-server-libs assessment row.</dependency>
      <dependency task="012" status="pending">PCF assessment row.</dependency>
      <dependency task="013" status="pending">Dataverse model + ALM assessment row.</dependency>
      <dependency task="014" status="pending">Code-pages + build-sprawl assessment row.</dependency>
      <dependency task="015" status="pending">Plugins assessment row.</dependency>
    </dependencies>
  </context>

  <constraints>
    <constraint source="spec">Scope: publish NO aggregate grade until all seven surfaces (BFF + 6) have verified rows (FR-04) — verify each row's presence before computing the aggregate.</constraint>
    <constraint source="spec">Scope: explicitly supersede the March "A (95/100)" with a dated note in SCORECARD.md.</constraint>
    <constraint source="project">Scope (this file only): consolidation into notes/SCORECARD.md; touches no source code.</constraint>
  </constraints>

  <knowledge>
    <topic>Re-baseline aggregate scoring</topic>
    <files>
      <file>docs/standards/CODE-QUALITY-RUBRIC.md</file>
      <file>projects/code-quality-and-assurance-r3/design.md</file>
    </files>
  </knowledge>

  <steps mode="directional">
    <step order="0" name="Context + rigor declaration">Output the rigor-level declaration (STANDARD + reason). Verify all six surface designs (010–015) exist and BFF row is seeded.</step>
    <step order="1">Verify each surface has a complete verified D1–D11 row in SCORECARD.md; if any is missing, STOP (do not fabricate).</step>
    <step order="2">Compute the per-surface grades and the program aggregate per the rubric's roll-up rule (task 001).</step>
    <step order="3">Write the aggregate into SCORECARD.md with a dated note explicitly superseding the March "A (95/100)".</step>
    <step order="4">Cross-check the aggregate reads honestly (it should reflect the BFF B/B– and any newly-found debt — not a flattering number).</step>
    <step order="5">Update TASK-INDEX.md: set task 016 status to ✅.</step>
    <step order="6">Document any deviation in projects/code-quality-and-assurance-r3/notes/.</step>
  </steps>

  <escalation>
    <trigger>If any of the six surface rows is missing or unverified when this task runs, STOP — do not publish an aggregate from an incomplete matrix (FR-04 forbids it).</trigger>
  </escalation>

  <outputs>
    <output type="doc">projects/code-quality-and-assurance-r3/notes/SCORECARD.md (aggregate published)</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">Given all seven surfaces scored, SCORECARD.md publishes a program aggregate grade computed per the rubric roll-up.</criterion>
    <criterion testable="true">Given the aggregate, a dated note explicitly supersedes the March "A (95/100)".</criterion>
    <criterion testable="true">Negative: if any surface row is missing, no aggregate is published and the task stops.</criterion>
  </acceptance-criteria>

  <notes>Maps spec.md FR-04. This is the Phase-0 re-baseline gate output; forcing-functions + remediation build on the honest grade.</notes>

  <execution><skill>.claude/skills/task-execute/SKILL.md</skill></execution>
