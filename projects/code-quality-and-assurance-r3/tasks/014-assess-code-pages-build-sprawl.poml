<task id="014" project="code-quality-and-assurance-r3">
  <metadata>
    <title>Assess code-page solutions + build/config sprawl (35 pages, ~68k LOC, 69 package.json)</title>
    <phase>1 Full Assessment</phase>
    <gate>blocked until 001,003</gate>
    <status>not-started</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>Read-only Fable-verified assessment producing a design.md; no src/ or tests/ modification — STANDARD per task-create Step 3.5.5.</rigor-reason>
    <model-tier>fable</model-tier>
    <model-tier-reason>Runs the quality-assessment workflow whose mandatory adversarial-verification stage is Fable (NFR-05).</model-tier-reason>
