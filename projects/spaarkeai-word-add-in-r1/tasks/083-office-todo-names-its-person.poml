    <file role="edit">tests/integration/data-mutation/RecordOwnership/OfficeRecordOwnershipTests.cs</file>
    <file role="read">src/server/api/Sprk.Bff.Api/Services/Ai/Narrators/DailyBriefingCollector.cs</file>
