<task id="119" project="spaarkeai-word-add-in-r1">
  <metadata>
    <title>UAT round 12 (O4/W2, W3) - Find results visibly open what they show; check whether the Office To Do applies the restricted-record rule</title>
    <phase>6 UAT round 12 (2026-10-08)</phase>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies production `.tsx` (`FindResultsList.tsx`) and tests.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Small client change plus a read-only server trace.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>UAT12-W1</parallel-group>
    <parallel-safe>true</parallel-safe>
    <parallel-reason>Owns Find files only; must not edit SaveFlow/SaveView/useSaveFlow, command surfaces, server code, ci-gated-suites.txt.</parallel-reason>
    <deps>092, 102</deps>
    <tags>frontend, office-addins, typescript, find, unit-test, investigation</tags>
