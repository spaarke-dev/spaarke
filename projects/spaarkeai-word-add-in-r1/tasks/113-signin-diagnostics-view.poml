    <file role="edit">src/client/office-addins/shared/services/AuthService.ts</file>
    <file role="edit">src/client/office-addins/webpack.config.js</file>
    <file role="edit">.github/workflows/deploy-office-addins.yml</file>
  </relevant-files>
</task>
