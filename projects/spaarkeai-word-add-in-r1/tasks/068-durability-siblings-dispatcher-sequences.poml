    <file role="edit">src/server/api/Sprk.Bff.Api/Services/Office/OfficeService.cs</file>
    <file role="edit">src/server/api/Sprk.Bff.Api/Services/Jobs/JobStatusService.cs</file>
    <file role="edit">src/server/api/Sprk.Bff.Api/Workers/Office/UploadFinalizationWorker.cs</file>
    <file role="edit">src/server/api/Sprk.Bff.Api/Api/Office/OfficeEndpoints.cs</file>
    <file role="new">projects/spaarkeai-word-add-in-r1/notes/068-durability-siblings.md</file>
  </relevant-files>

