    <patterns>
      <pattern name="Body-supplied scope must not outrank the token" location="src/server/api/Sprk.Bff.Api/Api/Filters/TenantAuthorizationFilter.cs">
        Lines 106-141 — the existing request-type match list. `SendToIndexRequest` is the missing entry.
      </pattern>
