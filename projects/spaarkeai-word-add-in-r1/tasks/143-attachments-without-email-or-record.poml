      <file>src/server/api/Sprk.Bff.Api/Services/Office/OfficeService.cs</file>
      <file>src/server/api/Sprk.Bff.Api/Services/Office/EmailAttachmentAddPlanner.cs</file>
      <file>src/server/api/Sprk.Bff.Api/Services/Office/OfficeEmailEnricher.cs</file>
      <file>src/server/api/Sprk.Bff.Api/Services/Documents/DocumentUrlIdentityResolution.cs</file>
      <file>src/server/api/Sprk.Bff.Api/Api/Filters/DocumentEmailIdentityFilter.cs</file>
