@@ -0,0 +1,91 @@
+using System.Net;
+using System.Net.Http.Json;
+using FluentAssertions;
+using Sprk.Bff.Api.Tests.AccessControl;
+using Xunit;
+
+namespace Sprk.Bff.Api.Tests.Api.Documents;
+
+/// <summary>
+/// spaarkeai-word-add-in-r1 task 098 (owner decision 2026-10-05) — <c>POST /api/documents/{id}/share-link</c>
+/// refuses SPE-backed documents with a typed 422 <c>SHARE_LINK_UNSUPPORTED_SPE</c> instead of relaying Graph's
+/// error. Authorization still runs first (401/403 unchanged — covered by the UAC suite).
+/// </summary>
+/// <remarks>
+/// Reuses <see cref="ShareLinkTestFixture"/> (owned by unified-access-control-r2; referenced, not edited): its
+/// <c>MintedLinks</c> recorder is the evidence that the route never reaches Graph.
+/// </remarks>
+public class ShareLinkSpeRefusalContractTests : IClassFixture<ShareLinkTestFixture>
+{
+    private readonly ShareLinkTestFixture _fixture;
+    private const string DocumentId = "11111111-1111-1111-1111-111111111111";
+    private static string Route => $"/api/documents/{DocumentId}/share-link";
+
+    public ShareLinkSpeRefusalContractTests(ShareLinkTestFixture fixture)
+    {
+        _fixture = fixture;
+        _fixture.Reset();
+    }
+
+    [Fact]
+    public async Task AuthorizedCaller_SpeDocument_Gets422WithTypedCode_AndNothingIsMinted()
+    {
+        var client = _fixture.CreateClientWithRights("ReadAccess,ShareAccess");
+
+        var response = await client.PostAsJsonAsync(Route, new { });
+
+        // 422, not 409: well-formed request, authorized caller, permanent property of where the file lives.
+        // 409 stays the vocabulary for the fixable pointer states (no_file_attached, mapping_missing_drive).
+        response.StatusCode.Should().Be(HttpStatusCode.UnprocessableEntity,
+            "body was: {0}", await response.Content.ReadAsStringAsync());
+        (await ReadCodeAsync(response)).Should().Be("SHARE_LINK_UNSUPPORTED_SPE");
+        _fixture.MintedLinks.Should().BeEmpty("the route must not reach Graph at all");
+    }
+
+    [Fact]
+    public async Task Refusal_DoesNotRelayGraphErrorText()
+    {
+        var client = _fixture.CreateClientWithRights("ReadAccess,ShareAccess");
+
+        var body = await (await client.PostAsJsonAsync(Route, new { })).Content.ReadAsStringAsync();
+
+        body.Should().NotContain("CSP Container");
+        body.Should().Contain("Spaarke record");
+    }
+
+    [Fact]
+    public async Task ExternalRecipientsRequested_IsRefusedTheSameWay()
+    {
+        var client = _fixture.CreateClientWithRights("ReadAccess,ShareAccess");
+
+        var response = await client.PostAsJsonAsync(Route, new { allowExternalRecipients = true });
+
+        response.StatusCode.Should().Be(HttpStatusCode.UnprocessableEntity);
+        (await ReadCodeAsync(response)).Should().Be("SHARE_LINK_UNSUPPORTED_SPE");
+        _fixture.MintedLinks.Should().BeEmpty();
+    }
+
+    [Fact]
+    public async Task CallerWithoutShare_StillGets403_NotTheRefusal()
+    {
+        var client = _fixture.CreateClientWithRights("ReadAccess");
+
+        var response = await client.PostAsJsonAsync(Route, new { });
+
+        response.StatusCode.Should().Be(HttpStatusCode.Forbidden);
+    }
+
+    [Fact]
+    public async Task NoToken_IsStillUnauthorized()
+    {
+        var response = await _fixture.CreateClient().PostAsJsonAsync(Route, new { });
+
+        response.StatusCode.Should().BeOneOf(HttpStatusCode.Unauthorized, HttpStatusCode.Forbidden);
+    }
+
+    private static async Task<string?> ReadCodeAsync(HttpResponseMessage response)
+    {
+        using var doc = System.Text.Json.JsonDocument.Parse(await response.Content.ReadAsStringAsync());
+        return doc.RootElement.GetProperty("extensions").GetProperty("code").GetString();
+    }
+}
