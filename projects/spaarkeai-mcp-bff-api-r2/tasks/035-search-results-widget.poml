    <output type="test">src/client/widgets/spaarke-search-results/src/__tests__/App.test.tsx</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">resources/list includes ui://spaarke/search-results.html with an empty _meta.ui.csp; both search tools carry that resourceUri.</criterion>
    <criterion testable="true">Widget jest: renders fixture hits through a fake transport; zero fetch/Xrm calls; activating a hit calls the host openLink.</criterion>
    <criterion testable="true">check-bundle-size.mjs passes (size recorded; ≤ 3 MB).</criterion>
    <criterion testable="true">Negative: no file under src/client/shared/Spaarke.AI.Widgets changed; 022's contract tests pass unchanged.</criterion>
    <criterion testable="true">ArchTests and conformance pass; publish-size delta recorded; no new HIGH CVE.</criterion>
    <criterion testable="true">Test scope: cover the stated contract plus the edge cases named in these criteria; anything beyond that needs a one-line justification in the task notes.</criterion>
