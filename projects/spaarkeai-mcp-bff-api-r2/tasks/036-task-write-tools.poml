    <output type="test">tests/integration/auth/Mcp/Tasks/TaskWriteToolsAuthTests.cs</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">A tool-created event's written fields equal a REST-created one for the same inputs (captured at the capability boundary).</criterion>
    <criterion testable="true">A retried create with the same idempotencyKey and caller writes once and returns the same id; a different key writes a second record.</criterion>
    <criterion testable="true">Completing an open task completes it; completing it again writes nothing and returns success.</criterion>
    <criterion testable="true">Negative: completing user B's private event returns not-found for user A and writes nothing; a create regarding a record the caller cannot append to returns the REST reasonCode.</criterion>
    <criterion testable="true">Negative: no caller context returns UserContextRequired.</criterion>
    <criterion testable="true">ArchTests and conformance pass; publish-size delta recorded; no new HIGH CVE.</criterion>
    <criterion testable="true">Test scope: cover the stated contract plus the edge cases named in these criteria; anything beyond that needs a one-line justification in the task notes.</criterion>
  </acceptance-criteria>

  <notes>Spec FR-07, FR-15, NFR-06. Two adversarial-verifier passes (tenant-isolation tag). uac-r2 reviews.</notes>

