  <outputs>
    <output type="code">src/server/api/Sprk.Bff.Api/Api/Mcp/LegalOperations/Tasks/CreateTaskTool.cs</output>
    <output type="code">src/server/api/Sprk.Bff.Api/Api/Mcp/LegalOperations/Tasks/CompleteTaskTool.cs</output>
