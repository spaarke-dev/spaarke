      <file role="modify">tests/Spaarke.ArchTests/RouteAuthorizationGuardTests.Ledger.cs (:174, :2780, :3654, :3875-3879), RouteAuthorizationGuardTests.ProvenByTest.cs (:209-220), RouteAuthorizationGuardTests.cs, SessionOwnershipGuardTests.cs, ADR013_AiBoundaryTests.cs, TenantIsolation/I6_ObAppRegDerivationTests.cs, TenantIsolation/SpeAppOnlyContainerGuardTests.cs</file>
