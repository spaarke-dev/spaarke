<?xml version="1.0" encoding="UTF-8"?>
<task id="041" project="spaarkeai-mcp-bff-api-r2">
  <metadata>
    <title>Routing eval at ≈10, ≈15 and all tools (runs A, B, C) and description fixes</title>
    <phase>3 Email, evaluation and E2E</phase>
    <gate>Run A after 029, run B after 039, run C after 049; the owner runs the prompts in Copilot</gate>
    <status>not-started</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>Evaluation and, if needed, description-only edits to tool classes</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Tabulation against fixed thresholds and r1's method; description edits are bounded to the description strings</model-tier-reason>
    <effort>high</effort>
    <parallel-group>L</parallel-group>
    <parallel-safe>true</parallel-safe>
    <parallel-reason>Owns notes/routing-eval-*.md and, only for misses, tool description strings; runs between deploys</parallel-reason>
    <deps>029</deps>
    <tags>ai, testing, docs</tags>
    <estimated-effort>4-6 hours across three runs</estimated-effort>
  </metadata>

  <prompt>Collect the owner's routing-eval results for runs A (after 029), B (after 039) and C (after 049) from notes/routing-eval-{A,B,C}.md, compute per-tool positive pick rates and the control false-positive rate per run, and fix any miss by editing tool descriptions only (never by splitting the route), re-running the affected prompts.</prompt>
  <role>SPAARKE platform developer. Follow ADRs strictly. Expert in MCP tool descriptions and Copilot tool routing.</role>
  <goal>notes/routing-eval-summary.md records, for each run and tool, the pick rate (≥ 80% target) and the control rate (≤ 10% target); every miss has a description fix and a re-run result.</goal>

  <context>
    <background>Spec FR-17 (prompt set per tool plus unrelated prompts; at 10, 15 and all tools; ≥ 80% / ≤ 10%; misses fixed in descriptions, owner Q2). r1 method: projects/spaarkeai-mcp-bff-api-r1/notes/routing-eval.md. Run tables are prepared by deploy tasks 029 (A), 039 (B) and 049 (C). Planning approximates the spec's counts as ≈9, ≈18 and all model-visible tools (notes/decisions.md).</background>
    <relevant-files>
      <file role="new">projects/spaarkeai-mcp-bff-api-r2/notes/routing-eval-summary.md</file>
      <file role="modify">src/server/api/Sprk.Bff.Api/Api/Mcp/LegalOperations/**/*Tool.cs (description strings only, if a miss needs a fix)</file>
      <file role="canonical-reference">projects/spaarkeai-mcp-bff-api-r1/notes/routing-eval.md</file>
    </relevant-files>
    <dependencies>
      <dependency task="029" status="pending">Run A table</dependency>
    </dependencies>
  </context>

  <constraints>
    <constraint source="project">The owner runs the prompts (new chat per prompt, Spaarke MCP source selected, no skill); this task never fabricates results. A run with missing rows is recorded as incomplete, not filled in.</constraint>
    <constraint source="project">Fixes change description strings (≤ 1,024 characters, "use for / not for") only; no new route, server, connector, tool split or annotation change (owner Q2). Each fix re-runs the failing prompts and records the new rate.</constraint>
    <constraint source="ADR-029">Any description edit under src/server/api/Sprk.Bff.Api/ is listed in the PR with a Placement Justification that cites .claude/constraints/bff-extensions.md; publish-size delta recorded (expected ≈0); no new HIGH CVE.</constraint>
    <constraint source="project">Task stays open until run C is tabulated; record runs A and B as they arrive.</constraint>
  </constraints>

  <knowledge>
    <files>
      <file>.claude/constraints/ai.md</file>
      <file>.claude/skills/mcp-tool-handler/SKILL.md</file>
      <file>docs/guides/HOW-TO-ADD-AN-MCP-TOOL.md</file>
      <file>.claude/adr/ADR-013-ai-architecture.md</file>
      <file>.claude/adr/ADR-029-bff-publish-hygiene.md</file>
      <file>projects/spaarkeai-mcp-bff-api-r1/notes/routing-eval.md</file>
      <file>projects/spaarkeai-mcp-bff-api-r2/spec.md</file>
    </files>
  </knowledge>

  <steps mode="directional">
    <step order="1">When the owner returns run A, tabulate per tool and controls in routing-eval-summary.md; fix misses in descriptions; ask the owner to re-run those prompts.</step>
    <step order="2">Repeat for run B (after 039) and run C (after 049).</step>
    <step order="3">Update TASK-INDEX.md: change this task's status cell to `✅ [done]` (the bracketed ASCII token is mandatory, the emoji alone is not greppable: task-create Step 5, FAILURE-MODES G-16), set the POML &lt;status&gt; to completed, and run pwsh scripts/check-task-status-drift.ps1</step>
    <step order="4">If any deviations from plan, document in projects/spaarkeai-mcp-bff-api-r2/notes/ (decisions go to notes/decisions.md)</step>
  </steps>

  <escalation>
    <trigger>If a tool stays below 80% after two description fixes, or controls exceed 10%, STOP and escalate to the owner with the data (Q2 forbids a route split; the owner decides).</trigger>
  </escalation>

  <justification>
    <existing>r1's routing-eval method and table (projects/spaarkeai-mcp-bff-api-r1/notes/routing-eval.md).</existing>
    <extension>The method is reused; only a summary note is new (project notes, not product surface).</extension>
    <cost-of-doing-nothing>FR-17's acceptance (≥ 80% per tool, ≤ 10% controls, recorded per count) has no evidence.</cost-of-doing-nothing>
  </justification>

  <tools>
    <tool name="dotnet">dotnet build (after description edits)</tool>
  </tools>

  <outputs>
    <output type="docs">projects/spaarkeai-mcp-bff-api-r2/notes/routing-eval-summary.md</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">routing-eval-summary.md has, for runs A, B and C, the tool count, each model-visible tool's pick rate and the control rate, with dates and deployed SHAs.</criterion>
    <criterion testable="true">Each tool's final pick rate is ≥ 80% and the final control rate ≤ 10%, or an owner escalation is recorded.</criterion>
    <criterion testable="true">Negative: git diff for this task under src/ touches only description strings (no route, tool, annotation or registration change).</criterion>
    <criterion testable="true">No row is filled without an owner-run result.</criterion>
  </acceptance-criteria>

  <notes>Spec FR-17; owner Q2.</notes>

  <execution>
    <skill>.claude/skills/task-execute/SKILL.md</skill>
    <protocol>Before starting, load all files listed in &lt;knowledge&gt;&lt;files&gt;. Follow task-execute for the pre-execution checklist.</protocol>
  </execution>
</task>
