<task id="090" project="set-regarding-and-field-mapping-resolver-r2">
  <metadata>
    <title>Project wrap-up — verify, gates, test-diet, close</title>
    <phase>5: Wrap-up</phase>
    <status>not-started</status>
    <estimated-hours>3</estimated-hours>
    <dependencies>020,021,022,030,040,041</dependencies>
    <blocks>none</blocks>
    <tags>testing, e2e-test, wrap-up, deploy</tags>
