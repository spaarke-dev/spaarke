  <constraints>
    <constraint source="project">Mock IDataService + authenticatedFetch (BFF profiles response). Do NOT hit a live BFF.</constraint>
    <constraint source="project">Cover the CLOSED set: Copy-scalar, Copy-lookup, Default, Concat, Template, same-entity self-map, no-source===target guard, no-profile no-op, missing-source-field warning, unresolved-placeholder warning, unresolvable-lookup warning, never-throw.</constraint>
    <constraint source="ADR-038">Follow KEEP-path test categories; no Mock&lt;HttpMessageHandler&gt;-style anti-patterns.</constraint>
