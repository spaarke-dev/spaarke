<task id="003" project="set-regarding-and-field-mapping-resolver-r2">
  <metadata>
    <title>BFF tests + publish-size + push regression for DTO extension</title>
    <phase>0: BFF Contract + Schema Extension</phase>
    <status>completed</status>
    <estimated-hours>3</estimated-hours>
    <dependencies>002</dependencies>
    <blocks>010</blocks>
    <tags>bff-api, testing, unit-test, deploy</tags>
    <rigor-hint>FULL</rigor-hint>
    <rigor-reason>TEST-MODIFYING + bff-api; §10 requires test update + publish-size verification on BFF-touching tasks.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Test authoring + mechanical verification against an existing test project.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
