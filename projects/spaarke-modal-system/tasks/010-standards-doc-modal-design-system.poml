<task id="010" project="spaarke-modal-system">
  <metadata>
    <title>Standards doc: MODAL-DESIGN-SYSTEM.md — FR-10</title>
    <phase>0 Build</phase>
    <gate>blocked until 004</gate>
    <status>not-started</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>New file creation (documentation) with project constraints; no code, no quality gate at Step 9.5.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Standards-doc authoring from a settled spec + prototype-locked numbers; no architectural judgment.</model-tier-reason>
    <effort>medium</effort>
    <parallel-group>none</parallel-group>
