    </files>
  </knowledge>

  <steps mode="directional">
    <step order="0" name="Context">Declare rigor (FULL). Confirm task 081 deployed R3 to spaarkedev1 and all surfaces are healthy. Load the `ui-test` skill + spec Success Criteria. Prepare the two fixtures (formatted contract; a doc with existing Word revisions/comments).</step>
    <step order="1" name="G-R3 step 1 — open formatted contract">Open the formatted contract in Compose; verify it renders with letterhead header/footer, multi-level clause numbering, custom styles, and the table intact. Record pass/fail + evidence.</step>
    <step order="2" name="G-R3 step 2 — edits + AI redline">Edit 3 clauses (incl. one bold/italic run change); accept one AI redline. Verify the edits show as tracked changes and the AI redline shows rationale + a grounding-tied confidence band. Record.</step>
    <step order="3" name="G-R3 step 3 — toolset">Exercise a find/replace AND a table edit in the same session. Verify both work and the tracked-changes marks remain intact/uncorrupted. Record.</step>
    <step order="4" name="G-R3 step 4 — save + reopen (the core)">Save, then reopen. Verify header/footer/numbering/styles/table are INTACT; the 3 edits + accepted redline are present as tracked changes; each redline is anchored to the correct paragraph by `w14:paraId`. Record.</step>
    <step order="5" name="Supporting criterion 5 — import round-trip">Open the doc that already has Word revisions/comments; verify they render in-editor; save + reopen; verify they are preserved (FR-24/25/26). Record.</step>
    <step order="6" name="Record + gate">Compile the G-R3 result (each numbered step pass/fail + evidence). If any step fails, the gate BLOCKS graduation — escalate per §6.5, do not pass. Update TASK-INDEX + the README graduation checkboxes.</step>
  </steps>

  <ui-tests>
    <ui-test criterion="G-R3.1" maps-to="spec Success Criteria #1">Open a formatted contract (letterhead header/footer, multi-level clause numbering, custom styles, a table) → renders with structure intact.</ui-test>
    <ui-test criterion="G-R3.2" maps-to="spec Success Criteria #2">Edit 3 clauses incl. one bold/italic run change + accept one AI redline → edits show as tracked changes; the AI redline shows rationale + a grounding-tied confidence band.</ui-test>
    <ui-test criterion="G-R3.3" maps-to="spec Success Criteria #3">Exercise a find/replace + a table edit in the same session → both work; tracked-changes marks intact.</ui-test>
    <ui-test criterion="G-R3.4" maps-to="spec Success Criteria #4 (the core)">Save then reopen → header/footer/numbering/styles/table intact; the 3 edits + accepted redline present as tracked changes, each anchored to the correct paragraph by `w14:paraId`.</ui-test>
    <ui-test criterion="G-R3.5" maps-to="spec Success Criteria #5 (supporting)">Open a doc that already has Word revisions/comments → they render in-editor and are preserved across save (import round-trip FR-24/25/26).</ui-test>
  </ui-tests>

  <outputs>
    <output type="report">G-R3 flagship result: each numbered step (1–4) + supporting criterion 5 recorded pass/fail with browser evidence</output>
    <output type="docs">projects/spaarkeai-compose-r3/README.md graduation checkboxes updated</output>
  </outputs>

  <acceptance-criteria testable="true">
    <criterion testable="true">G-R3 step 1: a formatted contract (letterhead header/footer, multi-level clause numbering, custom styles, a table) opens in Compose and renders with structure intact.</criterion>
    <criterion testable="true">G-R3 step 2: 3 clause edits (incl. one bold/italic run change) show as tracked changes, and one accepted AI redline shows its rationale + a grounding-tied confidence band.</criterion>
    <criterion testable="true">G-R3 step 3: a find/replace AND a table edit both work in the same session with the tracked-changes marks intact.</criterion>
    <criterion testable="true">G-R3 step 4 (the core): after Save+reopen, header/footer/numbering/styles/table are intact; the 3 edits + accepted redline persist as tracked changes, each anchored to the correct paragraph by `w14:paraId`.</criterion>
    <criterion testable="true">Supporting criterion 5: a doc that already has Word revisions/comments opens with them rendered in-editor and preserved across save (FR-24/25/26).</criterion>
    <criterion testable="true">The gate is browser-verified on spaarkedev1 in one run; each numbered step is recorded pass/fail with evidence, and any failure BLOCKS graduation (escalated per §6.5, not silently passed).</criterion>
