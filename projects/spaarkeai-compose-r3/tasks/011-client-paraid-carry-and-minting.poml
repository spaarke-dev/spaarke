    <patterns>
      <pattern name="Load convert + editor mount" location="src/client/shared/Spaarke.Compose.Components/src/utils/docxBridge.ts">
        Where mammoth HTML is turned into editor content — add the explicit paraId-stamping transaction here after `setContent`, reading the server paraId map from the Load response.
      </pattern>
      <pattern name="Editor extension config" location="src/client/shared/Spaarke.Compose.Components/src/widgets/ComposeEditor.tsx">
        Where TipTap extensions are configured — add `UniqueID.configure({ types: ['paragraph'], attributeName: 'paraId', generateID })` with a `renderHTML` that keeps the attribute off the DOM.
      </pattern>
