<task id="051" project="spaarkeai-compose-r3">
  <metadata>
    <title>FR-25 import existing comments — `RecoveredComment` threads via FR-23 comment-thread UI</title>
    <phase>5 Import</phase>
    <gate>blocked</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <model-tier>sonnet</model-tier>
    <effort>high</effort>
