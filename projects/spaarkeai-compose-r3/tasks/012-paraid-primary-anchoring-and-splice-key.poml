<task id="012" project="spaarkeai-compose-r3">
  <metadata>
    <title>FR-11/FR-12 paraId-primary anchoring + fuzzy fallback (`AnnotationReanchorService`) + paraId as splice key</title>
    <phase>1 E2</phase>
    <gate>blocked</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
