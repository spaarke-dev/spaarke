<task id="030" project="spaarkeai-compose-r3">
  <metadata>
    <title>FR-13/FR-16 server-derived `confidence_band` (additive `ComposeDraftPayload`) + paraId/offsets on anchor</title>
    <phase>3 E3</phase>
    <gate>blocked</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
