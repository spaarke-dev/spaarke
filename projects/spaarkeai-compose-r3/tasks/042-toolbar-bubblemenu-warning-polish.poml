  <acceptance-criteria testable="true">
    <criterion testable="true">The formatting toolbar stays visible (pinned/sticky) at any scroll position within the editor — a test asserts the toolbar remains in view after the document scrolls (FR-19/DEF-16).</criterion>
    <criterion testable="true">The selection bubble menu renders on a single row at default editor widths (no wrap to two lines) — FR-20/DEF-17.</criterion>
    <criterion testable="true">The "opened with N simplification(s)" banner has an × that closes it; dismissal persists for the session (sessionStorage) and the banner does not reappear on re-render within the session — FR-21/DEF-15.</criterion>
    <criterion testable="true">No `@tiptap-pro/*` dependency and no TipTap product feature is added.</criterion>
    <criterion testable="true">All three surfaces render correctly in Fluent v9 dark mode (ADR-021).</criterion>
    <criterion testable="true">Matching component tests exist and pass; shared-lib `npm run build` is green.</criterion>
  </acceptance-criteria>

  <ui-tests>
    <ui-test name="Sticky toolbar during scroll (FR-19)">
      <steps>Open a long document, scroll the editor content down several screens.</steps>
      <expected>The formatting toolbar stays pinned and visible at the top of the editor region throughout the scroll.</expected>
    </ui-test>
    <ui-test name="One-line bubble menu (FR-20)">
      <steps>Select a run of text at default editor width to trigger the bubble menu.</steps>
      <expected>The bubble menu controls are laid out on a single row; nothing wraps to a second line.</expected>
    </ui-test>
    <ui-test name="Dismiss simplification banner persists (FR-21)">
      <steps>Open a doc that shows "opened with N simplification(s)"; click the × ; then re-render the editor within the same session.</steps>
      <expected>The banner closes on × and does not reappear on re-render for the remainder of the session.</expected>
    </ui-test>
    <ui-test name="Dark-mode render (ADR-021)">
      <steps>Render the toolbar, bubble menu, and simplification banner under the Fluent v9 dark theme provider.</steps>
      <expected>All three use theme tokens and are legible in dark mode; no hard-coded light colors.</expected>
    </ui-test>
  </ui-tests>

