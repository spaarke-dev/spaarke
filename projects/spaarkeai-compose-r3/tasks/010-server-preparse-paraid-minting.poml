      <pattern name="Server-side Open XML body/table walk" location="src/server/api/Sprk.Bff.Api/Services/Compose/DocxAnnotationReader.cs">
        Existing traversal of the document body incl. descent into table cells / nested tables — mirror its part-navigation and cell-recursion so the paraId walk covers the same paragraph set the annotation reader does.
      </pattern>
      <pattern name="LoadAsync convert seam" location="src/server/api/Sprk.Bff.Api/Services/Compose/ComposeService.cs">
