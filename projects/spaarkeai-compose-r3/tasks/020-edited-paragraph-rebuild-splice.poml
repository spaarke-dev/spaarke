<task id="020" project="spaarkeai-compose-r3">
  <metadata>
    <title>FR-02 edited-paragraph rebuild + paraId-keyed splice orchestration (server)</title>
    <phase>2 E1</phase>
    <gate>blocked</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <model-tier>opus</model-tier>
