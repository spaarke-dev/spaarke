<task id="025" project="ai-advanced-capabilities-analysis-hub-r1">
  <metadata>
    <title>Persistence hardening — stale→Cosmos, tab anchor, edit restore</title>
    <phase>2 Session</phase>
    <gate>blocked</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Three data-loss-prevention changes spanning BFF session recovery + SpaarkeAi tab/editor persistence; brownfield root-cause (silent empty-session bug); tags bff/frontend/session.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Well-specified fixes with clear acceptance, but brownfield stale-session recovery + tab-anchor + editor-restore require careful root-cause tracing — xhigh effort on Sonnet.</model-tier-reason>
    <effort>xhigh</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>Touches the shared `ChatSessionManager.GetSessionAsync` (BFF) + SpaarkeAi tab-persistence/editor state alongside 020–023; serial within Phase 2; `/conflict-check` before the BFF PR.</parallel-reason>
    <deps>020</deps>
