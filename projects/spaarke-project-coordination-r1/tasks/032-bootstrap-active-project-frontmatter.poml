<?xml version="1.0" encoding="UTF-8"?>
<task id="032" project="spaarke-project-coordination-r1">
  <metadata>
    <title>Bootstrap registry frontmatter for every active project; owner corrects (FR-13)</title>
    <phase>3 Registry and detector (report-only)</phase>
    <gate>030 complete</gate>
    <status>not-started</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>Edits many projects' READMEs; content needs owner correction.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Drafting from each project's spec and diff, then a validator run.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>P3-A</parallel-group>
    <parallel-safe>true</parallel-safe>
    <deps>030</deps>
    <tags>documentation, devops</tags>
    <estimated-effort>3-5 hours</estimated-effort>
  </metadata>

  <prompt>Draft lifecycle and owned_areas frontmatter for every active project's README.md (this project included), show the owner the full table for correction, then commit the corrected frontmatter.</prompt>
  <role>SPAARKE tooling developer preparing a registry draft for owner review.</role>
  <goal>Every active project's README.md has frontmatter that parses with zero errors, the owner approved the table, and the validator's conflict list is recorded.</goal>

  <context>
    <background>Spec FR-13 bootstrap. "Active" comes from Board #2 Status (In Progress) and the projects listed in projects/INDEX.md, cross-checked with the owner. Owned areas are drafted from each project's spec Affected Areas, and otherwise from the directories its branch has changed (git diff --stat origin/master...origin/work/&lt;project&gt;).</background>
    <relevant-files>
      <file role="modify">projects/*/README.md (active projects only)</file>
      <file role="output">projects/spaarke-project-coordination-r1/notes/registry-bootstrap-{date}.md</file>
    </relevant-files>
  </context>

  <constraints>
    <constraint source="spec FR-13">Scope: only the frontmatter block is added at the top of each README. No other README content changes. Projects not confirmed active are not edited.</constraint>
    <constraint source="project">Scope: the owner reviews the full draft table (project, lifecycle, owned_areas) before any README is edited. The session commits only the owner-corrected values.</constraint>
    <constraint source="NFR-06">Scope: these files are other projects' READMEs. Land in one PR touching only the frontmatter blocks, after /conflict-check, so a project editing its own README gets a trivial conflict at most.</constraint>
    <constraint source="spec MUST NOT">Scope: no project CLAUDE.md is edited.</constraint>
  </constraints>

  <knowledge>
    <files>
      <file>projects/spaarke-project-coordination-r1/spec.md</file>
      <file>projects/INDEX.md</file>
    </files>
  </knowledge>

  <steps mode="prescriptive">
    <step order="1">List active projects (Board #2 plus INDEX.md); confirm the list with the owner.</step>
    <step order="2">Draft owned_areas per project and write the table to notes/registry-bootstrap-{date}.md.</step>
    <step order="3">Present the table to the owner; apply corrections.</step>
    <step order="4">Add the frontmatter blocks; run python scripts/quality/project_registry.py --validate and record the conflict list.</step>
    <step order="5">Update tasks/TASK-INDEX.md: set this task to ✅ [done] AND set this POML status to completed; run pwsh scripts/check-task-status-drift.ps1.</step>
  </steps>

  <outputs>
    <output type="docs">projects/spaarke-project-coordination-r1/notes/registry-bootstrap-{date}.md</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">--validate exits 0 over the repo after the change.</criterion>
    <criterion testable="true">The notes record the owner-approved table and the conflict list.</criterion>
    <criterion testable="true">Negative: no README change outside the frontmatter block; no non-active project edited; no CLAUDE.md edited.</criterion>
  </acceptance-criteria>

  <execution>
    <skill>.claude/skills/task-execute/SKILL.md</skill>
    <protocol>Before starting this task, load all files listed in the knowledge files. Follow the task-execute skill for the mandatory pre-execution checklist.</protocol>
  </execution>
</task>
