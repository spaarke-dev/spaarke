<?xml version="1.0" encoding="UTF-8"?>
<task id="016" project="spaarke-project-coordination-r1">
  <metadata>
    <title>Live verification of the guard and dev log against spaarke-bff-dev (success criteria 1–3)</title>
    <phase>1 Shared environment guards</phase>
    <gate>011, 012, 013 merged to master; owner approval for any real deploy</gate>
    <status>not-started</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>Live check against shared dev; read-only by default.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Prescriptive procedure with fixed expected results.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>Touches the shared live dev environment.</parallel-reason>
    <deps>011, 012, 013</deps>
    <tags>deploy, azure, app-service, integration-test</tags>
    <estimated-effort>1-2 hours</estimated-effort>
  </metadata>

  <prompt>Prove the E1 replay is refused on the real spaarke-bff-dev, read-only, and confirm that the next owner-approved deploy of each type leaves one parseable dev-log entry.</prompt>
  <role>SPAARKE DevOps developer running a live check on shared dev.</role>
  <goal>notes/phase1-live-verification-{date}.md shows the read-only refusal from a branch lacking the live commit, the check-only pass from current master, and one parseable dev-log entry per deploy type exercised.</goal>

  <context>
    <background>Spec success criteria 1–3. -CheckOnly (task 010) lets the guard run against the live app without deploying. A real deploy is shared-dev-visible and needs the owner's explicit OK, going through /bff-deploy.</background>
    <relevant-files>
      <file role="output">projects/spaarke-project-coordination-r1/notes/phase1-live-verification-{date}.md</file>
    </relevant-files>
  </context>

  <constraints>
    <constraint source="project CLAUDE.md section 5">Scope: steps 1–2 are read-only (Assert-LiveBuildAncestry -CheckOnly). Step 3 runs only if the owner explicitly approves a deploy in this session, and goes through /bff-deploy. Otherwise step 3 is recorded as "pending the next owner-approved deploy" and the task completes with that noted.</constraint>
    <constraint source="project">Scope: the branch lacking the live commit is a local throwaway branch at a commit before the live SHA. It is never pushed and is deleted afterwards.</constraint>
  </constraints>

  <knowledge>
    <files>
      <file>projects/spaarke-project-coordination-r1/spec.md</file>
      <file>.claude/skills/bff-deploy/SKILL.md</file>
    </files>
  </knowledge>

  <steps mode="prescriptive">
    <step order="1">From a fresh master checkout in this worktree, run Assert-LiveBuildAncestry -CheckOnly against spaarke-bff-dev. Record the live SHA and the decision (expected: proceed, or a refusal naming a branch, which itself is a finding to report).</step>
    <step order="2">Create a local throwaway branch at a commit that is not a descendant of the live SHA, and run the guard with -CheckOnly. Record the refusal message (expected: SHA, containing branches, -Supersede). Delete the branch.</step>
    <step order="3">Only with owner approval: one deploy through /bff-deploy, then read the dev-log issue's latest comment and parse it back into fields.</step>
    <step order="4">Write the notes file.</step>
    <step order="5">Update tasks/TASK-INDEX.md: set this task to ✅ [done] AND set this POML status to completed; run pwsh scripts/check-task-status-drift.ps1.</step>
  </steps>

  <escalation>
    <trigger>If step 1 refuses on current master (the live build contains commits not on master), STOP and tell the owner which branch holds the live commit. That is an E1 already in progress.</trigger>
  </escalation>

  <outputs>
    <output type="docs">projects/spaarke-project-coordination-r1/notes/phase1-live-verification-{date}.md</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">The notes show the live SHA read from the real DLL.</criterion>
    <criterion testable="true">The notes show a refusal from the throwaway branch naming the SHA and -Supersede.</criterion>
    <criterion testable="true">Either one parsed dev-log entry from an owner-approved deploy, or the line "pending the next owner-approved deploy".</criterion>
    <criterion testable="true">Negative: no deploy happened without the owner's explicit approval; the throwaway branch does not exist locally or remotely.</criterion>
  </acceptance-criteria>

  <execution>
    <skill>.claude/skills/task-execute/SKILL.md</skill>
    <protocol>Before starting this task, load all files listed in the knowledge files. Follow the task-execute skill for the mandatory pre-execution checklist.</protocol>
  </execution>
</task>
