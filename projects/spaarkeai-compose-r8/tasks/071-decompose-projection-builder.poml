      <file role="canonical-reference">tests/integration/seam/Compose/ComposeFidelityGateHarnessTests.cs</file>
    </relevant-files>
  </context>

  <constraints>
    <constraint source="project">Projection output MUST be byte-for-byte equivalent before and after, proven EMPIRICALLY over the whole corpus (capture projections pre-refactor, compare post-refactor). Argument is not proof for this property.</constraint>
    <constraint source="ADR-010">Internal collaborators or partial classes — NOT new DI registrations.</constraint>
    <constraint source="god-class-ratchet">DELETE the waiver entry; do not re-baseline.</constraint>
    <constraint source="project">Behavior-preserving ONLY. MUST NOT widen what `ProjectRun` captures — that is tasks 040/041's concern and doing it here destroys the equivalence proof.</constraint>
    <constraint source="project">MUST NOT introduce a `body.Descendants&lt;Paragraph&gt;()` walk while restructuring part traversal — direct `w:body` children only; `w:txbxContent` / `mc:*` opaque.</constraint>
    <constraint source="ADR-038">Existing tests pass unchanged. No DI-registration or ctor-null tests for new collaborators.</constraint>
    <constraint source="project">`/conflict-check` before the PR; coordinate with the parallel god-class program.</constraint>
    <constraint source="ADR-029">Report publish size. No new NuGet.</constraint>
  </constraints>

  <knowledge>
    <topic>projection model, behavior-preserving refactoring, god-class ratchet</topic>
    <files>
