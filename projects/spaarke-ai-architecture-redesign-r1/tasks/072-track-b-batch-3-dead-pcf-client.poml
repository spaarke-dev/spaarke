<task id="072" project="spaarke-ai-architecture-redesign-r1">
  <metadata>
    <title>Track-B batch 3 — Dead PCF dirs + R1 client registries/providers/cross-pane</title>
    <phase>Track B: Continuous Deadwood Sweep</phase>
    <status>not-started</status>
    <estimated-hours>4</estimated-hours>
    <tags>cleanup, deletion, track-b, pcf</tags>
