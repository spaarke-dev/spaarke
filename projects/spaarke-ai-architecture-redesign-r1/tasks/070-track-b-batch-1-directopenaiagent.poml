<task id="070" project="spaarke-ai-architecture-redesign-r1">
  <metadata>
    <title>Track-B batch 1 — DirectOpenAiAgent cluster + server dependency-free deadwood</title>
    <phase>Track B: Continuous Deadwood Sweep</phase>
    <status>not-started</status>
    <estimated-hours>5</estimated-hours>
    <tags>cleanup, deletion, track-b</tags>
    <rigor-hint>STANDARD</rigor-hint>
    <parallel-group>W-P0-A</parallel-group>
    <parallel-safe>true</parallel-safe>
    <dependencies>none</dependencies>
