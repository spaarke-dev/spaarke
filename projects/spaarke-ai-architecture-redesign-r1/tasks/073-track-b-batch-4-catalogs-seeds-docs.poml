<task id="073" project="spaarke-ai-architecture-redesign-r1">
  <metadata>
    <title>Track-B batch 4 — Stale catalogs/seeds/docs/scripts + dependency-free remainder</title>
    <phase>Track B: Continuous Deadwood Sweep</phase>
    <status>not-started</status>
    <estimated-hours>4</estimated-hours>
