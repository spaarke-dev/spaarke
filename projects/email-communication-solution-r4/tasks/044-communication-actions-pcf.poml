    </files>
    <patterns>
      <pattern name="Reuse send endpoint" location="src/client/webresources/js/sprk_communication_send.js">
        The ribbon script's send payload/flow is the reference for the PCF's Send (same `/api/communications/send`), minus the 1,150-LOC cruft.
      </pattern>
      <pattern name="Compose host" location="src/client/shared/Spaarke.UI.Components/src/components/EmailComposer/wrappers/SendEmailPage.tsx">
        Host `<SendEmailPage/>` with mode + pre-fill + authenticatedFetch + onSent/onClose inside the PCF (or its dialog wrapper).
      </pattern>
