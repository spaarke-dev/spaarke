      <file>projects/email-communication-solution-r4/current-task.md</file>
    </relevant-files>
  </context>

  <constraints>
    <constraint source="root §7">A `090-wrapup-*` task MUST invoke `/test-diet` BEFORE marking the project complete; the wrap-up PR MUST cite `notes/test-diet-report.md` (or document the skip rationale). Skipping is a HARD WARNING.</constraint>
    <constraint source="root §3">Main-session only — this task writes project-close state + runs gates; do NOT delegate to a subagent.</constraint>
    <constraint source="ADR-038">`/test-diet` classifies per the build-vs-maintain criteria; the skill is read-only (emits `git rm`/`git mv` for the reviewer; no auto-execute).</constraint>
    <constraint source="project">Final `code-review` is a project-close gate; address Critical findings before declaring complete.</constraint>
  </constraints>

  <knowledge>
    <topic>project-close</topic>
    <files>
      <file>projects/email-communication-solution-r4/spec.md</file>
      <file>projects/email-communication-solution-r4/plan.md</file>
      <file>projects/email-communication-solution-r4/CLAUDE.md</file>
      <file>projects/email-communication-solution-r4/tasks/TASK-INDEX.md</file>
      <file>docs/adr/ADR-038-testing-strategy.md</file>
      <file>.claude/skills/test-diet/SKILL.md</file>
      <file>.claude/skills/repo-cleanup/SKILL.md</file>
      <file>.claude/skills/code-review/SKILL.md</file>
    </files>
  </knowledge>

  <steps>
    <step order="1" name="Verify all tasks complete">Read `TASK-INDEX.md`; confirm every W0–W8 task is ✅. If any remain 🔲/🔄, STOP and report.</step>
    <step order="2" name="README → Complete">Update the README status to Complete; summarize shipped W0–W8 scope + graduation criteria met.</step>
    <step order="3" name="Lessons-learned">Author `notes/lessons-learned.md` (R3 absorption, Services/Ai gate, Microsoft deadlines, deferred items, what went well/poorly).</step>
    <step order="4" name="/test-diet gate">Invoke `/test-diet`; produce `notes/test-diet-report.md` (MAINTAIN keep / SCAFFOLDING `git rm` / AMBIGUOUS reviewer-judgment). Do not auto-execute the emitted commands.</step>
    <step order="5" name="Archive">Run `/repo-cleanup` conventions: move ephemeral working/notes files to archive; retain permanent artifacts.</step>
    <step order="6" name="Final code-review">Run a final holistic `code-review` across the R4 diff surface; address Critical findings.</step>
    <step order="7" name="Update tracking">Mark task 090 ✅ in `TASK-INDEX.md`; set `current-task.md` to "none — project complete".</step>
    <step order="8" name="Ready to merge">Confirm the project is complete and ready for `merge-to-master`; the wrap-up PR cites `notes/test-diet-report.md`.</step>
  </steps>

  <tools>
    <tool name="read">Verify task completion + gather close artifacts</tool>
    <tool name="edit">README status; lessons-learned; tracking</tool>
    <tool name="test-diet">MANDATORY project-close test reconciliation gate</tool>
    <tool name="repo-cleanup">Archive ephemeral artifacts</tool>
    <tool name="code-review">Final project-close quality gate</tool>
  </tools>

