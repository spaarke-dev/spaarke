    <output type="docs">projects/email-communication-solution-r4/tasks/TASK-INDEX.md + current-task.md (UPDATED)</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">Every W0–W8 task is ✅ in `TASK-INDEX.md` before wrap-up completes.</criterion>
