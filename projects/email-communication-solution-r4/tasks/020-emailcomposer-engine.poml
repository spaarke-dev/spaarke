<task id="020" project="email-communication-solution-r4">
  <metadata>
    <title>Build the canonical `&lt;EmailComposer /&gt;` engine + sub-components in `@spaarke/ui-components`</title>
    <phase>Wave 2 — Client: composer engine + wrappers</phase>
    <status>not-started</status>
