<task id="004" project="email-communication-solution-r4">
  <metadata>
    <title>Add `sprk_event` to catalog/priority; correct the org association target to `sprk_organization`</title>
    <phase>Wave 0 — Shared foundation (schema · ADR · server send-changes · retire OOB-email)</phase>
    <status>not-started</status>
