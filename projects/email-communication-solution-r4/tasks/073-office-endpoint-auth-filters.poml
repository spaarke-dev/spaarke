<task id="073" project="email-communication-solution-r4">
  <metadata>
    <title>Apply the stubbed BFF Office auth filters in `OfficeEndpoints.cs` (real security gap)</title>
    <phase>Wave 7 — Microsoft hardening + auth + index</phase>
    <status>not-started</status>
    <estimated-hours>5</estimated-hours>
    <dependencies></dependencies>
    <blocks></blocks>
