<task id="042" project="email-communication-solution-r4">
  <metadata>
    <title>Connections PCF — multi-association review (typed slots + per-slot confidence/confirm + create-from-email) in the OOB form's accessories column</title>
    <phase>Wave 4 — OOB form + PCFs (association review)</phase>
    <status>completed</status>
