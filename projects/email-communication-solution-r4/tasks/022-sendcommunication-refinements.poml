      <file>.claude/adr/ADR-028-spaarke-auth-architecture.md</file>
      <file>.claude/patterns/auth/spaarke-sso-binding.md</file>
    </files>
    <patterns>
      <pattern name="Auth decoupling (injected fetch)" location="src/client/shared/Spaarke.UI.Components/src/services/communicationApi.ts">
        `authenticatedFetch` is a function parameter; the file does not import `@spaarke/auth`. Preserve this.
      </pattern>
      <pattern name="ProblemDetails parsing" location=".claude/adr/ADR-019-problemdetails-error-responses.md">
        try/catch around `await response.json()`; minimal fallback on non-JSON.
      </pattern>
      <pattern name="One-shot deprecation warning" location="projects/email-communication-solution-r4/reference/r3-send-side-design.md">
        §6 — module-level `let _deprecationWarned = false;`; first use warns + flips; later uses skip.
      </pattern>
    </patterns>
