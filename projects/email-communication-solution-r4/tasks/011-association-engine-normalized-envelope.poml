    <tool name="bash">Build, characterization + regression tests, publish-size, CVE scan</tool>
    <tool name="code-review">FULL-rigor quality gate (Step 9.5)</tool>
    <tool name="adr-check">FULL-rigor quality gate (Step 9.5)</tool>
    <tool name="conflict-check">Pre-PR hot-path conflict scan (Step 10)</tool>
  </tools>

