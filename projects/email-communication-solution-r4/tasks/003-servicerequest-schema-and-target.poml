    <patterns>
      <pattern name="Regarding target extension" location="src/server/api/Sprk.Bff.Api/Services/Communication/CommunicationService.cs">
        `RegardingLookupMap` (~lines 921-931 per spec) maps entity logical name → regarding lookup field. Add a `sprk_servicerequest` → `sprk_regardingservicerequest` entry. Mirror in `RegardingFieldPriority` (inbound priority) + `TODO_REGARDING_CATALOG` (client catalog).
      </pattern>
      <pattern name="Data-model doc authoring" location=".claude/skills/docs-data-model/SKILL.md">
        Entity markdown: key columns, relationships, the lookup(s) referencing it, consumers. Follow existing `docs/data-model/*.md` shape.
      </pattern>
