  </context>

  <constraints>
    <constraint source="project">NFR-05 / DEC-8: per-rung telemetry (fired/skipped, latency, match count, tier; tokens+cache for AI rungs) so the ladder is measurable on real volume.</constraint>
    <constraint source="project">NFR-08 / ADR-038: tests in `tests/unit/Sprk.Bff.Api.Tests/`; KEEP-path categories; no banned patterns (`Mock&lt;HttpMessageHandler&gt;`, DI-registration, ctor null-check).</constraint>
    <constraint source="project">Tests MUST lock: AI rungs (4/5) fire only on deterministic miss/ambiguity, and NEVER auto-file.</constraint>
