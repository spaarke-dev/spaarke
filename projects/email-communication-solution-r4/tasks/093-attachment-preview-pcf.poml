<task id="093" project="email-communication-solution-r4">
  <metadata>
    <title>Communication Attachments preview PCF — replace OOB subgrid, open Document Preview modal (UAT #2)</title>
    <phase>Wave 9 — Post-UAT remediation</phase>
    <status>not-started</status>
    <estimated-hours>10</estimated-hours>
    <dependencies>042,043,044</dependencies>
    <blocks>—</blocks>
    <tags>pcf, frontend, dataverse, deploy</tags>
    <rigor-hint>FULL</rigor-hint>
    <rigor-reason>New PCF control (new client surface, §11 justification), consumes shared lib + BFF, deploys to Dataverse. Code-review + adr-check mandatory.</rigor-reason>
    <parallel-group>W9-pcf</parallel-group>
    <parallel-safe>true</parallel-safe>
