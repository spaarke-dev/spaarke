  <constraints>
    <constraint source="project">FR-10: rung 2 participant correlation (from/to → matter contacts, project teams, counsel, and `sprk_organization` by sender domain); per-match provenance; direction symmetry.</constraint>
    <constraint source="project">Extend `QueryContactByEmailAsync` to membership + org-by-domain resolution (do not fork it).</constraint>
    <constraint source="project">Confidence band 0.60–0.85 for rung-2 matches.</constraint>
    <constraint source="DEC-3">Org association target MUST be `sprk_organization` (via `sprk_regardingorganization`); NO path may write `account` or OOB `organization` for org association (FR-04).</constraint>
    <constraint source="ADR-024">Write typed regarding lookups + denormalized fields; extend the catalog/map/priority only — no new regarding mechanism.</constraint>
    <constraint source="project">Do NOT implement the confidence→status ladder (task 015). Emit `RungMatch` with confidence + provenance only.</constraint>
    <constraint source="project">Preserve engine contract + task-011 characterization baseline (no regression).</constraint>
    <constraint source="ADR-045">Rung model codified in ADR-045; confirm alignment.</constraint>
