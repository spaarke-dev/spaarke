<task id="013" project="email-communication-solution-r4">
  <metadata>
    <title>Rung 2 — participant correlation (from/to → matter contacts, teams, counsel; `sprk_organization` by sender domain)</title>
    <phase>Wave 1 — Server: enrichment + deterministic engine</phase>
    <status>not-started</status>
    <estimated-hours>8</estimated-hours>
