  </tools>

  <outputs>
    <output type="code">src/client/code-pages/CommunicationPage/src/index.tsx (UPDATED — mounts `&lt;SendEmailPage />` in the email branch)</output>
    <output type="config">Dataverse Form Component Control registration for `sprk_communication` (standard form retained as admin fallback)</output>
