<task id="072" project="email-communication-solution-r4">
  <metadata>
    <title>Outlook add-in — migrate to `@spaarke/auth` `OfficeNaaStrategy` + unified JSON manifest + org-URL fix</title>
    <phase>Wave 7 — Microsoft hardening + auth + index</phase>
    <status>not-started</status>
    <estimated-hours>8</estimated-hours>
