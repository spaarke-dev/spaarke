      <file>src/client/shared/Spaarke.SmartTodo.Components/src/index.ts</file>
    </files>
    <patterns>
      <pattern name="Pattern D structural-only shim" location="src/solutions/LegalWorkspace/src/sections/todo.registration.ts">The proven end-state: shared-lib component is host-agnostic and owns 100% of its own chrome/logic; the LW-side file is structural-only, brokering LW-specific coupling (FeedTodoSyncContext, BroadcastChannel, Xrm.Navigation) via typed props. Apply the same "shim owns coupling, package owns implementation" split for the rich `SmartToDo` consumers.</pattern>
    </patterns>
  </knowledge>

  <steps mode="directional">
    <step order="0" name="Context + rigor declaration">Declare rigor level per CLAUDE.md §8; load ADR-012, ADR-021, spec.md, CLAUDE.md, and `todo.registration.ts` before touching any file.</step>
    <step order="1">Confirm task 002 left `src/solutions/LegalWorkspace/src/components/SmartToDo/` either already-thinned or with the 13 original files still present pending this task's cleanup — reconcile per task 002's step 8 note.</step>
    <step order="2">Rewrite `src/solutions/LegalWorkspace/src/components/SmartToDo/index.ts` to re-export the hoisted symbols from `@spaarke/smart-todo-components` (e.g., `export { SmartToDo, KanbanCard, ... } from '@spaarke/smart-todo-components';`) — OR update `workspaceConfig.tsx`/`App.tsx` to import directly from `@spaarke/smart-todo-components` and remove the LW-local `SmartToDo/` directory entirely, whichever produces the smaller, cleaner diff while satisfying "no duplicated logic."</step>
    <step order="3">Delete the 13 duplicated implementation files from `src/solutions/LegalWorkspace/src/components/SmartToDo/` if not already removed by task 002.</step>
    <step order="4">Update `workspaceConfig.tsx` and `App.tsx` import statements as needed per the step-2 decision; verify prop usage (`webApi`, `userId`, `useDialogForDetail`) still matches the hoisted `SmartToDo` component's prop contract.</step>
    <step order="5">Run LegalWorkspace's build (`npm run build` or equivalent per its `package.json`); fix any resulting type errors.</step>
    <step order="6">Grep the whole repo for `../../../../Spaarke.UI.Components/src/` (should be zero, confirming task 001's fix holds) and for any import of `Spaarke.SmartTodo.Components/src/` from outside that package (should be zero — everything goes through the `@spaarke/smart-todo-components` specifier).</step>
    <step order="7">Manually or via harness-render, verify visual parity: the kanban in both `workspaceConfig.tsx`'s and `App.tsx`'s mount points renders identically to pre-shim behavior.</step>
    <step order="8">Update `projects/smart-todo-r5/tasks/TASK-INDEX.md`: mark 003 status 🔲 → ✅.</step>
    <step order="9">Note in `projects/smart-todo-r5/notes/` that PR #508 is ready to be closed as superseded (actual closure happens at task 090 wrap-up, not here).</step>
  </steps>

  <escalation>
    <trigger>If `workspaceConfig.tsx` or `App.tsx` requires a prop or behavior from the LW-local `SmartToDo` that the hoisted `@spaarke/smart-todo-components` version does not expose (a gap missed by task 002), STOP and escalate per CLAUDE.md §6 — do not patch around it by re-adding local component logic, which would reintroduce the duplication this task exists to eliminate.</trigger>
  </escalation>

  <ui-tests>
    <test name="Visual parity — LegalWorkspace kanban mount points">
      <steps>
        <step>Render `workspaceConfig.tsx`'s SmartToDo mount point before the shim conversion (or against a saved reference) and after.</step>
        <step>Render `App.tsx`'s `&lt;SmartToDo webApi={webApi} userId={userId} useDialogForDetail /&gt;` mount point before and after.</step>
      </steps>
      <expected>Pixel-equivalent kanban rendering, identical interactive behavior (card click, drag, dialog open) in both mount points post-shim.</expected>
    </test>
    <test name="Dark Mode Compliance (ADR-021)">
      <steps>
        <step>Render the shim-consumed kanban in `webLightTheme`.</step>
        <step>Switch to `webDarkTheme`.</step>
      </steps>
      <expected>All colors adapt via semantic tokens with no regression from the pre-shim LW-local rendering.</expected>
    </test>
  </ui-tests>

  <tools>
    <tool name="npm">Build LegalWorkspace + `Spaarke.SmartTodo.Components`</tool>
    <tool name="terminal">Run grep to verify zero relative-path bypasses and zero cross-package reach-ins remain</tool>
  </tools>

  <outputs>
    <output type="code">src/solutions/LegalWorkspace/src/components/SmartToDo/index.ts</output>
