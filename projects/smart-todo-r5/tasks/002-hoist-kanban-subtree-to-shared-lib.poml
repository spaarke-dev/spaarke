    <dependencies>
      <dependency task="001" status="pending">Restores the clean `@spaarke/ui-components/...` package-boundary import pattern this hoist must use for any UI.Components dependency; MUST be complete before this task starts.</dependency>
    </dependencies>
  </context>

  <constraints>
    <constraint source="ADR-012">Scope: hoisted components MUST be host-agnostic — zero import in any moved file may reach into `src/solutions/...` (NFR-05). LW-specific coupling (feed-sync bridge, wizard launch, etc.) stays in the LW shim (task 003), mirroring the `IFeedSyncBridge` pattern already used by `SmartTodoWidget`.</constraint>
    <constraint source="ADR-021">Scope: all visual/styling code carried over in the hoist MUST continue using Fluent v9 semantic tokens exclusively — no hex/rgb literals introduced during the move.</constraint>
    <constraint source="project">Scope: composite score formula/weights in the package's `utils/todoScoring.ts` are UNCHANGED by this task (spec MUST rule) — the hoisted `todoScoringTypes.ts` supplies types only; any scoring math the moved components reference must call into the existing locked `todoScoring.ts`, not a re-implementation.</constraint>
    <constraint source="project">Scope: use the `@spaarke/ui-components/...` import pattern restored by task 001 for every UI.Components dependency in the hoisted files — never the relative-path bypass task 001 removed.</constraint>
  </constraints>

  <knowledge>
    <topic>host-agnostic peer-package hoisting</topic>
    <files>
      <file>.claude/adr/ADR-012-shared-components.md</file>
      <file>.claude/adr/ADR-021-fluent-design-system.md</file>
      <file>projects/smart-todo-r5/spec.md</file>
      <file>projects/smart-todo-r5/CLAUDE.md</file>
      <file>docs/guides/SHARED-UI-COMPONENTS-GUIDE.md</file>
      <file>src/client/shared/CLAUDE.md</file>
