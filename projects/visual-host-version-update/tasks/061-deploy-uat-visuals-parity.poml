<task id="VHVU-061" project="VisualHost Decoupling & @spaarke/visuals Extraction">
  <metadata>
    <title>Deploy + UAT visuals parity on dev</title>
    <status>not-started</status>
    <phase>B4</phase>
    <estimated-effort>2 hours</estimated-effort>
