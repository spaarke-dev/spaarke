  <steps>
    <step id="1">Bump VisualHost version, pack + import to dev.</step>
    <step id="2">Smoke-test every visual type (charts, cards, gauge, calendar, due-date, mini-table) against a configured chart definition.</step>
    <step id="3">Verify dark mode + drill-through/expand.</step>
  </steps>
  <acceptance-criteria>
    <criterion>All visual types render with parity.</criterion>
    <criterion>Dark mode + drill-through unchanged.</criterion>
    <criterion>Owner sign-off recorded.</criterion>
  </acceptance-criteria>
