    <constraint source="ADR-024">Regarding resolution semantics unchanged.</constraint>
  </constraints>
  <knowledge>
    <files>
      <file>src/client/shared/Spaarke.UI.Components/src/components/CreateInvoiceWizard/invoiceService.ts</file>
      <file>src/client/shared/Spaarke.UI.Components/src/services/PolymorphicResolverService.ts</file>
      <file>src/client/shared/Spaarke.UI.Components/src/services/FieldMappingService.ts</file>
    </files>
  </knowledge>
  <steps>
    <step id="1">Launch each wizard page with a host envelope (as VisualHost will) and complete a create.</step>
    <step id="2">Inspect the created record's sprk_regarding* fields + mapped fields.</step>
    <step id="3">Compare against a create done from the standalone page / prior inline path.</step>
