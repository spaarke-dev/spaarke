<task id="VHVU-040" project="VisualHost Decoupling & @spaarke/visuals Extraction">
  <metadata>
    <title>Scaffold @spaarke/visuals sibling package</title>
    <status>complete</status>
    <phase>B1</phase>
    <estimated-effort>2 hours</estimated-effort>
