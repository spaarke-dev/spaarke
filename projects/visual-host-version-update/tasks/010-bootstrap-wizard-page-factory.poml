    <constraint source="ADR-028">Auth exclusively via @spaarke/auth (resolveRuntimeConfig/initAuth/authenticatedFetch). No MSAL/token props.</constraint>
    <constraint source="project">Behavior-preserving for the Event page (no UX change).</constraint>
  </constraints>
