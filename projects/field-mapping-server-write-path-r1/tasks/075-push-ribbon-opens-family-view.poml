<task id="075" project="field-mapping-server-write-path-r1">
  <metadata>
    <title>Push Updates ribbon opens the Family view (code-page dialog hosting RecordFamilyModal) (FR-35)</title>
    <phase>7 W7 Record family service and Family tool</phase>
    <gate>073 complete</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>New code page + ribbon web-resource change.</rigor-reason>
