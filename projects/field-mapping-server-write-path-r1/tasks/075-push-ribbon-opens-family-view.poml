      <file>.claude/skills/ui-test/SKILL.md</file>
    </files>
  </knowledge>

  <steps mode="directional">
    <step order="0">Declare FULL rigor; confirm 073 is merged.</step>
    <step order="1">Scaffold the code page from the chosen reference; render RecordFamilyModal from the dialog data.</step>
    <step order="2">Rewrite pushUpdates to navigateTo the code page with { entityName, id }; remove the direct push and openConfirmDialog.</step>
    <step order="3">Build; run any web-resource tests; record the code page's size.</step>
    <step order="4">Update TASK-INDEX.md to ✅ [done]; notes in notes/task-075-notes.md.</step>
  </steps>

  <justification>
    <existing>sprk_fieldmapping_push.js (button), RecordFamilyModal (073); no code page hosts the modal.</existing>
    <extension>The web resource is extended; a ribbon script cannot render the React modal itself, so a hosting code page is the minimum new surface.</extension>
    <cost-of-doing-nothing>The owner's decision (button opens the Family view) cannot be met; the button keeps pushing without a preview.</cost-of-doing-nothing>
  </justification>

  <outputs>
    <output type="code">src/client/webresources/js/sprk_fieldmapping_push.js</output>
    <output type="code">src/solutions/RecordFamily/src/main.tsx</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">Clicking Push Updates on a Matter or Project opens the dialog showing that record's Family view.</criterion>
    <criterion testable="true">pushUpdates contains no fetch to /field-mappings/push (grep).</criterion>
    <criterion testable="true">The enable rule hasSourceProfile is unchanged.</criterion>
    <criterion testable="true">Closing the dialog refreshes the form, as the wizard dialogs do.</criterion>
  </acceptance-criteria>

  <ui-tests>
    <test name="Ribbon opens Family view">
      <steps><step>Open a Matter; click Push Updates</step><step>Verify the Family dialog opens for that matter; check the console</step></steps>
      <expected>Dialog shows the family; no push request is sent</expected>
    </test>
  </ui-tests>

  <execution><skill>.claude/skills/task-execute/SKILL.md</skill></execution>
