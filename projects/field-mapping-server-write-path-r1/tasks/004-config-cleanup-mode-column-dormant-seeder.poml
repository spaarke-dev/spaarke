<task id="004" project="field-mapping-server-write-path-r1">
  <metadata>
    <title>Profile mode-column reconcile, dormant columns documented, seeder #1318 fix (FR-05 a/b/c)</title>
    <phase>1 W1 Canonical engine and configuration</phase>
    <gate>001 complete</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies .cs in Sprk.Bff.Api, Spaarke.Dataverse and the provisioning seeder; tags include bff-api and provisioning; adds or changes tests at KEEP paths.</rigor-reason>
    <model-tier>sonnet</model-tier>
