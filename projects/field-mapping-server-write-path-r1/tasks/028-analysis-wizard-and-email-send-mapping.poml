<task id="028" project="field-mapping-server-write-path-r1">
  <metadata>
    <title>Migrate Create Analysis wizard and apply analysis-to-email mapping at send (FR-16, FR-17)</title>
    <phase>3 W3 Product creators onto the service</phase>
    <gate>027 complete</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies .tsx in Spaarke.AI.Widgets and .cs in Sprk.Bff.Api; tags include frontend, bff-api, communication, deploy, testing (TEST-MODIFYING override).</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Two scoped changes with explicit semantics (fill-only subject/body); xhigh effort for the cross-surface coordination (PR #1501, PR #2110).</model-tier-reason>
    <effort>xhigh</effort>
    <parallel-group>W3-wizards</parallel-group>
    <parallel-safe>false</parallel-safe>
