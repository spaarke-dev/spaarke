<task id="023" project="field-mapping-server-write-path-r1">
  <metadata>
    <title>Migrate Create Event wizard to the server write path (FR-16)</title>
    <phase>3 W3 Product creators onto the service</phase>
    <gate>022 complete</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies .ts/.tsx in Spaarke.UI.Components; tags include frontend, deploy, testing (TEST-MODIFYING override).</rigor-reason>
