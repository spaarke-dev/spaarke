<task id="011" project="field-mapping-server-write-path-r1">
  <metadata>
    <title>Extract OwnedChildWrite caller checks into CallerWriteAuthorization (pure move) (FR-08 move part)</title>
    <phase>2 W2 Unified RecordCreationService</phase>
    <gate>010 complete</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
