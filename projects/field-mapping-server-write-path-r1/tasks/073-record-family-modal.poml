  <steps mode="directional">
    <step order="0">Declare FULL rigor; read the modal standards and BrowseModal / AccessGrantModal.</step>
    <step order="1">Write component tests first (criteria below) with the fetch double; confirm they fail.</step>
    <step order="2">Implement service + component + export.</step>
    <step order="3">Run the library's lint, typecheck and tests.</step>
    <step order="4">Update TASK-INDEX.md to ✅ [done]; notes in notes/task-073-notes.md.</step>
  </steps>

  <justification>
    <existing>BrowseModal (preset), AccessGrantModal (data modal pattern); no family list exists.</existing>
    <extension>BrowseModal is composed, not copied; AccessGrantModal is a different responsibility (grants).</extension>
    <cost-of-doing-nothing>No user surface lists a record's family or runs family actions (FR-32/FR-33/FR-35 fail).</cost-of-doing-nothing>
  </justification>

  <outputs>
    <output type="code">src/client/shared/Spaarke.UI.Components/src/components/RecordFamilyModal/RecordFamilyModal.tsx</output>
    <output type="code">src/client/shared/Spaarke.UI.Components/src/components/RecordFamilyModal/recordFamilyService.ts</output>
    <output type="test">src/client/shared/Spaarke.UI.Components/src/components/RecordFamilyModal/__tests__/RecordFamilyModal.test.tsx</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">Renders members grouped by level and table with the five owner columns; a null record number renders blank.</criterion>
    <criterion testable="true">truncated=true shows the notice and "Load more", which fetches with the continuation and appends without duplicates.</criterion>
    <criterion testable="true">An action button is disabled with no selection; clicking it passes exactly the selected (table, id) pairs to the handler; nothing runs on open.</criterion>
    <criterion testable="true">With no action handler supplied, the toolbar actions render disabled with the tooltip.</criterion>
    <criterion testable="true">404 and network errors show the fixed error state; no hidden-record count is ever displayed.</criterion>
    <criterion testable="true">Dark mode: no hard-coded colours (lint/token check passes).</criterion>
    <criterion testable="true">Test scope: the behaviours above only.</criterion>
  </acceptance-criteria>

  <ui-tests>
    <test name="Family view renders">
      <steps><step>Open a matter with projects and work assignments; open the Family tool</step><step>Verify grouped rows and columns; check the console for errors</step></steps>
      <expected>Family list renders; no console errors</expected>
    </test>
    <test name="Dark Mode Compliance (ADR-021)">
      <steps><step>Toggle dark mode</step><step>Verify backgrounds, text and icons adapt</step></steps>
      <expected>Fluent v9 semantic tokens only</expected>
    </test>
  </ui-tests>

