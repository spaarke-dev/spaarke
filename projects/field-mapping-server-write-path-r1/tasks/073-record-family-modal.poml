<task id="073" project="field-mapping-server-write-path-r1">
  <metadata>
    <title>RecordFamilyModal in Spaarke.UI.Components on BrowseModal — family list, selection, load more, action toolbar (FR-32)</title>
    <phase>7 W7 Record family service and Family tool</phase>
    <gate>startable (codes against the FR-31 contract; live wiring after 072)</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
