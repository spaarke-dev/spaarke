      <file role="canonical-reference">tests/integration/data-mutation/RecordOwnership/ChatCreatedChildStampTests.cs (~:106 ordinary control; ~:130 sharee-mirror assertion shape)</file>
      <file role="canonical-reference">src/server/api/Sprk.Bff.Api/Services/RecordCreation/RecordCreationService.cs (~:730-777 steps 7 and 10; ResolveOwnerOverAsync ~:1030; OwnerQuestionOf ~:1074) — read only</file>
      <file role="canonical-reference">src/server/api/Sprk.Bff.Api/Services/Dataverse/RecordOwnershipResolver.cs (ForExistingRowAsync ~:437; secure look-through ~:3715, ~:3796) — read only</file>
    </relevant-files>
  </context>

