<task id="062" project="field-mapping-server-write-path-r1">
  <metadata>
    <title>Rewrite field-mapping docs, update registry rows I-3/I-5/I-6, root CLAUDE.md pointers and CHANGELOG (FR-28 docs)</title>
    <phase>6 W6 Standard, guards, docs, retirement</phase>
    <gate>040+053+060 complete</gate>
    <status>not-started</status>
    <rigor>MINIMAL</rigor>
    <rigor-reason>Documentation only; no code or tests changed.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Documentation rewrite from settled decisions and shipped behaviour.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>Edits root CLAUDE.md and .claude/CHANGELOG.md, which sub-agents cannot write: these edits are made by the MAIN SESSION only; also edits the shared DATAVERSE-WRITE-PATH-ARCHITECTURE.md.</parallel-reason>
    <deps>040, 053, 060</deps>
    <tags>docs</tags>
    <estimated-effort>5-7 hours</estimated-effort>
