<task id="090" project="spaarke-auth-v4-dataverse-MI">
  <metadata>
    <title>Project wrap-up</title>
    <phase>9 Wrap-up</phase>
    <gate>all tasks complete</gate>
    <status>not-started</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>Documentation, reporting and gate execution; no production code.</rigor-reason>
    <model-tier>sonnet</model-tier>
