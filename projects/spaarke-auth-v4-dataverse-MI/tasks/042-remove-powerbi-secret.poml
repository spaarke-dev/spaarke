<?xml version="1.0" encoding="UTF-8"?>
<task id="042" project="spaarke-auth-v4-dataverse-MI">
  <metadata>
    <title>Remove PowerBi:ClientSecret (FR-D3)</title>
    <phase>4 Power BI</phase>
    <gate>041 verified</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>auth tag; irreversible credential removal.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Bounded removal with an exact target.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>true</parallel-safe>
    <deps>041</deps>
    <tags>auth,powerbi,cleanup</tags>
    <estimated-effort>2-3 hours</estimated-effort>
  </metadata>

  <prompt>Remove PowerBi:ClientSecret from configuration, Key Vault and its validator, now that Power BI authenticates as a managed identity. This is a genuinely separate secret from BFF-API-ClientSecret.</prompt>
  <role>SPAARKE platform developer.</role>
  <goal>No Power BI code path resolves a client secret, and reporting still works.</goal>

  <context>
    <background>PowerBiOptions.cs:44-45 carries a distinct service-principal secret — CREDENTIAL-INVENTORY §4 confirms it is separate from BFF-API-ClientSecret, and which SP owns it was previously undocumented.</background>
    <relevant-files>
      <file role="modify">src/server/api/Sprk.Bff.Api/Configuration/PowerBiOptions.cs</file>
      <file role="canonical-reference">projects/spaarke-auth-v4-dataverse-MI/notes/decisions/040-powerbi-profiles-verification.md</file>
    </relevant-files>
    <dependencies><dependency task="041" status="pending">Power BI verified working on the managed identity</dependency></dependencies>
  </context>

  <constraints>
    <constraint source="project">Scope: PowerBi:ClientSecret only. Do NOT touch BFF-API-ClientSecret (task 033) or SpeAdmin per-customer secrets (E-1).</constraint>
    <constraint source="project">Scope: remove from app settings first, verify, then Key Vault.</constraint>
    <constraint source="project">Scope: document which service principal owned it before deleting — the mapping was previously undocumented and the record is worth preserving.</constraint>
  </constraints>

  <knowledge>
    <topic>Secret retirement, Power BI configuration</topic>
    <files>
      <file>.claude/adr/ADR-028-spaarke-auth-architecture.md</file>
      <file>projects/spaarke-auth-v4-dataverse-MI/notes/CREDENTIAL-INVENTORY.md</file>
    </files>
  </knowledge>

  <steps mode="prescriptive">
    <step>Record which service principal owns the secret before removal.</step>
    <step>Remove from app settings; verify reporting still works.</step>
    <step>Remove from Key Vault.</step>
    <step>Relax the PowerBiOptions validator so the secret is no longer required.</step>
    <step>Sweep docs for instructions to create it.</step>
  </steps>

  <escalation>
    <trigger>Another consumer of PowerBi:ClientSecret is found outside the reporting services — STOP and re-inventory.</trigger>
  </escalation>

  <outputs>
    <output type="modify">src/server/api/Sprk.Bff.Api/Configuration/PowerBiOptions.cs</output>
    <output type="doc">projects/spaarke-auth-v4-dataverse-MI/notes/decisions/042-powerbi-secret-removal.md</output>
  </outputs>

  <acceptance-criteria>
    <criterion>No Power BI code path resolves a client secret.</criterion>
    <criterion>Reporting endpoints still return unchanged payloads.</criterion>
    <criterion>The owning service principal is recorded before deletion.</criterion>
    <criterion>Negative case: BFF-API-ClientSecret and SpeAdmin E-1 secrets are demonstrably untouched.</criterion>
    <criterion>The validator no longer requires the secret; the BFF starts without it.</criterion>
  </acceptance-criteria>
</task>
