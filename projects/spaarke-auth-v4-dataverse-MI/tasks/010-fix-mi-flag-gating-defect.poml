<task id="010" project="spaarke-auth-v4-dataverse-MI">
  <metadata>
    <title>Fix the MI-flag gating defect (FR-A1)</title>
    <phase>1 Prerequisites</phase>
    <gate>003 complete</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>auth tag, modifies .cs in a shared lib consumed by BFF.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Well-specified defect with an exact fix and a closed test matrix.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>A</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>CORRECTED 2026-08-20: NOT parallel-safe. Task 011 also modifies src/server/shared/Spaarke.Dataverse/DataverseAccessDataSource.cs. Dispatching both as concurrent sub-agents would collide on that file. Run 010 then 011 sequentially -- 011's CCA caching builds on the branch structure 010 corrects.</parallel-reason>
    <deps>003</deps>
    <tags>auth,bff-api,dataverse,bugfix</tags>
    <estimated-effort>2-4 hours</estimated-effort>
