<task id="052" project="spaarkeai-compose-r2">
  <metadata>
    <title>FR-26 SPE webhook subscription + BackgroundService renewal + delta query</title>
    <phase>5 Word</phase>
    <gate>startable</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <model-tier>opus</model-tier>
