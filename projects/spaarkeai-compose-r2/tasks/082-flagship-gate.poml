<task id="082" project="spaarkeai-compose-r2">
  <metadata>
    <title>Flagship gate G-R2-C — browser-verified full chain on spaarkedev1</title>
    <phase>8 Wrap</phase>
    <gate>blocked-on-core-A0</gate>
    <status>blocked</status>
    <rigor>FULL</rigor>
    <model-tier>opus</model-tier>
    <effort>high</effort>
    <parallel-group>terminal</parallel-group>
    <parallel-safe>false</parallel-safe>
