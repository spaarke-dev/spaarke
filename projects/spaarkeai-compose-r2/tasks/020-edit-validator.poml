<task id="020" project="spaarkeai-compose-r2">
  <metadata>
    <title>FR-19 IComposeEditValidator + POST /edit-batch/validate</title>
    <phase>2 LLM Editing Patterns</phase>
    <gate>green</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <model-tier>sonnet</model-tier>
    <effort>xhigh</effort>
    <parallel-group>phase2-llm</parallel-group>
    <parallel-safe>true</parallel-safe>
    <deps>002</deps>
