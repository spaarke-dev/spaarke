<task id="055" project="spaarkeai-compose-r2">
  <metadata>
    <title>FR-28 push/save deterministic path (gate dialog + OutcomeCard = splittable)</title>
    <phase>5 Word</phase>
    <gate>splittable</gate>
    <status>in-progress</status>
    <rigor>FULL</rigor>
    <model-tier>sonnet</model-tier>
    <effort>high</effort>
    <parallel-group>W3-Word</parallel-group>
    <parallel-safe>false</parallel-safe>
    <deps>050</deps>
    <tags>bff-api,api,spe,docx</tags>
