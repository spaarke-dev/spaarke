    <patterns>
      <pattern name="Writer/reader DTO symmetry" location="src/server/api/Sprk.Bff.Api/Services/Compose/DocxAnnotationWriter.cs">
        Mirror the annotation DTO the writer consumes so a push→pull round-trip is structurally lossless where OOXML allows.
      </pattern>
      <pattern name="Compose endpoint group" location="src/server/api/Sprk.Bff.Api/Api/ComposeEndpoints.cs">
        Add the route to the existing `/api/compose` group following the established `.WithName/.Produces` convention.
      </pattern>
    </patterns>
  </knowledge>

  <steps mode="directional">
    <step order="0" name="Context + dependency check">Confirm Spike 6 (006) notes available; declare FULL rigor; load knowledge files.</step>
    <step order="1" name="Define the read payload">Design the structured output: comments (id, author, date, anchored range text) + revisions (type ins/del, author, date, text, position hint). Align with task 050's writer DTO and task 054's re-anchoring input.</step>
    <step order="2" name="Implement DocxAnnotationReader">Parse `&lt;w:comment&gt;` + `CommentRangeStart/End`, `&lt;w:ins&gt;`/`InsertedRun`, `&lt;w:del&gt;`/`DeletedRun`/`DeletedText` with author/date/id. Handle documents with zero annotations gracefully. Carry `// EDGE-N:` notes for any Spike-6-surfaced parse quirks.</step>
    <step order="3" name="Wire the pull-annotations endpoint">Add `POST /api/compose/document/{spe-id}/pull-annotations`: download current bytes via facade, run reader, return the structured payload.</step>
    <step order="4" name="Unit tests">`DocxAnnotationReaderTests`: parse a Word-authored comment + track-change → correct author/date; empty-document → empty payload; malformed DOCX → 400. Mock at facade boundary.</step>
    <step order="5" name="Verify">Build + tests; publish-size/CVE report; NetArchTest facade check; update TASK-INDEX.</step>
  </steps>

  <outputs>
    <output type="code">src/server/api/Sprk.Bff.Api/Services/Compose/DocxAnnotationReader.cs</output>
    <output type="code">src/server/api/Sprk.Bff.Api/Api/ComposeEndpoints.cs (pull-annotations route added)</output>
    <output type="test">tests/unit/Sprk.Bff.Api.Tests/Services/Compose/DocxAnnotationReaderTests.cs</output>
