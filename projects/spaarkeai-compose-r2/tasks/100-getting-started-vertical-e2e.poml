    <rigor-hint reason="Foundational cross-toolchain wiring on the flagship entry path; 8 individually-fatal breaks + the anti-recurrence test; FULL, unconditional Step 9.5">FULL</rigor-hint>
    <model-tier reason="Cross-toolchain (client BU resolution + wire DTO + reducer + endpoint + service), high blast radius on the flagship create-on-save leg, ADR-007/005/013 surface">opus</model-tier>
    <parallel-group>e2e-remediation-serial</parallel-group>
