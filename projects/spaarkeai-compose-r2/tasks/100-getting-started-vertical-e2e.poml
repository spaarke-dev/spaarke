<task id="100" project="spaarkeai-compose-r2">
  <metadata>
    <title>E2E-R1 — Getting-started vertical: upload/search → load → Save → persisted sprk_document (Cluster 1)</title>
    <phase>9 E2E Remediation</phase>
    <status>in-progress</status>
