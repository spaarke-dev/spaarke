<task id="011" project="spaarkeai-compose-r2">
  <metadata>
    <title>FR-02 wire 1a "Search for Document" -&gt; reuse 1c load path</title>
    <phase>1 Entry</phase>
    <status>not-started</status>
    <estimated-hours>12</estimated-hours>
    <effort>high</effort>
    <dependencies>none</dependencies>
