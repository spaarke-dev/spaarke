    <tags>frontend</tags>
    <rigor-hint reason="Modifies .tsx; user-visible entry path; FULL per TASK-INDEX">FULL</rigor-hint>
    <model-tier reason="Frontend wiring reusing the proven 1c load path; no new backend surface">sonnet</model-tier>
    <parallel-group>W2</parallel-group>
