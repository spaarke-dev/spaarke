    </files>
  </knowledge>

  <steps mode="directional">
    <step order="0" name="Context + load">Load this task, project CLAUDE.md, and the knowledge files.</step>
    <step order="1" name="Build appendix generator">Prototype a SemanticAppendixGenerator that extracts defined terms, cross-references, and structural metadata from a sample document into an appendix payload.</step>
    <step order="2" name="Design A/B harness">Assemble a fixed set of document questions/edits; run each WITH and WITHOUT the appendix in the scope payload.</step>
    <step order="3" name="Measure delta">Score hallucination/grounding for each arm and compute the delta.</step>
    <step order="4" name="Write spike note">Record the measured delta + the appendix content format for FR-22.</step>
  </steps>

  <outputs>
