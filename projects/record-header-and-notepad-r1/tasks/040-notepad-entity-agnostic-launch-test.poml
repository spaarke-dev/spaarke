<task id="040" project="record-header-and-notepad-r1">
  <metadata>
    <title>Entity-agnostic launch test (FR-19)</title>
    <phase>3: Notepad</phase>
    <status>not-started</status>
    <estimated-hours>2</estimated-hours>
    <dependencies>039</dependencies>
    <blocks>050</blocks>
