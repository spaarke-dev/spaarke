<task id="011" project="record-header-and-notepad-r1">
  <metadata>
    <title>Author toolbarLaunchDefaults constants module</title>
    <phase>1: Shared Library</phase>
    <status>not-started</status>
    <estimated-hours>1</estimated-hours>
    <dependencies>none</dependencies>
