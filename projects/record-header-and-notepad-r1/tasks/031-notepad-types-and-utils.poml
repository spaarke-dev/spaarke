  <prompt>Author src/solutions/Notepad/src/types/memo.ts (TypeScript types for Memo, derived from sprk_memo schema verified in 001) and src/solutions/Notepad/src/utils/deriveTitle.ts (pure function returning first non-empty line of body, truncated to ~60 chars).</prompt>

  <role>Spaarke platform developer.</role>

  <goal>types/memo.ts + utils/deriveTitle.ts present; unit tests for deriveTitle cover edge cases (empty, whitespace-only, long text, multiline).</goal>

  <context>
    <background>Small foundation task. Types mirror sprk_memo fields verified in 001. deriveTitle is used by MemoList (dropdown display) per FR-16.</background>
    <relevant-files>
      <file>src/solutions/Notepad/src/types/memo.ts</file>
      <file>src/solutions/Notepad/src/utils/deriveTitle.ts</file>
      <file>src/solutions/Notepad/src/utils/__tests__/deriveTitle.test.ts</file>
    </relevant-files>
  </context>

  <constraints>
    <constraint source="ADR-024">sprk_memo uses text field sprk_regardingrecordid.</constraint>
    <constraint source="spec">FR-16: derived-title preview for memo list.</constraint>
  </constraints>

  <knowledge>
    <files>
      <file>projects/record-header-and-notepad-r1/spec.md</file>
