  <steps>
    <step order="1">Author types/memo.ts: interface Memo { sprk_memoid: string; sprk_body: string; sprk_regardingrecordid: string; createdby: { id: string; name: string; }; createdon: string; modifiedon: string; }</step>
    <step order="2">Author utils/deriveTitle.ts: export function deriveTitle(body: string | null | undefined, maxLen: number = 60): string — first non-empty line, trimmed, truncated to maxLen with "…"; return "Untitled" if empty.</step>
    <step order="3">Add unit tests: empty → "Untitled"; whitespace-only → "Untitled"; single line ≤ maxLen → line itself; single line &gt; maxLen → truncated + "…"; multiline → first non-empty line.</step>
    <step order="4">Run tests.</step>
    <step order="5">Update TASK-INDEX.md: mark 031 ✅.</step>
    <step order="6">Document deviations in notes/.</step>
  </steps>

  <tools><tool name="npm">Build + test</tool></tools>

  <outputs>
    <output type="code">src/solutions/Notepad/src/types/memo.ts</output>
    <output type="code">src/solutions/Notepad/src/utils/deriveTitle.ts</output>
    <output type="test">src/solutions/Notepad/src/utils/__tests__/deriveTitle.test.ts</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">deriveTitle("") === "Untitled".</criterion>
    <criterion testable="true">deriveTitle("First line\nSecond line") === "First line".</criterion>
    <criterion testable="true">deriveTitle(long string) truncates and appends "…".</criterion>
  </acceptance-criteria>

  <notes>Types must match schema verified in 001. If 001 reveals field-name differences (e.g. spk_body vs sprk_body), update types accordingly.</notes>

