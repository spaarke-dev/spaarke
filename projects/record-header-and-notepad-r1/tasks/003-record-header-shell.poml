  <ui-tests>
    <test name="Dark Mode Compliance (ADR-021)">
      <steps>
        <step>Render RecordHeaderShell with a mock toolbar and body</step>
        <step>Toggle theme from webLightTheme to webDarkTheme</step>
        <step>Verify card background, border, and skeleton colors adapt</step>
      </steps>
      <expected>All colors adapt via semantic tokens; zero hardcoded values</expected>
    </test>
  </ui-tests>

  <notes>Card padding: spacingHorizontalM + spacingVerticalS per Fluent v9 defaults. Consumer supplies IHeaderToolbarProps directly; do NOT re-transform the props.</notes>

