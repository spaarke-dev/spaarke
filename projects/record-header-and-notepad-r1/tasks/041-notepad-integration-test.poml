  <steps>
    <step order="1">Set up mock Xrm.WebApi: retrieveMultipleRecords returns 2 memos initially; createRecord returns a new id; updateRecord succeeds.</step>
    <step order="2">Render NotepadShell with URL params (regardingEntity + regardingId).</step>
    <step order="3">Verify: first memo loaded in editor (most-recent per FR-14).</step>
    <step order="4">Click `+`: verify createRecord invoked; new memo becomes current.</step>
    <step order="5">Type in editor; advance clock 1s; verify debounced updateRecord called once.</step>
    <step order="6">Ctrl+Enter with new content; verify immediate updateRecord.</step>
    <step order="7">Blur editor; verify updateRecord.</step>
    <step order="8">Open list; select the other memo; verify editor switches; verify pending debounce flushed.</step>
    <step order="9">Click info icon; verify Popover renders createdby + createdon.</step>
    <step order="10">Run tests.</step>
    <step order="11">Update TASK-INDEX.md: mark 041 ✅.</step>
    <step order="12">Document deviations in notes/.</step>
  </steps>

  <tools><tool name="npm">Test</tool></tools>

  <outputs>
    <output type="test">src/solutions/Notepad/src/__integration__/notepad.integration.test.tsx</output>
