<task id="024" project="record-header-and-notepad-r1">
  <metadata>
    <title>Build MatterHeaderPcf + verify bundle size + PCF LOC</title>
    <phase>2: MatterHeaderPcf</phase>
    <status>completed</status>
    <estimated-hours>1</estimated-hours>
    <dependencies>023</dependencies>
    <blocks>025</blocks>
    <tags>pcf, deploy, testing</tags>
