      <file role="new">tests/integration/contract/Api/Finance/InvoiceApprovalEndpointsAuthorizationContractTests.cs</file>
    </relevant-files>
    <dependencies>
      <dependency task="100" status="pending">Route conventions, policy key "ebilling.invoice.decide", line statuses</dependency>
      <dependency task="021" status="pending">sprk_invoiceapproval and the eligible-approver N:N</dependency>
      <dependency task="024" status="pending">sprk_billingapproverrole columns (names in its notes)</dependency>
      <dependency task="025" status="pending">Settings default approver roles</dependency>
