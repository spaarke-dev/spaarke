      <file role="modify">projects/INDEX.md (ebilling-r1 row)</file>
      <file role="modify">tests/** (only test-diet required actions and F-class fixes)</file>
      <file role="read">projects/ebilling-r1/notes/uat-results.md</file>
    </relevant-files>
    <dependencies>
      <dependency task="all" status="pending">Every other task in TASK-INDEX.md is ✅</dependency>
    </dependencies>
  </context>

  <constraints>
    <constraint source="ISS-009 (task 043)">Merge gate: every BFF environment token set defines CONTENT_UNDERSTANDING_ENDPOINT (empty where eBilling is not deployed) before this branch reaches master.</constraint>
    <constraint source="root CLAUDE.md section 7, ADR-038">/test-diet runs before close; its required actions (scaffolding deletions with same-PR replacement rule, KEEP-path moves) are applied, not just reported.</constraint>
    <constraint source="root CLAUDE.md section 8.5">Every F-class finding from code-review and adr-check is fixed and re-checked on the fix diff; a known-limit class never holds a confirmed defect. Findings in other projects' code are filed and reported.</constraint>
    <constraint source="root CLAUDE.md section 3">Edits under .claude/ (FAILURE-MODES.md, patterns, constraints) are proposed in notes and applied by the main session, never by a sub-agent.</constraint>
    <constraint source="task-create Step 3.7">Do not rename or move the project folder (no x- prefix); devops-project-archive writes projects/ebilling-r1/.archived.</constraint>
    <constraint source="NFR-12, .claude/constraints/bff-extensions.md">Cumulative publish-size delta of the branch against a fresh master build, reported with and without Azure.AI.ContentUnderstanding; no new HIGH CVE; no npm package added (git diff of package.json files).</constraint>
    <constraint source="project">Never delete the owner-created containers or the evaluation-set source documents; repo-cleanup removes only ephemeral notes (debug, drafts, spikes harness only if 161 / 162 no longer need it).</constraint>
  </constraints>

  <knowledge>
    <files>
