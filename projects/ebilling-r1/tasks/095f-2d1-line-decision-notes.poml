<?xml version="1.0" encoding="UTF-8"?>
<task id="095f-2d1" project="ebilling-r1">
  <metadata>
    <title>Decision notes, part 2d-1: accept, reduce and disallow line notes (one Decision Record per line, D-75); Accepted in bulk carries none</title>
    <phase>5 Partner surfaces — 095f part 2 (EB-D-236)</phase>
    <gate>095f-2a merged into work (the shared codes). Branch from work/ebilling-r1 at the sha named in the agent brief.</gate>
    <status>open</status>
    <rigor>FULL</rigor>
    <rigor-reason>BFF C# on the line decision service and routes.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <effort>high</effort>
    <parallel-safe>false</parallel-safe>
    <deps>095f-2a</deps>
    <tags>bff-api, decision-record, testing</tags>
    <estimated-effort>0.5-1 day</estimated-effort>
  </metadata>

  <prompt>Build design §5.1: SingleLineDecisionRequest and MultiLineDecisionRequest gain Note; LineDecisionCommand gains Note checked next to the reason checks; BuildDecision adds Values["note"] when given; one note goes on every line's record of a multi-line call. AcceptCleanRequest and the approval's bulk accept carry no note. Line notes never touch any invoice column. Declare note optional on accept-line, reduce-line and disallow-line (ontology-r1 light).</prompt>

  <goal>Every individual line decision can carry a short note on its own Decision Record; bulk acceptance never does.</goal>

  <constraints>
    <constraint source="design 1.1, 1.2">Validation and no-null-key rules of 2a; the shared 400 codes.</constraint>
    <constraint source="design 5.1">Must-not-fire: accept-clean and the approval's bulk records carry no note (even when the approval has one); no line decision writes sprk_decisionnote or sprk_correctionnote.</constraint>
    <constraint source="project">No live call. Never run python. Never --no-verify. No bare git stash.</constraint>
  </constraints>

  <acceptance-criteria>
    <criterion testable="true">One note goes onto N records in a multi-line call; no note means no key and a byte-identical hash.</criterion>
    <criterion testable="true">The three must-not-fire checks above pass; the validation set of 2a.</criterion>
    <criterion testable="true">BFF build --warnaserror 0 warnings; line decision and approval suites green; ArchTests green.</criterion>
  </acceptance-criteria>

  <execution>
    <skill>.claude/skills/task-execute/SKILL.md</skill>
    <protocol>Load the knowledge files first. Follow task-execute for rigor, checkpoints and quality gates.</protocol>
  </execution>
</task>
