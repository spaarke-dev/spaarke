<?xml version="1.0" encoding="UTF-8"?>
<task id="084h-4" project="ebilling-r1">
  <metadata>
    <title>RecordProcedures UI: an optional Note box on each change, and the NotRecorded warning</title>
    <phase>3 Rules (WP3) — Procedures on the record (EB-D-238, EB-D-239)</phase>
    <gate>084h-2 merged into work (the request and response shapes). Branch from work/ebilling-r1 at the sha named in the agent brief.</gate>
    <status>open</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>Client-only change to one code page; no server change.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <effort>high</effort>
    <parallel-safe>true</parallel-safe>
    <deps>084h-2</deps>
    <tags>react, fluent-ui, frontend, testing</tags>
    <estimated-effort>0.5 day</estimated-effort>
  </metadata>

  <prompt>In src/solutions/RecordProcedures: add one optional "Note" box on the confirm step of each wizard plan (assign, pin, unpin, exclude, rule exclude, change, remove), sent as note on the POST bodies and as a JSON body { "note" } on the DELETE; and show a warning bar when a response's decisionRecord.status is NotRecorded ("The change was saved, but its decision record could not be written. Tell your administrator."). Queued shows no warning: the server retries it (084h-3).</prompt>

  <goal>A user can add a note to any per-record Procedure change, and sees a warning only when the change saved but its Decision Record could not be queued.</goal>

  <constraints>
    <constraint source="design 9">The note is optional; maxLength from MAX_REASON_CHARS (plan.ts:76, 2000); empty or whitespace-only is sent as absent, never as null or "".</constraint>
    <constraint source="design 2">A Pin-to-Follow plan (remove then create) sends the same note on both calls.</constraint>
    <constraint source="ADR-021">Fluent v9 components and tokens; dark mode works.</constraint>
    <constraint source="project">Only src/solutions/RecordProcedures/** and its tests. No shared-library change. No deploy (084h-5 / 112).</constraint>
  </constraints>

  <acceptance-criteria>
    <criterion testable="true">Jest: each plan step sends note when typed and omits the key when blank; the DELETE sends a JSON body only when a note is given; 2000 characters is the input limit.</criterion>
    <criterion testable="true">Jest: decisionRecord.status NotRecorded shows the warning bar; Queued and Recorded show none (must-not-fire); a response with no decisionRecord member shows none.</criterion>
    <criterion testable="true">The existing RecordProcedures jest suites stay green; npm run build succeeds.</criterion>
  </acceptance-criteria>

  <execution>
    <skill>.claude/skills/task-execute/SKILL.md</skill>
    <protocol>Load the knowledge files first. Follow task-execute for rigor, checkpoints and quality gates.</protocol>
  </execution>
</task>
