      <file role="modify">src/server/api/Sprk.Bff.Api/Infrastructure/DI/EndpointMappingExtensions.cs:376-377 (shared append point)</file>
      <file role="new">tests/unit/Sprk.Bff.Api.Tests/Services/Finance/InvoiceRejectReturnServiceTests.cs</file>
      <file role="new">tests/integration/contract/Api/Finance/InvoiceRejectReturnEndpointsAuthorizationContractTests.cs</file>
