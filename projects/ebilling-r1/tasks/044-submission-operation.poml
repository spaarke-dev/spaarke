      <file role="new">tests/integration/contract/Api/Finance/InvoiceSubmissionEndpointsContractTests.cs and tests/unit/Sprk.Bff.Api.Tests/Services/Finance/Submission/InvoiceSubmissionServiceTests.cs</file>
