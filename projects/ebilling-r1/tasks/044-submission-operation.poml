    <dependencies>
      <dependency task="013" status="required">One-lookup guard and core-ancestor derivation for sprk_invoicesubmission.</dependency>
      <dependency task="040" status="required">EbillingOptions (MaxSubmissionFileSizeMb) and RequireEbillingEnabled().</dependency>
      <dependency task="045" status="required">Tracking-number allocator.</dependency>
      <dependency task="029" status="required">sprk_invoicesubmission and the Invoice document type live in dev and solution source.</dependency>
