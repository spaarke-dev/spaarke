<task id="043" project="ebilling-r1">
  <metadata>
    <title>Content Understanding client and ReadInvoiceAsync</title>
    <phase>2 Submission and extraction (WP2)</phase>
    <gate>startable</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Adds the project's only new NuGet package (NFR-12), a new external AI dependency with managed-identity auth, and the typed extraction contract every later step reads.</rigor-reason>
    <model-tier>opus</model-tier>
    <model-tier-reason>New SDK integration whose result mapping (confidence, page, bounding box, large documents) shapes evaluation, review and rejection decisions.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>P2-B</parallel-group>
    <parallel-safe>true</parallel-safe>
