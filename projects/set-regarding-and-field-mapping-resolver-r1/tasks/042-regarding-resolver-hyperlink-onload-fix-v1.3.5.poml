    <step order="5" name="Version bump — Location 2 (index.ts CONTROL_VERSION)">Update `CONTROL_VERSION = '1.3.5'`.</step>
    <step order="6" name="Version bump — Location 3 (BUILD_DATE)">Confirm `BUILD_DATE = '2026-07-03'`.</step>
    <step order="7" name="Version bump — Location 4 (Solution manifest)">Update `Solution/solution.xml` `&lt;Version&gt;` to `1.3.5`.</step>
