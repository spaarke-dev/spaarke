<task id="SRFR-023" project="set-regarding-and-field-mapping-resolver-r1">
  <metadata>
    <title>Extend EntityLookupConfig interface with regardingRecordNumberField property</title>
    <status>completed</status>
    <estimated-effort>1h</estimated-effort>
    <actual-effort>~30min</actual-effort>
    <assigned>AI Agent</assigned>
    <started>2026-07-02</started>
    <completed>2026-07-02</completed>
    <rigor>FULL</rigor>
    <parallel-safe>true</parallel-safe>
    <parallel-group>A</parallel-group>
    <tags>shared-lib,interface,refactor,wave-2</tags>
