      <file role="new">infra/dataverse/inputschemas/agreement-edit-plan.input.schema.json</file>
      <file role="new">tests/integration/seam/Intake/AgreementAiEditPlanSeamTests.cs</file>
      <file role="modify">src/server/api/Sprk.Bff.Api/Services/Ai/PublicContracts/ConsumerTypes.cs (add AgreementEditPlan + All entry; `All` at :416)</file>
      <file role="modify">src/server/api/Sprk.Bff.Api/Infrastructure/DI/AnalysisServicesModule.cs (Null peer near :611, real near :1419 AddPublicContractsFacade)</file>
      <file role="modify">infra/dataverse/sprk_playbookconsumer-rows.json (new Binding row)</file>
      <file role="canonical-reference">src/server/api/Sprk.Bff.Api/Services/Ai/PublicContracts/IInvoiceAi.cs:27, InvoiceAi.cs:30, NullInvoiceAi.cs</file>
