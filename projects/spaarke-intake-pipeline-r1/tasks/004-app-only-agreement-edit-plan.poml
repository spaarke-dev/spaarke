      <file role="canonical-reference">src/accelerators/core/schemas/edit-plan.schema.json, src/accelerators/practices/nda/topics.yaml, src/accelerators/practices/nda/evals/corpus/*.docx (on master after #3163; confirmed only in the accelerator worktree)</file>
    </relevant-files>
    <dependencies>
      <dependency task="005" status="pending">Lands the `AgreementClassify` / `NdaReview` / `NdaStandardSummary` constants in ConsumerTypes.cs (shared file).</dependency>
      <dependency task="external-#3163" status="pending">Schema, topics and synthetic corpus on master.</dependency>
    </dependencies>
  </context>

  <constraints>
    <constraint source="ADR-013">Scope: every AI call added in this task. AI is reached only through the new `IAgreementAi` facade; no non-AI module injects `IActionRunner`/`IActionResolver` directly.</constraint>
    <constraint source="ADR-039">Scope: the new Action. It is catalogued (action JSON + Binding row + `ConsumerTypes.AgreementEditPlan` in `All`) in the same change; `/healthz/catalog` (RoutingConsumerTypeHealthCheck) reports no drift.</constraint>
    <constraint source="ADR-032">Scope: DI. `NullAgreementAi` is registered unconditionally and the real `AgreementAi` replaces it only where `InvoiceAi` does (AddPublicContractsFacade); the Null peer fails fast with a typed exception, never returns a fake plan.</constraint>
    <constraint source="ADR-015">Scope: AgreementAi logs and exceptions. Consumer type, reason code, exception type and ids only; no document text, clause text or plan content.</constraint>
    <constraint source="ADR-010">Scope: DI registrations added. Register the interface only because it is a real seam (Null peer); no other new interfaces.</constraint>
    <constraint source="project">Scope: agreement-review and agreement-classify Actions and their Bindings. Unchanged by this task (Console consumers depend on them).</constraint>
    <constraint source="project">Scope: all tests and fixtures. Synthetic corpus only (`nda-01/02/03`, `msa-01`); never the accelerator `answer-key/` or a real NDA (NFR-10). Topic ids and the standard version come from the pinned `topics.yaml` / "Spaarke NDA – Mutual" v1.2 (NFR-09).</constraint>
    <constraint source="bff-extensions">Scope: the PR for this task. State the Placement Justification (`.claude/constraints/bff-extensions.md`), measure the publish-size delta against a fresh master build, keep total ≤ 60 MB, and add no package (JsonSchema.Net is already referenced) and no new HIGH CVE.</constraint>
  </constraints>

