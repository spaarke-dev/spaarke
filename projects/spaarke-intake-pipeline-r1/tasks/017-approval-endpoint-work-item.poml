      <pattern name="Endpoint filters" location=".claude/patterns/api/endpoint-filters.md">Authorization filter shape.</pattern>
      <pattern name="Auth" location=".claude/patterns/auth/spaarke-sso-binding.md">Caller identity (OBO principal) on BFF routes.</pattern>
      <pattern name="Access control" location=".claude/patterns/auth/uac-access-control.md">Fail-closed reads.</pattern>
