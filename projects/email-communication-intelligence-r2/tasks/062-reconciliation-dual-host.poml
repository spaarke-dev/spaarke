<task id="062" project="email-communication-intelligence-r2">
  <metadata>
    <title>Dual host — CommunicationReconciliation code page (sprk_communicationreconciliation) + SpaarkeAi widget mounting ReconciliationWorkspace</title>
    <phase>5 Pillar E — Reconciliation UI (mount build)</phase>
    <gate>blocked: 061 (ReconciliationWorkspace)</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Creates a new Vite code page + a SpaarkeAi widget registration (.ts/.tsx); real auth + IDataverseClient + BFF wiring; touches the shared SpaarkeAi surface.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Hosting/wiring following explicit references (EmailPage code page + the SpaarkeAi widget-registry pattern); no architectural novelty. Mounts the single ReconciliationWorkspace unchanged.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>Touches the shared SpaarkeAi code page (hot-path) + creates a new code page; sequential; /conflict-check before PR.</parallel-reason>
    <deps>061</deps>
    <tags>react, typescript, frontend, fluent-ui, code-page, spaarke-ai</tags>
    <estimated-effort>3-5 hours</estimated-effort>
