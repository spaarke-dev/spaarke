<task id="029" project="email-communication-intelligence-r2">
  <metadata>
    <title>sprk_document.sprk_linkedcommunication lookup (FR-C4 cross-path reconciliation) — GATED schema</title>
    <phase>2 Pillar C — De-duplication</phase>
    <gate>operator-go-ahead</gate>
    <status>completed</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>One new lookup column via dataverse-create-schema; no .cs change (the consuming code shipped in task 025). STANDARD per task-create Step 3.5.5.</rigor-reason>
    <model-tier>sonnet</model-tier>
