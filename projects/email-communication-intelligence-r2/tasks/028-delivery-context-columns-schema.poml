  <metadata>
    <title>sprk_communication.sprk_deliveredmailboxes + sprk_savedbyusers memo columns (FR-C2 context-merge) — GATED schema</title>
    <phase>2 Pillar C — De-duplication</phase>
    <gate>operator-go-ahead</gate>
