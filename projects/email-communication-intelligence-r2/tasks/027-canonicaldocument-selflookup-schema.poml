<task id="027" project="email-communication-intelligence-r2">
  <metadata>
    <title>sprk_document.sprk_canonicaldocument self-lookup (FR-C3 graduate-on-divergence) — GATED schema</title>
    <phase>2 Pillar C — De-duplication</phase>
    <gate>operator-go-ahead</gate>
    <status>not-started</status>
    <rigor>STANDARD</rigor>
