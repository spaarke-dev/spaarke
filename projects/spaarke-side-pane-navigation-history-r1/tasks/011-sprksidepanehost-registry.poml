<task id="011" project="spaarke-side-pane-navigation-history-r1">
  <metadata>
    <title>SprkSidePaneHost + sidePaneRegistry — reusable docked side-pane framework</title>
    <phase>1 Framework</phase>
    <gate>blocked</gate>
