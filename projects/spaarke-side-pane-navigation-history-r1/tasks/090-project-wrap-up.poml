    </relevant-files>
    <dependencies>
      <dependency task="087" status="pending">UI test pass complete — the last verification gate before close-out (and all prior tasks complete).</dependency>
    </dependencies>
  </context>
  <constraints>
    <constraint source="project">Wrap-up MUST NOT run if any non-deferred task is incomplete — report the incomplete task(s) instead of closing out (root CLAUDE.md §7).</constraint>
    <constraint source="project">/test-diet is read-only: it emits git rm / git mv suggestions for the reviewer and writes notes/test-diet-report.md; it does not auto-delete tests (ADR-038 build-vs-maintain).</constraint>
    <constraint source="project">Every spec Success Criterion MUST be mapped to concrete evidence in success-criteria-verification.md.</constraint>
  </constraints>
  <knowledge>
    <topic>Project close-out (README status, lessons-learned, test-diet reconciliation, success-criteria evidence, archive)</topic>
    <files>
      <file>.claude/skills/test-diet/SKILL.md</file>
      <file>docs/adr/ADR-038-testing-strategy.md</file>
      <file>projects/spaarke-side-pane-navigation-history-r1/spec.md</file>
    </files>
    <patterns>
      <pattern name="Project-close test-diet gate" location=".claude/skills/test-diet/SKILL.md">Reconcile tests added/modified during the project as scaffolding (delete) vs maintain (keep) per ADR-038; write notes/test-diet-report.md; the reviewer executes the suggested git rm / git mv.</pattern>
    </patterns>
  </knowledge>
  <steps mode="prescriptive">
    <step order="0" name="Context + rigor declaration">Declare rigor (MINIMAL) + model-tier (sonnet) + effort (high) per task-execute Step 0.5; confirm ALL non-deferred tasks are ✅ in TASK-INDEX — if any is incomplete, STOP and report (do not close out).</step>
    <step order="1">Set the project README status to Complete.</step>
    <step order="2">Write notes/lessons-learned.md (what worked, what surprised, Path B outcome, reuse wins/gaps).</step>
    <step order="3">Invoke /test-diet to reconcile the Jest tests added/modified during the project against the ADR-038 build-vs-maintain philosophy; write notes/test-diet-report.md (git rm / git mv suggestions for the reviewer — read-only).</step>
    <step order="4">Write notes/success-criteria-verification.md mapping each spec Success Criterion (1-12) to concrete evidence.</step>
    <step order="5">Update tasks/TASK-INDEX.md: all tasks ✅ (this task 090 set to completed last).</step>
    <step order="6">Archive the project per the standard close-out procedure.</step>
    <step order="7">Document any deviation in projects/spaarke-side-pane-navigation-history-r1/notes/.</step>
  </steps>
  <escalation>
    <trigger>If any non-deferred task is incomplete (not ✅ in TASK-INDEX and not an owner-approved deferral), STOP and report the incomplete task(s) instead of closing out (root CLAUDE.md §7).</trigger>
  </escalation>
  <tools>
    <tool name="test-diet">Reconcile project Jest tests vs ADR-038 build-vs-maintain; write notes/test-diet-report.md.</tool>
  </tools>
