    <dependencies>
      <dependency task="011" status="pending">SprkSidePaneHost + sidePaneRegistry — the host the Navigator body registers against and the rail icon it drives.</dependency>
      <dependency task="021" status="pending">Deployed sprk_navitem entity + security roles — the store the tabs will read/write (scaffold only in this task).</dependency>
