  </context>

  <steps mode="directional">
    <step order="0" name="Context">Load spec FR-B-14, RagService.cs:1238, PrivilegeFilterBuilder, ConversationHistorySanitizer.</step>
    <step order="1" name="Trace retrieval">Confirm the privilege filter is unconditionally appended to the AI Search filter at retrieval; verify it encodes user-level matter walls.</step>
    <step order="2" name="Contrast sanitization">Confirm walls are enforced at retrieval, not merely at history-sanitization.</step>
    <step order="3" name="Finding">Write the finding (CONFIRMS-control or IDENTIFIES-GAP) with file:line evidence.</step>
    <step order="4" name="Escalate-if-gap">If a gap is found, invoke the pre-declared security escalation (own project); do not fix in-scope.</step>
  </steps>

  <tools>
    <tool name="dotnet">Optional read-only verification test build/run</tool>
