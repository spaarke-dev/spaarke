  <acceptance-criteria>
    <criterion testable="true">Next-step chips render on OutcomeCards, sourced from the Binding's declared transitions (asserted by a test).</criterion>
    <criterion testable="true">Record-scope memory precursor items persist through the generalized service + governance envelope.</criterion>
    <criterion testable="true">No goal-tracking subsystem, state machine, or new Dataverse table is introduced (grep/inspection).</criterion>
