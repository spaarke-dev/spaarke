<task id="050" project="visual-host-create-button-r1">
  <metadata>
    <title>Final VisualHost deploy + 3-wizard smoke (Event/Invoice/KPI)</title>
    <phase>B/C: Integration</phase>
    <status>not-started</status>
    <estimated-hours>3</estimated-hours>
    <dependencies>030,040</dependencies>
    <blocks>090</blocks>
