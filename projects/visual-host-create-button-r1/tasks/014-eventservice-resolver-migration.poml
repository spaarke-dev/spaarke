<task id="014" project="visual-host-create-button-r1">
  <metadata>
    <title>Migrate eventService.createEvent to applyResolverFields + lockAssociation support</title>
    <phase>A: Visual Host + Registry + Event</phase>
    <status>completed</status>
    <estimated-hours>4</estimated-hours>
    <dependencies>001,002</dependencies>
    <blocks>015</blocks>
    <tags>shared-lib, adr-024, migration, resolver</tags>
    <rigor-hint>FULL</rigor-hint>
    <rigor-reason>ADR-024 compliance migration of existing non-compliant code; regression-sensitive</rigor-reason>
    <model-tier>opus</model-tier>
    <model-tier-reason>ADR-migration of existing non-compliant wizard; must preserve existing Event links while adding all resolver fields — high correctness bar</model-tier-reason>
