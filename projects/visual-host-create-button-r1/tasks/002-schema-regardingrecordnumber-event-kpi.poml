<task id="002" project="visual-host-create-button-r1">
  <metadata>
    <title>Schema deltas: sprk_event doc lookup + sprk_kpiassessment regardingrecordurl (owner-approved, task 001 findings)</title>
    <phase>0: Discovery &amp; Schema Verification</phase>
    <status>completed</status>
    <estimated-hours>2</estimated-hours>
