      <steps><step>Open Matter form → Events visual</step><step>Click "+"; complete wizard; submit</step><step>Open the new Event; verify regarding + resolver fields</step></steps>
      <expected>Valid sprk_event regarding the Matter; no console errors</expected>
    </test>
  </ui-tests>

