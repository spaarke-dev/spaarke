<?xml version="1.0" encoding="UTF-8"?>
<task id="010" project="visual-host-create-button-r1">
  <metadata>
    <title>Read chart-def columns into ConfigurationLoader + ChartDefinition</title>
    <phase>A: Visual Host + Registry + Event</phase>
    <status>not-started</status>
    <estimated-hours>2</estimated-hours>
    <dependencies>001</dependencies>
    <blocks>012</blocks>
    <tags>pcf, config, visualhost</tags>
    <rigor-hint>FULL</rigor-hint>
    <rigor-reason>Modifies PCF .ts source</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Well-scoped single-file config read; two existing columns</model-tier-reason>
    <parallel-group>A</parallel-group>
    <parallel-safe>true</parallel-safe>
  </metadata>

  <prompt>Read the two existing sprk_chartdefinition columns (sprk_createwizardenabled, sprk_createwizardkey) into the ChartDefinition TypeScript type and ConfigurationLoader so the toolbar can gate the "+" button.</prompt>
  <role>SPAARKE PCF developer. React + Fluent v9 + PCF virtual control. Follow ADR-022.</role>
  <goal>ChartDefinition type carries createWizardEnabled: boolean and createWizardKey: string|null; ConfigurationLoader populates them from the sprk_chartdefinition record. No behavior change when the columns are null/false.</goal>

  <context>
    <background>Columns already exist in Dataverse (owner-confirmed). This task only READS them client-side; no schema work. FR-01.</background>
    <relevant-files>
      src/client/pcf/VisualHost/control/services/ConfigurationLoader.ts
      src/client/pcf/VisualHost/control/(ChartDefinition type location)
    </relevant-files>
  </context>

  <knowledge>
    <files>
      projects/visual-host-create-button-r1/spec.md
      projects/visual-host-create-button-r1/CLAUDE.md
      docs/guides/PCF-DEPLOYMENT-GUIDE.md
      src/client/pcf/CLAUDE.md
      src/client/pcf/VisualHost/control/services/ConfigurationLoader.ts
    </files>
  </knowledge>

  <steps>
    <step>Locate the ChartDefinition type; add createWizardEnabled (bool, default false) + createWizardKey (string|null).</step>
    <step>In ConfigurationLoader, map sprk_createwizardenabled → createWizardEnabled and sprk_createwizardkey → createWizardKey from the retrieved record.</step>
    <step>Default createWizardEnabled to false when the column is absent/null (backward compat — NFR-05).</step>
  </steps>

  <tools>Read, Grep, Edit</tools>
  <outputs>Updated ConfigurationLoader.ts + ChartDefinition type.</outputs>

  <acceptance-criteria>
    <criterion>ChartDefinition exposes createWizardEnabled + createWizardKey.</criterion>
    <criterion>Existing chart-def records with null columns yield createWizardEnabled=false (no "+" button later).</criterion>
    <criterion>npm run build:prod (VisualHost) compiles.</criterion>
  </acceptance-criteria>
</task>
