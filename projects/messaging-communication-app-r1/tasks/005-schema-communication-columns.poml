    <tool name="dataverse-create-schema">Add the columns + mapping fields</tool>
    <tool name="dataverse-deploy">Deploy to the project solution</tool>
  </tools>

  <outputs>
    <output type="schema">Dataverse: `sprk_communication` — privacy flag, internal-only flag, privilege classification, ACS `messageId`, ACS `chatThreadId` (placement documented)</output>
