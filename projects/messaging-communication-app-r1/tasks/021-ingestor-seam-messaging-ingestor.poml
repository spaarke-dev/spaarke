<task id="021" project="messaging-communication-app-r1">
  <metadata>
    <title>`ICommunicationChannelIngestor` seam (net-new) + `MessagingIngestor`</title>
    <phase>W2 — Channel Provider (ADR-045 seams)</phase>
    <status>not-started</status>
    <estimated-hours>5</estimated-hours>
