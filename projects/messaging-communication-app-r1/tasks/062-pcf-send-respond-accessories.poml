    <tool name="bash">npm run build:prod + bundle grep for @azure/communication</tool>
    <tool name="pcf-deploy">Pack + import; place on the OOB form</tool>
    <tool name="ui-test">Compose/send/respond verification on the OOB form</tool>
    <tool name="code-review">FULL-rigor quality gate (Step 9.5)</tool>
    <tool name="adr-check">FULL-rigor quality gate (Step 9.5)</tool>
  </tools>

  <outputs>
    <output type="code">src/client/pcf/CommunicationActions/ (UPDATED — message send/respond actions) OR src/client/pcf/CommunicationMessageActions/ (NEW — per §11 decision)</output>
