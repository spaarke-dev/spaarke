    <patterns>
      <pattern name="CommunicationActions accessory PCF" location="src/client/pcf/CommunicationActions/">
        Reply/Forward/Send over BFF endpoints, `@spaarke/auth` at the boundary, platform React. The message send/respond actions are the second-channel instance of this pattern — extend or mirror.
      </pattern>
      <pattern name="Compose-surface reuse" location="src/client/shared/Spaarke.UI.Components/src/components/CommunicationTimeline/subcomponents/TimelineComposeBox.tsx">
