<task id="090" project="messaging-communication-app-r1">
  <metadata>
    <title>Project wrap-up — README → Complete, lessons-learned, `/test-diet` gate, archive, final code-review, TASK-INDEX reconciliation</title>
    <phase>Wrap</phase>
