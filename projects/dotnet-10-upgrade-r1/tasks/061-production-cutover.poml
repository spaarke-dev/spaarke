<?xml version="1.0" encoding="UTF-8"?>
<task id="061" project="dotnet-10-upgrade-r1">
  <metadata>
    <title>FR-16 — production cutover via P1v3 slot swap (runtime+binary atomic)</title>
    <phase>P6 Production cutover (OPERATOR-DRIVEN)</phase>
    <gate>060 complete</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Production runtime cutover; the highest-consequence step; deployment-critical.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Execute the swap + monitor per runbook; well-specified, maximum stakes.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>OPERATOR-DRIVEN — production cutover; single most consequential step.</parallel-reason>
    <deps>060</deps>
    <tags>deployment, dotnet, migration</tags>
    <estimated-effort>1-2 hours</estimated-effort>
  </metadata>

  <prompt>OPERATOR-DRIVEN. Execute the production cutover: with the staging slot validated on net10 (051 "go") and rollback rehearsed (060), swap staging→production so the runtime string and the code move atomically to `DOTNETCORE|10.0`. Warm-up pings before routing switches → no dropped requests. Monitor post-swap; keep rollback-by-swap ready (staging holds the prior app). Record the swap logs + monitoring evidence.</prompt>
  <role>SPAARKE release engineer. Expert in App Service P1v3 slot swaps, warm-up, atomic runtime+binary cutover, and production monitoring. Follow ADRs strictly.</role>
  <goal>Production serves on `DOTNETCORE|10.0` with no dropped requests during the swap; `notes/production-cutover.md` records the swap logs, warm-up behavior, post-swap monitoring, and rollback-readiness.</goal>

  <context>
    <background>spec FR-16 + design §7. P1v3 supports slots. `linuxFxVersion` is slot-swapped → the swap moves runtime + code atomically. Warm-up before routing → no dropped requests. Rollback = swap back (rehearsed in 060). This is the last cutover step; after it, production is on net10.</background>
    <relevant-files>
      <file role="canonical-reference">projects/dotnet-10-upgrade-r1/notes/slot-swap-runbook.md</file>
      <file role="canonical-reference">projects/dotnet-10-upgrade-r1/notes/rollback-rehearsal.md</file>
      <file role="new">projects/dotnet-10-upgrade-r1/notes/production-cutover.md</file>
    </relevant-files>
    <dependencies>
      <dependency task="060" status="pending">Rollback rehearsed (swap-back proven).</dependency>
      <dependency task="051" status="pending">Non-prod smoke "go" recorded.</dependency>
    </dependencies>
  </context>

  <constraints>
    <constraint source="NFR-04">Runtime string + deployed TFM change together via the atomic swap; framework mismatch = hard 503. Do NOT set the prod runtime independently of the swap.</constraint>
    <constraint source="project">OPERATOR-DRIVEN: production credentials + a recorded "go" (051) + a proven rollback (060) are hard preconditions. Keep swap-back ready throughout.</constraint>
    <constraint source="project">Use warm-up (optionally `--action preview` two-phase) so no requests drop during routing switch.</constraint>
  </constraints>

  <knowledge>
    <topic>Production slot swap cutover on net10</topic>
    <files>
      <file>projects/dotnet-10-upgrade-r1/spec.md</file>
      <file>projects/dotnet-10-upgrade-r1/design.md</file>
      <file>.claude/skills/bff-deploy/SKILL.md</file>
    </files>
    <patterns>
      <pattern name="prod-swap" location="projects/dotnet-10-upgrade-r1/design.md">design §7 step 5 — swap with warm-up, two-phase preview optional, rollback-by-swap.</pattern>
    </patterns>
  </knowledge>

  <steps mode="prescriptive">
    <step order="0" name="Context + rigor declaration">Load spec FR-16 + design §7 + the runbook. Declare RIGOR: FULL. Confirm operator + 051 "go" + 060 rollback proven.</step>
    <step order="1">Confirm the staging slot is on net10 and validated; warm up the slot.</step>
    <step order="2">Swap staging→production (optionally `--action preview` two-phase); verify runtime+code moved atomically to `DOTNETCORE|10.0`.</step>
    <step order="3">Monitor post-swap (health, error rate, latency, telemetry) for the agreed window; keep swap-back ready.</step>
    <step order="4">Record swap logs + monitoring evidence in `notes/production-cutover.md`.</step>
    <step order="5">Update `tasks/TASK-INDEX.md`: set 061 status to ✅.</step>
    <step order="6">Document any deviation in `projects/dotnet-10-upgrade-r1/notes/`.</step>
  </steps>

  <escalation>
    <trigger>If post-swap monitoring shows dropped requests, 503s (framework mismatch), or any regression, IMMEDIATELY roll back via swap-back (per 060) and surface per CLAUDE.md §6 — do not attempt a forward fix on live production.</trigger>
  </escalation>

  <tools>
    <tool name="dotnet">n/a (az CLI)</tool>
  </tools>

  <outputs>
    <output type="doc">projects/dotnet-10-upgrade-r1/notes/production-cutover.md</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">Production serves on `DOTNETCORE|10.0` after the swap, with no dropped requests during routing switch (warm-up evidence recorded).</criterion>
    <criterion testable="true">Post-swap monitoring shows no regression for the agreed window; rollback-by-swap remained ready.</criterion>
    <criterion testable="true">`notes/production-cutover.md` records swap logs + monitoring evidence.</criterion>
    <criterion testable="true">Negative: on any regression the operator rolled back via swap-back rather than forward-fixing live prod.</criterion>
  </acceptance-criteria>

  <notes>spec FR-16. Final cutover step. After this, production is on net10; wrap-up is task 090.</notes>

  <execution>
    <skill>.claude/skills/task-execute/SKILL.md</skill>
  </execution>
</task>
