<task id="004" project="dotnet-10-upgrade-r1">
  <metadata>
    <title>Retarget Sprk.Bff.Api to net10; finish package alignment + routine same-major catch-ups</title>
    <phase>P0 Retarget + build-green</phase>
    <gate>003 complete</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies the primary deployable csproj; BFF-wide; brownfield; many runtime-tied packages.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Enumerated package moves (design §6.1/§6.3); no architectural judgment beyond the closed list.</model-tier-reason>
    <effort>xhigh</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>Serial P0 chain; BFF is the largest surface and depends on Core/Dataverse being on net10.</parallel-reason>
