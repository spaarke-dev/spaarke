<task id="013" project="dotnet-10-upgrade-r1">
  <metadata>
    <title>H6 + secondary hit-site sweep (grep + per-item verdict)</title>
    <phase>P1 Hit-site remediation</phase>
    <gate>005 complete</gate>
    <status>completed</status>
