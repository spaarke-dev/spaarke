<task id="090" project="dotnet-10-upgrade-r1">
  <metadata>
    <title>FR-17 — wrap-up: test-diet, doc-drift, INDEX update, r3 handoff note, defer majors</title>
    <phase>P7 Wrap-up</phase>
    <gate>061 complete</gate>
    <status>not-started</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>Project-close wrap-up; touches .claude/ + projects/INDEX.md (main-session-only) + governance docs.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Run the close-out skills + author the handoff note; well-specified.</model-tier-reason>
    <effort>high</effort>
