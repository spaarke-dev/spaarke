  <acceptance-criteria>
    <criterion testable="true">Each confirmation shows a bold clause-location header; entries clearly separated (spacing token).</criterion>
    <criterion testable="true">A finding with no resolvable location renders a graceful generic header (no "undefined").</criterion>
    <criterion testable="true">Negative: confirmation semantics/controls unchanged (existing tests pass untouched).</criterion>
