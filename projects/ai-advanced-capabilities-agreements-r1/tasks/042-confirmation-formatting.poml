<task id="042" project="ai-advanced-capabilities-agreements-r1">
  <metadata>
    <title>#4 Separated, location-labelled Assistant confirmations</title>
    <phase>4 Review-Depth UX</phase>
    <gate>blocked (deps 041)</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>.tsx change on the conversation surface (auto-FULL), though small.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Small formatting change with exact seam named.</model-tier-reason>
    <effort>medium</effort>
    <parallel-group>I</parallel-group>
