    </dependencies>
  </context>

  <constraints>
    <constraint source="ADR-021">Bold/emphasis + spacing via Fluent v9 tokens (no hardcoded px/weights outside token scale); dark mode intact. Scope: the formatting.</constraint>
    <constraint source="ADR-041">Formatting-only — the confirmation CONTENT/semantics (store-before-render, controls) unchanged. Scope: this task.</constraint>
