<task id="031" project="ai-advanced-capabilities-agreements-r1">
  <metadata>
    <title>FR-16(c,d) — DEF-09 document-session dispatch routing + apply-leg gating for findings</title>
    <phase>3 Durable Review</phase>
    <gate>blocked (deps 030)</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Dispatch routing correctness (write/read session coincidence) + edit-machinery gating in ConversationPane hot file.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Precisely specified by the verified DEF-09 seam (sessionIdOverride) + apply-leg code refs; brownfield but mapped.</model-tier-reason>
    <effort>xhigh</effort>
    <parallel-group>F</parallel-group>
