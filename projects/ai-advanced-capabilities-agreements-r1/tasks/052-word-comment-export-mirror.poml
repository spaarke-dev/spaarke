      <file>projects/ai-advanced-capabilities-agreements-r1/notes/word-comment-export-gap.md</file>
    </files>
    <patterns>
      <pattern name="gutter relabel" location="src/client/shared/Spaarke.Compose.Components/src/widgets/ComposeCommentGutter.tsx (:343-378 pre-merge)">Hoist the relabel/structure into a shared helper both gutter + export consume.</pattern>
    </patterns>
  </knowledge>

  <steps mode="directional">
    <step order="0">Declare rigor; re-locate the four seam points post-merge; audit which seam (placement vs export mapping) best serves both live and durable-recalled threads.</step>
    <step order="1">Hoist the structured-comment composition into a shared helper (gutter display + export use one source).</step>
    <step order="2">Export mapping: compose commentText from the discrete fields (+ standardRef; full clause text when present); lift the :89 scope with an explanatory comment.</step>
    <step order="3">Author: prop/config with default; thread through useComposeCommentThreads.</step>
    <step order="4">Tests: export mapping (structured output; legacy-thread graceful degrade); author config; save→reopen round-trip assertion at the mapping level.</step>
    <step order="5">Manual: save a reviewed doc, open in Word, verify all four symptoms fixed.</step>
    <step order="6">Update TASK-INDEX.md: 052 ✅.</step>
  </steps>

  <ui-tests>
    <test name="Word fidelity"><steps><step>Save a reviewed doc; download; open in Word</step></steps><expected>Each comment: configured author, "Flagged clause", "Assessment says: ...", "Standard: ..." — mirroring the gutter.</expected></test>
  </ui-tests>
  <tools><tool name="npm">lib build/tests</tool></tools>
