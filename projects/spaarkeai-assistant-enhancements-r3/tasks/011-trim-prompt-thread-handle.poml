    <parallel-group>Wave1-serial</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>Edits SprkChatAgentFactory.BuildWorkspaceStateBlock — same file as 010 → runs sequentially after 010; coordinate spaarke-ai-architecture-redesign-r2 seams (consume PublicContracts, no fork).</parallel-reason>
    <deps>001, 010</deps>
