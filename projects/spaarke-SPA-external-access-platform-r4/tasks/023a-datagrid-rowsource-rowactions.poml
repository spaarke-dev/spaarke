<task id="023a" project="spaarke-SPA-external-access-platform-r4">
  <metadata>
    <title>Shared DataGrid: host row source, row-actions column, truncate-with-tooltip (FR-16 enabler; design notes/task-023-design.md §3.1)</title>
    <phase>2 Invoices and documents</phase>
    <gate>owner approved the design 2026-11-22 ("Yes, Dataverse record") and the new props on behalf of the grid owners ("yes I approve")</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Additive change to a shared component with 34 consumers (.tsx); a regression reaches every grid host</rigor-reason>
    <model-tier>opus</model-tier>
    <model-tier-reason>High blast radius: shared-lib API design inside a 1,636-line component</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>true</parallel-safe>
