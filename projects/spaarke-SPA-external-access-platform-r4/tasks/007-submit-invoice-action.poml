<task id="007" project="spaarke-SPA-external-access-platform-r4">
  <metadata>
    <title>"Submit invoice" record action on Matter, Project and Work Assignment (FR-10)</title>
    <phase>1 Record template and actions</phase>
    <gate>after 006; step 1 is a coordination gate with ebilling-r1 (see escalation)</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
