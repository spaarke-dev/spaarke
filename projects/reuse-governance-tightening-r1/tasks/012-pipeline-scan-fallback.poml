  <steps mode="directional">
    <step order="1">Confirm task 010 recorded go.</step>
    <step order="2">Edit project-pipeline Step 2 item 5; add the new gate to the "Safety gates" list in Execution Mode.</step>
    <step order="3">Edit task-create Step 3.5.6.</step>
    <step order="4">Grep for step citations of both skills and confirm none broke.</step>
