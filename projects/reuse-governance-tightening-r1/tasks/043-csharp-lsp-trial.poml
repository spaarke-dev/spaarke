<?xml version="1.0" encoding="UTF-8"?>
<task id="043" project="reuse-governance-tightening-r1">
  <metadata>
    <title>5(f) Per-session C# language-server A/B trial</title>
    <phase>5 Quality tooling</phase>
    <gate>startable</gate>
    <status>not-started</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>Creates a new project note from a measured experiment with fixed gates (FR-13)</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Measurement against fixed questions and thresholds; the decision is the owner's</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>installs a plugin and measures machine memory; needs the operator and must not share the machine's load with other waves</parallel-reason>
    <deps>none</deps>
    <tags>config</tags>
    <estimated-effort>4 hours (hard time-box)</estimated-effort>
  </metadata>

  <prompt>Within half a day, measure whether a per-session C# LSP plugin answers 10 real navigation questions on Sprk.Bff.Api better than Grep, against three fixed gates, and record the result and the owner's decision.</prompt>
  <role>SPAARKE platform developer running a measured tooling trial.</role>
  <goal>projects/reuse-governance-tightening-r1/notes/csharp-lsp-trial.md records per-question results for both arms, the three gate results (or "not workable today"), the recorded context metrics, and the owner's decision.</goal>

  <context>
    <background>spec.md FR-13; design.md section 7.6. Questions: 4 find-references, 3 find-implementations, 2 receiver-type/definition, 1 "what breaks if I change this signature", taken from real recent sessions and hand-checked first. Gates: correctness at least 9/10 with LSP and none worse than Grep; zero false "no references"; at most 2 GB resident per session at steady state and at least 25% RAM free with 3 sessions. This does not reopen the shared-index rejection (design.md section 10.6).</background>
    <relevant-files>
      <file role="new">projects/reuse-governance-tightening-r1/notes/csharp-lsp-trial.md</file>
      <file role="canonical-reference">src/server/api/Sprk.Bff.Api/Program.cs</file>
    </relevant-files>
    <dependencies>
      <dependency task="none" status="complete">Independent</dependency>
    </dependencies>
  </context>

  <constraints>
    <constraint source="project">Hard time-box of half a day: if the plugin cannot answer on Sprk.Bff.Api by then, record "no-adopt, not workable today" and stop.</constraint>
    <constraint source="project">Write the 10 questions and their hand-checked answers into the note before running either arm.</constraint>
    <constraint source="project">Same model for both arms, one worktree; record tool calls, tokens, wall time and cold start (context only, not gates).</constraint>
    <constraint source="project">Do not commit the plugin setting or any repo configuration; adoption is a separate, justified change.</constraint>
    <constraint source="project">Installing the plugin and the language-server binary needs the operator's OK (it changes the machine).</constraint>
  </constraints>

  <knowledge>
    <files>
      <file>projects/reuse-governance-tightening-r1/design.md</file>
      <file>src/server/api/Sprk.Bff.Api/CLAUDE.md</file>
      <file>.claude/constraints/agent-cost.md</file>
    </files>
    <patterns>
      <pattern name="Measured decision" location="projects/reuse-governance-tightening-r1/design.md">Section 7.6 gates; memory failure with usefulness pass means opt-in per session.</pattern>
    </patterns>
  </knowledge>

  <steps mode="prescriptive">
    <step order="1">Write the 10 questions and hand-checked answers into the note.</step>
    <step order="2">With the operator's OK, install the C# LSP plugin and language server; confirm it answers on Sprk.Bff.Api (start the time-box clock).</step>
    <step order="3">Run the Grep-only arm, then the LSP arm; record per-question correctness and metrics.</step>
    <step order="4">Measure resident memory at steady state for 1 and 3 concurrent sessions.</step>
    <step order="5">Evaluate the three gates; write the recommendation (adopt, opt-in per session, or no-adopt) and get the owner's decision.</step>
    <step order="6">Update TASK-INDEX.md: change this task's status cell to `✅ [done]`.</step>
  </steps>

  <escalation>
    <trigger>If the time-box is reached, STOP and record "not workable today"; do not extend it without the owner.</trigger>
  </escalation>

  <justification>
    <existing>No trial record exists; design.md section 10.6 rejected only a shared index.</existing>
    <extension>No: a project-local trial record, not repo surface.</extension>
    <cost-of-doing-nothing>The per-session LSP question stays open and keeps being re-argued without numbers.</cost-of-doing-nothing>
  </justification>

  <tools>
    <tool name="terminal">Plugin install and process memory measurement</tool>
  </tools>

  <outputs>
    <output type="docs">projects/reuse-governance-tightening-r1/notes/csharp-lsp-trial.md</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">The note lists the 10 questions with hand-checked answers written before the runs.</criterion>
    <criterion testable="true">Per-question results for both arms and all three gate results are recorded, or "not workable today" at the time-box.</criterion>
    <criterion testable="true">The owner's decision is recorded.</criterion>
    <criterion testable="true">Negative: no plugin setting or repo configuration is committed.</criterion>
  </acceptance-criteria>

  <notes>Its own PR carries only the note (or the note goes in the items 1-3 PR if the owner prefers; it is project-local).</notes>

  <execution>
    <skill>.claude/skills/task-execute/SKILL.md</skill>
    <protocol>Before starting, load all files listed in &lt;knowledge&gt;&lt;files&gt;. Follow task-execute for the pre-execution checklist.</protocol>
  </execution>
</task>
