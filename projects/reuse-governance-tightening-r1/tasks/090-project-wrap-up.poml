    <criterion testable="true">test-diet has run and its classifications are applied.</criterion>
    <criterion testable="true">README and plan show Complete; graduation criteria are checked or explicitly deferred by the owner.</criterion>
    <criterion testable="true">check-task-status-drift.ps1 reports no drift.</criterion>
    <criterion testable="true">The project is archived; the folder is not renamed.</criterion>
