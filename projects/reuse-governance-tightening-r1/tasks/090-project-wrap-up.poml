  <steps mode="prescriptive">
    <step order="1">Final quality gates: /code-review and /adr-check; fix F-class findings.</step>
    <step order="2">/test-diet for the project.</step>
    <step order="3">/repo-cleanup projects/reuse-governance-tightening-r1; approve removals; archive handoffs.</step>
