    </relevant-files>
    <dependencies>
      <dependency task="080" status="pending">Reviewed change set and PRs</dependency>
    </dependencies>
  </context>

  <constraints>
    <constraint source="project">Run /code-review and /adr-check over all project changes; fix every F-class finding before proceeding (task-execute Step 9.5).</constraint>
    <constraint source="ADR-038">Run /test-diet over tests added or modified by the project (census test edits) and act on its classification.</constraint>
    <constraint source="project">Do not rename or move the project folder; archive with /devops-project-archive.</constraint>
    <constraint source="project">Lessons go in notes/lessons-learned.md, one per entry; promotion to FAILURE-MODES or an ADR is done by doc-drift-audit / ai-procedure-maintenance.</constraint>
  </constraints>

  <knowledge>
    <files>
      <file>.claude/skills/task-execute/SKILL.md</file>
