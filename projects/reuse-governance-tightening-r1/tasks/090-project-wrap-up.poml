  <escalation>
    <trigger>If any graduation criterion cannot be met, STOP and ask the owner whether to defer it or keep the project open.</trigger>
  </escalation>

  <justification>
    <existing>No lessons-learned file in this project (Glob projects/reuse-governance-tightening-r1/notes/*).</existing>
