<?xml version="1.0" encoding="UTF-8"?>
<task id="030" project="reuse-governance-tightening-r1">
  <metadata>
    <title>Decision records for the 9 grandfathered packages</title>
    <phase>4 Package reviews</phase>
    <gate>startable</gate>
    <status>not-started</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>Creates a new project note under explicit ADR-012 constraints; ends at an owner gate (FR-08)</rigor-reason>
    <model-tier>opus</model-tier>
    <model-tier-reason>Sanction / consolidate / retire recommendations are architectural judgment against ADR-012's three tests</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>planning-tier judgment plus an owner approval gate; run from the main session</parallel-reason>
    <deps>none</deps>
    <tags>refactoring, typescript</tags>
    <estimated-effort>4 hours plus owner review</estimated-effort>
  </metadata>

  <prompt>For each package listed as Grandfathered in ADR-012's census, gather evidence for ADR-012's three tests, re-verify its consumers, grade findings by severity, and recommend sanction, consolidate or retire; then get the owner's approval of each decision.</prompt>
  <role>SPAARKE architect for the shared client packages. Applies ADR-012 strictly.</role>
  <goal>projects/reuse-governance-tightening-r1/notes/package-reviews.md has nine sections (evidence, consumer count, Findings by severity, recommendation, owner decision) and the owner has approved each.</goal>

  <context>
    <background>spec.md FR-08; design.md sections 6.1-6.2 (starting hypotheses that the review may overturn). Consumer counts Grepped 2026-11-10: ai-context 1 (SpaarkeAi), legal-workspace 1 (SpaarkeAi), document-operations 3 (SpaarkeAi, SemanticSearch code page, Compose.Components). Feature-area packages must address Pattern D dual-use and the PCF bundle cost of folding into ui-components.</background>
    <relevant-files>
      <file role="new">projects/reuse-governance-tightening-r1/notes/package-reviews.md</file>
      <file role="canonical-reference">.claude/adr/ADR-012-shared-components.md</file>
      <file role="canonical-reference">tests/Spaarke.ArchTests/SharedPackageCensusTests.cs</file>
      <file role="canonical-reference">src/client/shared/Spaarke.UI.Components/src/index.ts</file>
    </relevant-files>
    <dependencies>
      <dependency task="none" status="complete">Starts from the PR #2656 census</dependency>
    </dependencies>
  </context>

  <constraints>
    <constraint source="ADR-012">For each of the 9 packages, the recommendation is justified against all three ADR-012 tests (distinct contract, quarantine-worthy dependency, cross-surface reuse); a different feature area alone is not a distinct contract.</constraint>
    <constraint source="project">Evidence gathering uses code-mapper agents with model sonnet (effort low); the recommendation is written by the main session. At most 3 code-mapper launches.</constraint>
    <constraint source="project">Consumer counts are re-verified from package.json files and import sites at task time, not copied.</constraint>
    <constraint source="project">Every finding that is a defect on a real path is listed with severity and named to the owner (NFR-10); none is dropped because its package is out of execution scope.</constraint>
    <constraint source="project">Owner approval of each decision is required before tasks 031-034 start, in autonomous mode too.</constraint>
    <constraint source="project">Merge origin/master before starting (PR #935 touches ADR-012 and the census test).</constraint>
  </constraints>

  <knowledge>
    <files>
      <file>.claude/adr/ADR-012-shared-components.md</file>
      <file>.claude/adr/ADR-022-pcf-platform-libraries.md</file>
      <file>projects/reuse-governance-tightening-r1/design.md</file>
      <file>tests/CLAUDE.md</file>
    </files>
    <patterns>
      <pattern name="Census ratchet" location="tests/Spaarke.ArchTests/SharedPackageCensusTests.cs">Grandfathered list may only shrink; ADR table and test must agree.</pattern>
    </patterns>
  </knowledge>

  <steps mode="directional">
    <step order="1">Merge origin/master; read the census between the shared-package-census markers in ADR-012.</step>
    <step order="2">Launch up to 3 code-mapper agents (sonnet) to inventory, per package: exports, consumers (package.json and imports), dependencies, overlap with sanctioned packages.</step>
    <step order="3">Write one section per package: evidence per test, consumer count, Findings (severity-graded), recommendation with migration outline for consolidate/retire.</step>
    <step order="4">Present the file to the owner; record each decision in its section.</step>
    <step order="5">Update TASK-INDEX.md: change this task's status cell to `✅ [done]`.</step>
  </steps>

  <escalation>
    <trigger>If the review recommends a different action from the owner-scoped one for ai-context, legal-workspace or document-operations (for example sanction instead of retire), surface it explicitly to the owner; do not adjust scope silently.</trigger>
    <trigger>If a finding is a live user-visible defect, report it to the owner immediately rather than at the end.</trigger>
  </escalation>

  <justification>
    <existing>ADR-012 census reason column (one line per package, .claude/adr/ADR-012-shared-components.md lines 69-77).</existing>
    <extension>No: one line cannot hold three-test evidence, findings and a migration plan.</extension>
    <cost-of-doing-nothing>The 9 packages stay "under review" with no review, which is the old unenumerated "etc." again (G4).</cost-of-doing-nothing>
  </justification>

  <tools>
    <tool name="Agent">code-mapper (sonnet, low)</tool>
  </tools>

  <outputs>
    <output type="docs">projects/reuse-governance-tightening-r1/notes/package-reviews.md</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">Nine sections, one per grandfathered package, each with three-test evidence, a re-verified consumer count, Findings and a recommendation.</criterion>
    <criterion testable="true">Each section records the owner's decision.</criterion>
    <criterion testable="true">Negative: no code, ADR or test file changes in this task.</criterion>
    <criterion testable="true">Every defect finding has a severity and appears in a summary list at the top of the file.</criterion>
  </acceptance-criteria>

  <notes>Hypotheses in design.md section 6.2 are starting points only.</notes>

  <execution>
    <skill>.claude/skills/task-execute/SKILL.md</skill>
    <protocol>Before starting, load all files listed in &lt;knowledge&gt;&lt;files&gt;. Follow task-execute for the pre-execution checklist.</protocol>
  </execution>
</task>
