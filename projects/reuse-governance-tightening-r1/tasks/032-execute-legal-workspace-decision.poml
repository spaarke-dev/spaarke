  <steps mode="directional">
    <step order="1">Read the legal-workspace section and owner decision; run conflict-check.</step>
    <step order="2">Apply the decision, updating imports, aliases, package.json and build config in SpaarkeAi.</step>
    <step order="3">Update the ADR-012 census row and SharedPackageCensusTests in the same change.</step>
    <step order="4">Build SpaarkeAi and run its tests; run the SharedPackageCensus ArchTests.</step>
    <step order="5">Update TASK-INDEX.md: change this task's status cell to `✅ [done]`.</step>
    <step order="6">Record deviations and defects found in projects/reuse-governance-tightening-r1/notes/.</step>
  </steps>

  <escalation>
    <trigger>If another active project depends on the package boundary (FR-10 of dataset-grid-framework-r2), STOP and ask the owner before removing it.</trigger>
  </escalation>

  <tools>
    <tool name="npm">npm install --legacy-peer-deps --no-audit --no-fund; npm run build; npm test</tool>
    <tool name="dotnet">dotnet test tests/Spaarke.ArchTests --filter SharedPackageCensus</tool>
  </tools>

  <outputs>
    <output type="code">src/solutions/SpaarkeAi/package.json</output>
    <output type="docs">.claude/adr/ADR-012-shared-components.md</output>
    <output type="test">tests/Spaarke.ArchTests/SharedPackageCensusTests.cs</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">The owner-approved action for legal-workspace is fully applied.</criterion>
    <criterion testable="true">SpaarkeAi builds and its existing tests pass.</criterion>
    <criterion testable="true">SharedPackageCensusTests passes; census row and test entry match.</criterion>
    <criterion testable="true">Negative: after consolidate/retire, Grep finds no @spaarke/legal-workspace reference in src/.</criterion>
    <criterion testable="true">Cover the existing contract only; extras justified in one line in notes.</criterion>
  </acceptance-criteria>

  <notes>Item 4 PR(s) are separate from the items 1-3 PR (NFR-05).</notes>

