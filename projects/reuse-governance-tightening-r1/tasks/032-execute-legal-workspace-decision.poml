<task id="032" project="reuse-governance-tightening-r1">
  <metadata>
    <title>Execute the owner-approved decision for @spaarke/legal-workspace</title>
    <phase>4 Package reviews</phase>
    <gate>blocked until 031</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies .ts/.tsx code in src/client/shared and src/solutions/SpaarkeAi, and tests</rigor-reason>
    <model-tier>sonnet</model-tier>
