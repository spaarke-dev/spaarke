    <deps>031</deps>
    <tags>typescript, refactoring, migration, testing</tags>
    <estimated-effort>2-4 hours</estimated-effort>
  </metadata>

  <prompt>Carry out the decision recorded for @spaarke/legal-workspace in notes/package-reviews.md, keeping the ADR-012 census table and SharedPackageCensusTests in agreement in the same change.</prompt>
  <role>SPAARKE platform developer. Expert in the shared TypeScript packages, Vite code pages and the ADR-012 census.</role>
  <goal>The legal-workspace action is complete, the SpaarkeAi build and tests pass, and SharedPackageCensusTests passes.</goal>

  <context>
    <background>spec.md FR-09. Consumer (verified 2026-11-10): src/solutions/SpaarkeAi/package.json line 49. The package is a source-only re-export boundary for the LegalWorkspace section registry created by spaarke-dataset-grid-framework-r2 FR-10; the review decides whether that boundary still needs a package.</background>
    <relevant-files>
      <file role="modify">src/client/shared/Spaarke.LegalWorkspace</file>
      <file role="modify">src/solutions/SpaarkeAi/package.json</file>
      <file role="modify">src/solutions/SpaarkeAi/vite.config.ts</file>
      <file role="modify">.claude/adr/ADR-012-shared-components.md</file>
      <file role="modify">tests/Spaarke.ArchTests/SharedPackageCensusTests.cs</file>
      <file role="canonical-reference">projects/reuse-governance-tightening-r1/notes/package-reviews.md</file>
    </relevant-files>
    <dependencies>
      <dependency task="031" status="pending">Serialises edits to SpaarkeAi package.json and the census</dependency>
    </dependencies>
  </context>

  <constraints>
    <constraint source="ADR-012">The census row and the SharedPackageCensusTests entry change in the same commit as the package change; a sanction adds an ADR-012 amendment naming the package and its contract.</constraint>
    <constraint source="ADR-012">Moved code keeps its tests, uses no ComponentFramework.* or direct Xrm.WebApi, and exports its types.</constraint>
    <constraint source="ADR-038">Tests move with the code; cover the existing contract only, or justify extras in one line in notes.</constraint>
    <constraint source="project">Run conflict-check before editing src/solutions/SpaarkeAi; check whether spaarke-dataset-grid-framework-r2 still has open work on this boundary.</constraint>
    <constraint source="project">Do not touch any other grandfathered package in this task.</constraint>
  </constraints>

  <knowledge>
    <files>
      <file>.claude/adr/ADR-012-shared-components.md</file>
      <file>docs/adr/ADR-038-testing-strategy.md</file>
      <file>.claude/constraints/testing.md</file>
      <file>.claude/patterns/testing/unit-test-structure.md</file>
      <file>.claude/patterns/testing/mocking-patterns.md</file>
      <file>.claude/skills/conflict-check/SKILL.md</file>
      <file>projects/reuse-governance-tightening-r1/notes/package-reviews.md</file>
