<task id="022" project="spaarkeai-assistant-enhancements-r2">
  <metadata>
    <title>Fire one grounded suggestion turn per tab (cached by tabId) and render ≤3 chips via the reactive surface (FR-B3/B5)</title>
    <phase>3 B — Proactive follow-ons</phase>
    <gate>blocked until 020,021</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Frontend .tsx implementation of the proactive-turn + cache logic</rigor-reason>
    <model-tier>opus</model-tier>
    <model-tier-reason>Cache/lifecycle correctness (once-per-tab, no re-fire on switch-back) + reuse-not-resurrect discipline is judgment-sensitive</model-tier-reason>
    <effort>xhigh</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>Edits ConversationPane.tsx (shared client spine)</parallel-reason>
