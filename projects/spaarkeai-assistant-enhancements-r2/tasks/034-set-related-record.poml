    <output type="code">src/server/api/Sprk.Bff.Api/Api/Ai/AnalysisEndpoints.cs</output>
  </outputs>
  <acceptance-criteria>
    <criterion testable="true">The action is named "Set related record" in the overflow menu.</criterion>
    <criterion testable="true">The prompt offers existing-record vs create-document.</criterion>
    <criterion testable="true">A filed session appears on the matter's Analyses tab.</criterion>
    <criterion testable="true">An already-associated session does not offer the action.</criterion>
