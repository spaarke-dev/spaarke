    </relevant-files>
  </context>
  <constraints>
    <constraint source="ADR-015">The Email fields are a compact shape (subject/from/date/thread + short snippet) — background tabs stay metadata-only.</constraint>
    <constraint source="project">Keep the union closed + 1:1 with the client discriminator (040).</constraint>
    <constraint source="project">Publish ≤60 MB (report delta).</constraint>
