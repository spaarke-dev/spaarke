<task id="010" project="spaarkeai-assistant-enhancements-r2">
  <metadata>
    <title>ConversationPane subscribes to active_widget_changed and holds a focus ref (FR-A1)</title>
    <phase>2 A — Active-tab awareness</phase>
    <gate>blocked until 001</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Frontend .tsx implementation with a seam test</rigor-reason>
    <model-tier>sonnet</model-tier>
