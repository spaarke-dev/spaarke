<task id="238" project="spaarke-ontology-platform-r1">
  <metadata>
    <title>Task 185 leftovers (client): Smart To Do "New To Do" label, the composer tells the user when a picked recipient cannot be resolved, focus returns to To after a side-pane pick in the Document Relationship Viewer's composer</title>
    <phase>12 Create-wizard lookups and composer (UAT round 4) follow-up</phase>
    <gate>startable</gate>
    <status>pending</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies shared .ts/.tsx in @spaarke/ui-components and a SmartTodo shared package.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Three scoped client changes with file:line maps; reference implementations named.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>185-leftovers-2026-11-28</parallel-group>
    <parallel-safe>true</parallel-safe>
