<task id="214" project="spaarke-ontology-platform-r1">
  <metadata>
    <title>After a send, the Sent Items lookup finds the message instead of returning 400, so the Internet-Message-Id reaches reply matching and the archive (#2774, DI-150)</title>
    <phase>12 Create-wizard lookups and composer (185 dev check fixes)</phase>
    <gate>startable</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies BFF code (.cs).</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>One located Graph query fix in two branches.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>deferred-fixes-2026-11-25b</parallel-group>
    <parallel-safe>true</parallel-safe>
    <parallel-reason>EmailChannelSender.cs Sent Items lookup only; task 212 does not touch EmailChannelSender.</parallel-reason>
