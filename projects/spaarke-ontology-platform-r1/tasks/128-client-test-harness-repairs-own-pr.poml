<task id="128" project="spaarke-ontology-platform-r1">
  <metadata>
    <title>Client test-harness repairs, own PR: Daily Briefing cleanGuid mock (#1416), SmartTodo jest key (#1417), WorkspaceLayoutWizard stale selectors (#1388), SemanticSearchControl jest (#1392)</title>
    <phase>8 Remaining cleanup and repairs</phase>
    <gate>startable</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies tests/** and test config in four packages (CLAUDE.md section 8: code-review + adr-check regardless).</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Four independent, diagnosed test-infrastructure fixes.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>J</parallel-group>
    <parallel-safe>true</parallel-safe>
    <parallel-reason>Own worktree off origin/master; test files and jest config only. SemanticSearchControl: rebase after PR #1415 (task 111) if it merges first.</parallel-reason>
