<task id="188" project="spaarke-ontology-platform-r1">
  <metadata>
    <title>Remaining email composer hosts: templates, AI drafting and attachment upload (ComposeWorkspace, TrackingFieldTrio, CommunicationPage, CommunicationActions)</title>
    <phase>12 Create-wizard lookups and composer (UAT round 4)</phase>
    <gate>after 186 merges</gate>
