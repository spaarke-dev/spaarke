<task id="097" project="spaarke-ontology-platform-r1">
  <metadata>
    <title>Event "complete" status code and To Do reassign lookup target, own PR</title>
    <phase>8 Remaining cleanup and repairs</phase>
    <gate>startable</gate>
    <status>in-progress</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies BFF .cs and client .ts/.tsx write paths against live Dataverse metadata.</rigor-reason>
    <model-tier>opus</model-tier>
    <model-tier-reason>Two suspected live defects found by reading code; each must be proven against the real schema before any change.</model-tier-reason>
    <effort>high</effort>
