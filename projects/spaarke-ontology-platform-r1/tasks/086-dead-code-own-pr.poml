<task id="086" project="spaarke-ontology-platform-r1">
  <metadata>
    <title>Dead and misleading code, own PR (C-19, C-21, C-14, C-20, C-26, C-6, C-27)</title>
    <phase>8 Remaining cleanup and repairs</phase>
    <gate>startable</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies .ts/.tsx source and deletes code; quality gates apply.</rigor-reason>
    <model-tier>opus</model-tier>
    <model-tier-reason>Deletes a privacy-contract shim (C-21) and several delete-or-adopt items where a wrong call removes live code.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>I</parallel-group>
    <parallel-safe>true</parallel-safe>
    <parallel-reason>Runs in its own worktree on its own branch; shares no files with the ontology worktree or the other wave-I tasks.</parallel-reason>
    <deps>none</deps>
    <tags>cleanup,technical-debt,separate-pr</tags>
    <estimated-effort>4-6 hours</estimated-effort>
