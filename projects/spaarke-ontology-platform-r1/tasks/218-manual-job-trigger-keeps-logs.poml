  <metadata>
    <title>A manually triggered scheduled job keeps its logs: the run no longer inherits the trigger request's sampled-out trace (#3125, DI-175)</title>
    <phase>12 Create-wizard lookups and composer (185 dev check fixes)</phase>
    <gate>startable</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies BFF code (.cs).</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>One located defect with a stated fix copied from an existing pattern (ExternalAccessAudit).</model-tier-reason>
    <effort>high</effort>
    <parallel-group>deferred-fixes-2026-11-25c</parallel-group>
    <parallel-safe>true</parallel-safe>
    <parallel-reason>src/server/shared/Spaarke.Scheduling/ScheduledJobHost.cs only; no other wave task touches it.</parallel-reason>
    <deps>none</deps>
