<task id="223" project="spaarke-ontology-platform-r1">
  <metadata>
    <title>Every Signals lookup that trusts a Decision Record as the writer's uses WriterCreatedRecord (createdby the writer AND createdonbehalfby empty); the guard baseline goes to zero (#2632, DI-144)</title>
    <phase>12 Create-wizard lookups and composer (185 dev check fixes)</phase>
    <gate>startable</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
