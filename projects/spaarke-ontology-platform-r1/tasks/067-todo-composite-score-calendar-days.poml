<task id="067" project="spaarke-ontology-platform-r1">
  <metadata>
    <title>To Do composite score on calendar days, one shared function</title>
    <phase>6 Do lane and Briefing fold-in</phase>
    <gate>081, 098 complete</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Changes the ranking of every To Do board (a user-visible re-rank).</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>One function in a known file, plus collapsing any copies.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>R</parallel-group>
    <parallel-safe>true</parallel-safe>
    <deps>081, 098</deps>
    <tags>frontend,todo,scoring</tags>
    <estimated-effort>2-3 hours</estimated-effort>
