<?xml version="1.0" encoding="UTF-8"?>
<task id="033" project="spaarke-ontology-platform-r1">
  <metadata>
    <title>Closure semantics including aged-out-of-window</title>
    <phase>3 Evaluator and Signal lifecycle</phase>
    <gate>031 complete</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Decides when a Signal stops existing; errors here either rot the worklist or close live work.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Well-specified state machine over an existing option set.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>C</parallel-group>
    <parallel-safe>true</parallel-safe>
    <deps>031</deps>
    <tags>bff-api,signals,lifecycle</tags>
    <estimated-effort>2-3 hours</estimated-effort>
  </metadata>

  <prompt>Implement the three system closure types and map aged-out-of-window to ConditionCleared, leaving the decision reference null for all of them.</prompt>
  <role>SPAARKE backend developer.</role>
  <goal>A Signal closes correctly and distinguishably for each system reason, with no Decision Record written.</goal>

  <context>
    <background>The resolution vocabulary already half-exists on live sprk_spendsignal (Active, Acknowledged, Resolved, Auto Resolved), where Auto Resolved IS ConditionCleared. So this is vocabulary to copy, not invent. What does not exist is anything that WRITES it.</background>
    <relevant-files>
      <file role="modify">src/server/api/Sprk.Bff.Api/Services/Signals/SignalReevaluationJob.cs</file>
      <file role="canonical-reference">projects/spaarke-ontology-platform-r1/notes/schema-draft.md</file>
    </relevant-files>
  </context>

  <constraints>
    <constraint source="project">Scope: a Signal whose communication has simply AGED OUT of the window closes as ConditionCleared. The condition genuinely no longer holds. Do NOT add a separate expired resolution type: that would split a closed set over an axis nothing reads.</constraint>
    <constraint source="project">Scope: for ConditionCleared, Superseded and PolicyRetired, sprk_signal.sprk_decisionrecord stays NULL. Nobody decided anything; the pass closed it. This is the ONLY remaining reason that column is nullable.</constraint>
    <constraint source="project">Scope: an auto-closure must NEVER count as a human dismissal. The three-dismissal suppression rule is wrong in both directions if it does.</constraint>
    <constraint source="project">Scope: if this task changes src/server/api/Sprk.Bff.Api, state the Placement Justification in the PR citing .claude/constraints/bff-extensions.md, and measure publish size against a FRESH build of master from a short path with file counts compared on both sides. Ceiling 60 MB.</constraint>
    <constraint source="ADR-038">Scope: any test this task adds that asserts a Dataverse column list, entity name or option-set value must be paired with something touching the real schema. A consistently throwing path is a defect to diagnose, never noise to tolerate.</constraint>
  </constraints>

  <knowledge>
    <topic>Signal lifecycle and resolution semantics</topic>
    <files>
      <file>.claude/constraints/bff-extensions.md</file>
      <file>.claude/adr/ADR-013-ai-architecture.md</file>
      <file>.claude/adr/ADR-052-workload-placement.md</file>
      <file>docs/architecture/DATAVERSE-WRITE-PATH-ARCHITECTURE.md</file>
      <file>.claude/adr/ADR-002-thin-plugins.md</file>
      <file>docs/architecture/DATAVERSE-WRITE-PATH-ARCHITECTURE.md</file>
      <file>projects/spaarke-ontology-platform-r1/notes/schema-draft.md</file>
      <file>projects/spaarke-ontology-platform-r1/notes/security-roles.md</file>
      <file>projects/spaarke-ontology-platform-r1/spec.md</file>
      <file>projects/spaarke-ontology-platform-r1/design.md</file>
      <file>docs/adr/ADR-038-testing-strategy.md</file>
      <file>docs/standards/TEST-ARCHITECTURE.md</file>
    </files>
  </knowledge>

  <steps mode="directional">
    <step order="0" name="Context + rigor declaration">Declare the rigor level and reason per root CLAUDE.md section 8, then load the knowledge files above before touching code.</step>
    <step order="1">Implement ConditionCleared when the predicate no longer holds, including the aged-out case.</step>
    <step order="2">Implement Superseded when a newer policy version is in force and the Signal cites the older one.</step>
    <step order="3">Implement PolicyRetired when the policy is disabled or deleted.</step>
    <step order="4">Set sprk_resolvedon and leave sprk_resolvedby and sprk_decisionrecord null for all three, since no human acted.</step>
    <step order="5">Add tests for each, plus a test asserting an auto-closure does not increment the dismissal counter.</step>
    <step order="6">Update tasks/TASK-INDEX.md: set this task to the completed marker, AND set this POML status element to completed. Both, or scripts/check-task-status-drift.ps1 fails the next push.</step>
    <step order="7">Record any deviation from this POML in projects/spaarke-ontology-platform-r1/notes/.</step>
  </steps>

  <escalation>
    <trigger>If a Signal needs closing for a reason none of the three covers, STOP and escalate rather than adding a fourth value. The option set is closed and adding to it is a schema change plus a code change with review.</trigger>
  </escalation>

  <tools>
    <tool name="dotnet">Build and test .NET</tool>
  </tools>

  <outputs>
    <output type="code">src/server/api/Sprk.Bff.Api/Services/Signals/SignalReevaluationJob.cs</output>
    <output type="test">tests/unit/Sprk.Bff.Api.Tests/Services/Signals</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">Given an open Signal whose communication aged out of the window, when the pass runs, then it closes as ConditionCleared.</criterion>
    <criterion testable="true">Given an open Signal citing a superseded policy version, when the pass runs, then it closes as Superseded.</criterion>
    <criterion testable="true">Given a disabled policy, when the pass runs, then its open Signals close as PolicyRetired.</criterion>
    <criterion testable="true">Negative: for all three system closures, sprk_decisionrecord is null and sprk_resolvedby is null.</criterion>
    <criterion testable="true">Negative: an auto-closure does NOT increment the dismissal counter used by suppression.</criterion>
    <criterion testable="true">All tests pass; the BFF builds.</criterion>
  </acceptance-criteria>

  <notes>spec.md FR-16. design.md section 8.3 closing note covers the aged-out mapping.</notes>

  <execution><skill>.claude/skills/task-execute/SKILL.md</skill></execution>
</task>
