<task id="233" project="spaarke-ontology-platform-r1">
  <metadata>
    <title>A system-closed (ConditionCleared) Decision Record derives its privilege flag with WorkItemPrivilege, app-only (#3275, DI-177)</title>
    <phase>13 Deferred-issue triage group D (R1 close-out)</phase>
    <gate>startable</gate>
    <status>pending</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies BFF code (.cs).</rigor-reason>
    <model-tier>opus</model-tier>
    <model-tier-reason>Privilege flag on an append-only record; the job runs app-only, so the read identity must not widen what the flag reveals.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>group-d-2026-11-27</parallel-group>
    <parallel-safe>true</parallel-safe>
    <parallel-reason>SignalReevaluationJob ConditionCleared write and its tests; 234 and 235 touch other files.</parallel-reason>
