<task id="204" project="spaarke-ontology-platform-r1">
  <metadata>
    <title>The nightly D-170 close reads every not-in-force policy (paged) and reports a truncated read, instead of silently stopping at 5,000 (DI-162)</title>
    <phase>12 Create-wizard lookups and composer (185 dev check fixes)</phase>
    <gate>startable</gate>
