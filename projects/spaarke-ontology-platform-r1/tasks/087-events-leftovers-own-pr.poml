<task id="087" project="spaarke-ontology-platform-r1">
  <metadata>
    <title>Events and EventsPage migration leftovers, own PR (C-2, C-24, C-25)</title>
    <phase>8 Remaining cleanup and repairs</phase>
    <gate>startable</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies .ts/.tsx source and deletes code; quality gates apply.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Well-specified cleanup with named files and a verification path.</model-tier-reason>
    <effort>high</effort>
