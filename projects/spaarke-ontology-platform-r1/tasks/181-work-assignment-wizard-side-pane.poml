<task id="181" project="spaarke-ontology-platform-r1">
  <metadata>
    <title>Work Assignment wizard: Assigned Attorney / Paralegal / Law Firm / Law Firm Attorney / Assigned To use the side-pane lookup</title>
    <phase>12 Create-wizard lookups and composer (UAT round 4)</phase>
    <gate>after 178</gate>
    <status>in-progress</status>
