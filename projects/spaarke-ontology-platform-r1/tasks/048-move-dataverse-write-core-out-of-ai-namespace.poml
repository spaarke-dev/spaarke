<task id="048" project="spaarke-ontology-platform-r1">
  <metadata>
    <title>D-66: move the shared Dataverse write core (OwnedChildWrite + helpers) out of Services/Ai to Services/Dataverse, own PR reviewed by uac-r2</title>
    <phase>3 Decision Record + commit route</phase>
    <gate>startable after uac-r2 replies on #1355 (no objection / timing)</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Moves BFF code owned by another project (uac-r2); namespaces, DI, ArchTests.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <effort>high</effort>
    <parallel-group>C</parallel-group>
    <parallel-safe>true</parallel-safe>
    <parallel-reason>Own worktree off origin/master; own PR.</parallel-reason>
