<task id="224" project="spaarke-ontology-platform-r1">
  <metadata>
    <title>Deleted-rule evidence redaction covers every empty-lookup Signal over successive nights instead of re-reading the same first 100,000 (#2085, DI-116)</title>
    <phase>12 Create-wizard lookups and composer (185 dev check fixes)</phase>
    <gate>startable</gate>
    <status>completed</status>
