<task id="201" project="spaarke-ontology-platform-r1">
  <metadata>
    <title>Ontology admin Rules list: the Rule cell clips the rule code and name (fixed 44 px row, too narrow a column)</title>
    <phase>12 Create-wizard lookups and composer (185 dev check fixes)</phase>
    <gate>startable</gate>
    <status>in-progress</status>
