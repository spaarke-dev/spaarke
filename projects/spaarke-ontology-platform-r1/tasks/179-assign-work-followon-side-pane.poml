<task id="179" project="spaarke-ontology-platform-r1">
  <metadata>
    <title>Assign Work follow-on: Assigned Attorney / Paralegal / Outside Counsel use the side-pane lookup (F-R4-2)</title>
    <phase>12 Create-wizard lookups and composer (UAT round 4)</phase>
    <gate>after 178</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies shared client code (.ts/.tsx) used by several wizards.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Wiring an existing component through one config field into one step, with an exact reference (CreateProjectStep.tsx).</model-tier-reason>
    <effort>high</effort>
    <parallel-group>M</parallel-group>
    <parallel-safe>true</parallel-safe>
    <deps>178</deps>
