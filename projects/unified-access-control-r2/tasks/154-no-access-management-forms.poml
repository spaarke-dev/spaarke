    <patterns>
      <pattern name="lookup chip + native lookup pane" location="src/client/shared/Spaarke.UI.Components/src/components/LookupField/DataverseLookupField.tsx">The visual and interaction anchor for the picker: a "Select" button opening Xrm.Utility.lookupObjects, a dismissible chip when set, tokens only.</pattern>
