  <ui-tests>
    <test name="A Full Access contact grants a colleague in their own organization">
      <steps>
        <step>In the external SPA, signed in as a CIAM test contact holding Full Access on a project, open the project and choose Invite / Grant Access for another contact of the same organization at Collaborate.</step>
      </steps>
      <expected>The colleague appears in the project's access list at Collaborate with an expiry (default +90 days) and "granted by" showing the contact; the colleague can open the project after sign-in.</expected>
    </test>
    <test name="A View Only contact cannot grant">
      <steps>
        <step>Sign in to the external SPA as a contact holding View Only on a project.</step>
      </steps>
      <expected>The grant/invite action is not offered (or is disabled with the reason); calling the route directly returns the documented refusal.</expected>
    </test>
    <test name="Out-of-organization, above-level and organization-wide grants are refused">
      <steps>
        <step>As a Collaborate contact, try to grant (a) a contact of another organization, (b) Full Access, (c) the whole organization.</step>
      </steps>
      <expected>(a) and (c) are refused with the server's message; (b) is refused or capped exactly as the POML specifies, with the message shown. No grant row is written for a refusal.</expected>
    </test>
  </ui-tests>
  <amendments>
    <amendment n="R3" date="2026-09-30" source="owner round 3 (session27 note) — BINDING">(A1) The grantor-level cap for contact-issued grants is awaiting owner confirmation (the owner questioned rule 1 in round 3) — keep it as an escalation trigger until answered; the View-only-cannot-grant rule is unaffected.</amendment>
  </amendments>
  <amendments>
    <amendment n="R3b" date="2026-10-01" source="owner round 3b (session27 note) — BINDING">A1 SETTLED: contact-issued grants are capped at the contact grantor's own level (owner round 3b). The R3 escalation on the cap is resolved.</amendment>
  </amendments>
