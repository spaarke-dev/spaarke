    <patterns>
      <pattern name="route-value record check, miss denies" location="src/server/api/Sprk.Bff.Api/Api/Filters/RecordRouteAccessAuthorizationFilter.cs:79-233">Route {entityLogicalName}/{recordId} → TryResolveEntitySet → CallerRecordAccessProbe → OperationAccessPolicy.HasRequiredRights → 403.</pattern>
      <pattern name="body-scoped session ownership, same answer as not-found" location="src/server/api/Sprk.Bff.Api/Api/ComposeActiveDocumentEndpoints.cs:95-124">GetSessionAsync under the claim tenant; OwnerOid != caller → treat as not found.</pattern>
      <pattern name="check as the user, create as the app" location="src/server/api/Sprk.Bff.Api/Api/Filters/FinanceAuthorizationFilter.cs (FinanceCheckPath.Privilege, CreateInvoicePrivilege :237)">CallerHoldsPrivilegeAsync before an app-only, team-owned create.</pattern>
      <pattern name="OBO SPE visibility probe" location="src/server/api/Sprk.Bff.Api/Services/Compose/ComposePdfIntakeCoordinator.cs:358">GetFileMetadataAsUserAsync; null means "this caller cannot see it".</pattern>
      <pattern name="caller-context Dataverse read" location="src/server/api/Sprk.Bff.Api/Api/Office/CommunicationsEndpoints.cs (task 127)">IDataverseUserClient under the caller's security context; a denial surfaces as empty or 404.</pattern>
      <pattern name="derive the container from the authorized record" location="src/server/api/Sprk.Bff.Api/Api/ExternalAccess/ExternalProjectDataEndpoints.cs:625-650">ResolveForRecordAsync("sprk_project", id); refuse Unresolved/FailClosed; catch SdapProblemException.</pattern>
      <pattern name="in-process contract host over the real endpoint mapper" location="tests/integration/contract/Api/Finance/FinanceRollupEndpointsContractTests.cs:85-183">Minimal WebApplication, fake auth scheme, real Map*Endpoints.</pattern>
      <pattern name="dead-route absence guard" location="tests/integration/regression/DriveKeyedWriteRouteRetirementTests.cs">Maps the real endpoints and asserts a retired route is gone.</pattern>
