<task id="043" project="unified-access-control-r2">
  <metadata>
    <title>FR-24/FR-25 — org-expansion membership term (registry-filtered, baseline-levelled) + registry filter on the systemuser fallback path</title>
    <phase>2 One definition of member</phase>
    <gate>after-037-041-042</gate>
    <status>completed</status>
