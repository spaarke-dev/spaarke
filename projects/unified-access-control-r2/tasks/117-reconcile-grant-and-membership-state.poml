<task id="117" project="unified-access-control-r2">
  <metadata>
    <title>Make a row's own state the truth — ONE scheduled reconciliation job over external grants and org memberships (D-1 option B + ISS-026 write half + ISS-020 part 4)</title>
    <phase>Register-driven (authored 2026-09-19 after the 2026-09-18/19 owner decisions)</phase>
    <gate>startable</gate>
    <status>pending</status>
    <rigor>FULL</rigor>
    <rigor-reason>New .cs on the authorization data path; tags bff-api/auth/dataverse. It WRITES rows that decide who has access.</rigor-reason>
    <model-tier>opus</model-tier>
    <model-tier-reason>Security-sensitive (tags auth) and it REMOVES live access; three reconciliation rules with inverted fail directions relative to the read path.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
