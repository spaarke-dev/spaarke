<task id="026" project="unified-access-control-r2">
  <metadata>
    <title>Schema-truth doc repair: views-schema.md, the inverted expiry claim, the undocumented delegation rule (M4, M5)</title>
    <phase>0 Enforcement Remediation</phase>
    <status>pending</status>
    <rigor>MINIMAL</rigor>
    <rigor-reason>Documentation only -- no code, no tests.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Mechanical correction against live metadata; no design judgment.</model-tier-reason>
    <effort>medium</effort>
    <parallel-group>none</parallel-group>
