<task id="134" project="unified-access-control-r2">
  <metadata>
    <title>C6 — a per-module COLUMN allow-list on the external module read seam: /fetch and /record stop returning SPE pointers and internal/FLS columns inside granted scope</title>
    <phase>Register-driven (authored 2026-09-30, session 27; contact-plane group, defect C6)</phase>
    <gate>startable</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
