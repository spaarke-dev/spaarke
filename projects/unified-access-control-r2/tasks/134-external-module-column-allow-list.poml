    <model-tier>opus</model-tier>
    <model-tier-reason>Security-sensitive (the route executes caller-authored FetchXML app-only, which bypasses field-level security); getting the allow-list wrong either leaks or silently blanks every outside-counsel grid.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
