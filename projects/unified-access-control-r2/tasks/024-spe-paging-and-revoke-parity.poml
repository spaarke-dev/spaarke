<task id="024" project="unified-access-control-r2">
  <metadata>
    <title>SPE honesty: Graph paging (M1) + /revoke status parity with closure (M2)</title>
    <phase>0 Enforcement Remediation</phase>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies .cs on the SPE membership read path that task 016's closure guard depends on.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Graph paging is a known mechanical pattern; the status-parity half is a small contract alignment.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>Touches Infrastructure/ExternalAccess/SpeContainerMembershipService.cs -- owned by tasks 016/017.</parallel-reason>
