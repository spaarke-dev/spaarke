  <ui-tests>
    <test name="Restricted keeps + User and blocks contact grants">
      <steps>
        <step>At https://{org}.crm.dynamics.com, as a non-admin test user with Write on a non-secure project, set Access Permission to Restricted and save.</step>
        <step>Open Manage Access.</step>
      </steps>
      <expected>"+ User" is enabled; "+ Contact" and "+ Organization" are disabled and show the reason (record is Restricted). The banner and the enabled controls agree.</expected>
    </test>
    <test name="Limited hides organization-wide and standing grants">
      <steps>
        <step>Set Access Permission to Limited on a project and open Manage Access.</step>
      </steps>
      <expected>Only named direct grants can be added ("+ Contact", "+ User"); "+ Organization" is disabled with the reason. Existing organization grants are listed as having no effect on this record.</expected>
    </test>
    <test name="A refused grant shows the server's message">
      <steps>
        <step>On a Restricted record, submit a contact grant through any remaining path (e.g. a stale modal opened before the change).</step>
      </steps>
      <expected>The modal shows the server's reason (record_restricted), not a generic error, and no grant appears in Current Access.</expected>
    </test>
  </ui-tests>
</task>
