      <file role="modify">tests/integration/auth/UnifiedAccessControl/GrantLifecycleCharacterizationTests.cs</file>
      <file role="canonical-reference">src/server/api/Sprk.Bff.Api/Api/ExternalAccess/SetRecordShareExpiryEndpoint.cs:190-234 (the concurrent writer, and the all-or-nothing honesty wording to mirror when an outcome is unknown)</file>
      <file role="canonical-reference">src/server/api/Sprk.Bff.Api/Api/ExternalAccess/RevokeExternalAccessEndpoint.cs:152 (the other DeactivateAsync caller — the ripple surface)</file>
