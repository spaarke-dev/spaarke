<task id="118" project="unified-access-control-r2">
  <metadata>
    <title>Ask the server's question — re-point the Manage Access gate off table-level Create onto Write-on-record, fail CLOSED, then retire Create from human roles (D-1 option C)</title>
    <phase>Register-driven (authored 2026-09-19 after the 2026-09-19 owner decision)</phase>
    <gate>startable</gate>
    <status>pending</status>
    <rigor>FULL</rigor>
