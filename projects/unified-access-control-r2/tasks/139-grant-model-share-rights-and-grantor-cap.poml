  <ui-tests>
    <test name="A Collaborate sharee can use the native Share command">
      <steps>
        <step>As the owner, share a secure project to a second non-admin test user at Collaborate through "+ User".</step>
        <step>Sign in as that user at https://{org}.crm.dynamics.com and open the project.</step>
      </steps>
      <expected>The model-driven Share command is available and succeeds for View Only or Collaborate; Manage Access is also enabled for them.</expected>
    </test>
    <test name="A grant above the grantor's level is capped and reported">
      <steps>
        <step>As a user holding Collaborate (no Delete) on a record, open Manage Access and grant a contact Full Access.</step>
      </steps>
      <expected>The grant is written at Collaborate and the modal says it was capped at your own level; Current Access shows Collaborate.</expected>
    </test>
    <test name="A View Only sharee cannot grant">
      <steps>
        <step>Sign in as a user holding only View Only on a record and open it.</step>
      </steps>
      <expected>Manage Access is disabled (not hidden) with the reason; the native Share command is unavailable.</expected>
    </test>
  </ui-tests>
