<task id="085" project="unified-access-control-r2">
  <metadata>
    <title>POST /api/office/save — take the container from the server, not from SaveRequest.ContainerId</title>
    <phase>0c Secure Documents — Wave 2 (container-selection sweep follow-on)</phase>
