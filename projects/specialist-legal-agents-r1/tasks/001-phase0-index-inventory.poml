<?xml version="1.0" encoding="UTF-8"?>
<task id="001" project="specialist-legal-agents-r1">
  <metadata>
    <title>Phase 0 index and artifact inventory</title>
    <phase>1 Test kits, content and desk items</phase>
    <gate>startable</gate>
    <status>completed</status>
    <rigor>MINIMAL</rigor>
    <rigor-reason>Documentation and inventory/checklist creation only</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Documentation / test-kit authoring against an explicit spec and the phase0/g8 reference</model-tier-reason>
    <effort>medium</effort>
    <parallel-group>A</parallel-group>
    <parallel-safe>true</parallel-safe>
    <deps>none</deps>
    <tags>ai, devops</tags>
    <estimated-effort>1-2 hours</estimated-effort>
  </metadata>

  <prompt>Create phase0/README.md: the index of every Phase 0 test folder and the artifact inventory that FR-01 and FR-14 track, so every tenant artifact has an owner row and a removal date from the start.</prompt>
  <role>SPAARKE platform developer. Follow ADRs strictly. Writes precise test-programme documentation.</role>
  <goal>projects/specialist-legal-agents-r1/phase0/README.md exists with (1) a test index table (G1-NDA, G1-PAT, G2, G3, G5, G6, patents, desk items) linking each folder and its task id, and (2) an artifact inventory table with the columns artifact, kind, owner project, scope, R4 row sent (date), installed (date), removal date, removal status.</goal>

  <context>
    <background>Spec FR-01 (inventory before upload) and FR-14 (no orphans). The existing G8 artifacts and their 2026-11-30 removal date are listed in current-task.md "Next action" item 1.</background>
    <relevant-files>
      <file role="new">projects/specialist-legal-agents-r1/phase0/README.md</file>
      <file role="canonical-reference">projects/specialist-legal-agents-r1/phase0/g8/README.md</file>
      <file role="canonical-reference">projects/specialist-legal-agents-r1/current-task.md</file>
      <file role="canonical-reference">projects/specialist-legal-agents-r1/spec.md</file>
    </relevant-files>
    <dependencies>
      <dependency task="none" status="complete">No prerequisite task</dependency>
    </dependencies>
  </context>

  <constraints>
    <constraint source="project">This task uploads, installs or changes nothing in the Microsoft 365 tenant, Dataverse, Azure or the dev BFF; it writes only files under projects/specialist-legal-agents-r1/.</constraint>
    <constraint source="project">Files are written only under the output paths listed in this task; no file under .claude/, src/, tests/ or another project folder is changed on work/specialist-legal-agents-r1.</constraint>
  </constraints>

  <knowledge>
    <files>
      <file>projects/specialist-legal-agents-r1/CLAUDE.md</file>
      <file>projects/specialist-legal-agents-r1/spec.md</file>
      <file>projects/specialist-legal-agents-r1/phase0/g8/README.md</file>
      <file>.claude/constraints/ai.md</file>
      <file>.claude/patterns/ai/streaming-endpoints.md</file>
    </files>
  </knowledge>

  <steps mode="directional">
    <step order="1">Read spec.md FR-01 to FR-14 and phase0/g8/README.md</step>
    <step order="2">Write the test index: one row per test folder (g1-nda, g1-pat, g2, g3, g5, g6, patents) plus notes/phase0-desk-items.md and phase0/G1-decision.md, each with its task id from tasks/TASK-INDEX.md</step>
    <step order="3">Write the artifact inventory with the eight columns in the goal; pre-fill the G8 artifacts from current-task.md with removal date 2026-11-30 and status "owner removal pending"</step>
    <step order="4">Add a short "How to add an artifact" rule: a row is added and the R4 row sent before any upload</step>
    <step order="5">Update tasks/TASK-INDEX.md: change this task's status cell to `✅ [done]` (the bracketed token is mandatory) and set the POML &lt;status&gt; to completed; run pwsh scripts/check-task-status-drift.ps1</step>
    <step order="6">Record any deviation from the plan in projects/specialist-legal-agents-r1/notes/decisions.md (one dated line)</step>
  </steps>

  <tools>
    <tool name="terminal">Run shell commands (git show for read-only accelerator content)</tool>
  </tools>

  <outputs>
    <output type="docs">projects/specialist-legal-agents-r1/phase0/README.md</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">phase0/README.md lists all seven test folders, the desk-items note and the decision record, each with its task id.</criterion>
    <criterion testable="true">The inventory table has exactly the eight columns named in the goal.</criterion>
    <criterion testable="true">Every G8 artifact named in current-task.md appears in the inventory with removal date 2026-11-30.</criterion>
    <criterion testable="true">Negative: no row claims an artifact is installed or removed that this task did not observe; such cells read "unknown".</criterion>
  </acceptance-criteria>

  <notes>See spec.md for the FR this task implements.</notes>

  <execution>
    <skill>.claude/skills/task-execute/SKILL.md</skill>
    <protocol>Before starting, load all files listed in &lt;knowledge&gt;&lt;files&gt;. Follow task-execute for the pre-execution checklist.</protocol>
  </execution>
</task>
