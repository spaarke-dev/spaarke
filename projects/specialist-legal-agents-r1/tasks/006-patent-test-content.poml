<?xml version="1.0" encoding="UTF-8"?>
<task id="006" project="specialist-legal-agents-r1">
  <metadata>
    <title>Patent test content, drafting skill and patent kits</title>
    <phase>1 Test kits, content and desk items</phase>
    <gate>startable</gate>
    <status>completed</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>Creates new files (test kit) with explicit project constraints</rigor-reason>
    <model-tier>opus</model-tier>
    <model-tier-reason>Domain judgment: patent drafting standards must be distinct, realistic and testable from output, with no attorney review in Phase 0</model-tier-reason>
    <effort>high</effort>
    <parallel-group>A</parallel-group>
    <parallel-safe>true</parallel-safe>
    <deps>none</deps>
    <tags>ai, testing</tags>
    <estimated-effort>3-4 hours</estimated-effort>
  </metadata>

  <prompt>Write the minimal patent test content: two test profiles differing on at least five drafting standards, about five test disclosures drawn from published patents, a short drafting SKILL.md, and the kits for the Cowork drafting spike (FR-10) and G1-PAT (FR-11).</prompt>
  <role>SPAARKE platform developer. Follow ADRs strictly. Expert in US patent application drafting conventions (claims, specification, terminology).</role>
  <goal>projects/specialist-legal-agents-r1/phase0/patents/ holds profiles/patent-profile-a.json and -b.json (status: test), disclosures/disclosure-01.md to -05.md each citing its source publication number, skill/SKILL.md, and README.md; projects/specialist-legal-agents-r1/phase0/g1-pat/README.md holds the G1-PAT kit; the drafting-spike kit is a section of phase0/patents/README.md.</goal>

  <context>
    <background>Spec FR-09, FR-10, FR-11; OD-2 (patent attorney is the first archetype). Content is not attorney-approved; the owner judges the drafting spike. G1-PAT repeats only variants (a)/(b) still in contention, with no patent server-side tool.</background>
    <relevant-files>
      <file role="new">projects/specialist-legal-agents-r1/phase0/patents/README.md</file>
      <file role="new">projects/specialist-legal-agents-r1/phase0/patents/profiles/patent-profile-a.json</file>
      <file role="new">projects/specialist-legal-agents-r1/phase0/patents/profiles/patent-profile-b.json</file>
      <file role="new">projects/specialist-legal-agents-r1/phase0/patents/disclosures/disclosure-01.md</file>
      <file role="new">projects/specialist-legal-agents-r1/phase0/patents/skill/SKILL.md</file>
      <file role="new">projects/specialist-legal-agents-r1/phase0/g1-pat/README.md</file>
      <file role="canonical-reference">projects/specialist-legal-agents-r1/design.md</file>
    </relevant-files>
    <dependencies>
      <dependency task="none" status="complete">No prerequisite task</dependency>
    </dependencies>
  </context>

  <constraints>
    <constraint source="project">Every file this task writes is synthetic or drawn from public sources. No file, prompt or package written by this task quotes, copies, links or names a path under `answer-key/`, or contains text from the real NDAs (Corteva, RPX/Helios); check each written file against the `FORBIDDEN_IN_PACKAGE` list in `origin/work/spaarke-legal-ai-accelerator-r1:src/accelerators/build/gates.py` (NFR-02).</constraint>
    <constraint source="project">This task uploads, installs or changes nothing in the Microsoft 365 tenant, Dataverse, Azure or the dev BFF; it writes only files under projects/specialist-legal-agents-r1/.</constraint>
    <constraint source="project">Files are written only under the output paths listed in this task; no file under .claude/, src/, tests/ or another project folder is changed on work/specialist-legal-agents-r1.</constraint>
    <constraint source="project">Pass rules are applied exactly as spec FR-04/FR-06 state them: pilot of 10 cases per variant and surface; a variant below 90% in its pilot stops; survivors get the full run; G1 pass = at least 95% adherence on both surfaces, 0 ratchet escapes, 0 cross-profile bleed; G5 pass = at least 95% routing, 0 functions invoked on controls.</constraint>
    <constraint source="project">Each disclosure is a summary written in this task from a published patent or application (public record); it records the publication number; it contains no confidential or client material and does not reproduce the patent's claims verbatim.</constraint>
  </constraints>

  <knowledge>
    <files>
      <file>projects/specialist-legal-agents-r1/CLAUDE.md</file>
      <file>projects/specialist-legal-agents-r1/spec.md</file>
      <file>projects/specialist-legal-agents-r1/phase0/g8/README.md</file>
      <file>.claude/constraints/ai.md</file>
      <file>.claude/patterns/ai/streaming-endpoints.md</file>
      <file>projects/specialist-legal-agents-r1/design.md</file>
    </files>
  </knowledge>

  <steps mode="directional">
    <step order="1">Choose five drafting standards that differ between the profiles and are observable in a draft (for example claim structure, independent-claim count, means-plus-function use, terminology conventions, background length); state for each how a reviewer checks it</step>
    <step order="2">Write patent-profile-a.json and -b.json (status: test, profileVersion, the standards, model tier, systemuserid: "TO-BE-SET-BY-011")</step>
    <step order="3">Write five disclosures, each an invention summary based on a published patent with its publication number</step>
    <step order="4">Write skill/SKILL.md: a short drafting skill that tells the agent to fetch the caller profile and draft one section to its standards</step>
    <step order="5">Write the drafting-spike kit in patents/README.md (draft one section per profile; owner judges pass/fail per standard) and the G1-PAT kit in phase0/g1-pat/README.md (FR-04 measurement on patents, variants still in contention only)</step>
    <step order="6">Update tasks/TASK-INDEX.md: change this task's status cell to `✅ [done]` (the bracketed token is mandatory) and set the POML &lt;status&gt; to completed; run pwsh scripts/check-task-status-drift.ps1</step>
    <step order="7">Record any deviation from the plan in projects/specialist-legal-agents-r1/notes/decisions.md (one dated line)</step>
  </steps>

  <escalation>
    <trigger>If an input this task depends on differs from what spec.md states (a file, an Action row, a tool contract), STOP and escalate per root CLAUDE.md §6 rather than adapting the design.</trigger>
    <trigger>If a chosen source patent cannot be identified by a publication number, do not use it.</trigger>
  </escalation>
  <tools>
    <tool name="terminal">Run shell commands (git show for read-only accelerator content)</tool>
  </tools>

  <outputs>
    <output type="data">projects/specialist-legal-agents-r1/phase0/patents/</output>
    <output type="docs">projects/specialist-legal-agents-r1/phase0/g1-pat/README.md</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">The two patent profiles differ on at least five standards, and each difference names how it is checked in a draft.</criterion>
    <criterion testable="true">Five disclosure files exist, each with a source publication number and status: test.</criterion>
    <criterion testable="true">skill/SKILL.md exists and names the profile tool it expects (spike_get_profile).</criterion>
    <criterion testable="true">phase0/g1-pat/README.md applies the FR-04 thresholds and states that only variants still in contention after G1-NDA are repeated.</criterion>
    <criterion testable="true">Negative: no file contains confidential or client material, or claims copied verbatim from a source patent.</criterion>
  </acceptance-criteria>

  <notes>See spec.md for the FR this task implements.</notes>

  <execution>
    <skill>.claude/skills/task-execute/SKILL.md</skill>
    <protocol>Before starting, load all files listed in &lt;knowledge&gt;&lt;files&gt;. Follow task-execute for the pre-execution checklist.</protocol>
  </execution>
</task>
