<?xml version="1.0" encoding="UTF-8"?>
<task id="020" project="specialist-legal-agents-r1">
  <metadata>
    <title>Test agent packages for G1, G5 and G2</title>
    <phase>3 Test runs</phase>
    <gate>after 002, 004 and 015</gate>
    <status>not-started</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>Phase 3 integration testing with explicit constraints</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Run coordination and scoring against a written kit and pass rule</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>Packages feed every Phase 3 run; serial before them</parallel-reason>
    <deps>002,004,015</deps>
    <tags>ai, deploy</tags>
    <estimated-effort>3-4 hours</estimated-effort>
  </metadata>

  <prompt>Build the coded declarative-agent test packages for G1 variants (a), (b), (c), the G5 three-function area agent and the G2 SKILL.md variant, following build rules BR-1 to BR-7; send each R4 row; the owner uploads.</prompt>
  <role>SPAARKE platform developer. Follow ADRs strictly. Expert in Microsoft 365 Copilot declarative agents and MCP actions.</role>
  <goal>projects/specialist-legal-agents-r1/phase0/g1-nda/packages/, projects/specialist-legal-agents-r1/phase0/g5/package/ and projects/specialist-legal-agents-r1/phase0/g2/package/ hold the package sources and zips; every package has an R4 row sent and quoted, and the inventory in phase0/README.md is updated.</goal>

  <context>
    <background>Spec FR-01, FR-04 variants, FR-06, FR-08. Build rules in notes/agent-package-identity-and-distribution.md (fresh app id per action change; dynamic discovery by default, BR-5). The G8 packages in phase0/g8/ are the reference.</background>
    <relevant-files>
      <file role="new">projects/specialist-legal-agents-r1/phase0/g1-nda/packages/</file>
      <file role="new">projects/specialist-legal-agents-r1/phase0/g5/package/</file>
      <file role="new">projects/specialist-legal-agents-r1/phase0/g2/package/</file>
      <file role="canonical-reference">projects/specialist-legal-agents-r1/phase0/g8/package-p2-v2-dd/</file>
      <file role="canonical-reference">.claude/skills/declarative-agent/SKILL.md</file>
      <file role="modify">projects/specialist-legal-agents-r1/phase0/README.md</file>
    </relevant-files>
    <dependencies>
      <dependency task="002" status="pending">Prerequisite task output</dependency>
      <dependency task="004" status="pending">Prerequisite task output</dependency>
      <dependency task="015" status="pending">Prerequisite task output</dependency>
    </dependencies>
  </context>

  <constraints>
    <constraint source="project">Before the owner uploads or installs any tenant artifact named in this task, its R4 inventory row (artifact, owner project, scope = owner + test user, removal plan, removal date) is sent to COPILOT-PLATFORM-COORDINATION (Issue #3006) and quoted in the test README (FR-01, R7).</constraint>
    <constraint source="project">Tenant and admin-center actions (uploads, installs, switch-ons, removals), Dataverse writes and BFF deploys in this task are done by the owner or on the owner's explicit go in chat; the agent prepares instructions and records results.</constraint>
    <constraint source="project">Every file this task writes is synthetic or drawn from public sources. No file, prompt or package written by this task quotes, copies, links or names a path under `answer-key/`, or contains text from the real NDAs (Corteva, RPX/Helios); check each written file against the `FORBIDDEN_IN_PACKAGE` list in `origin/work/spaarke-legal-ai-accelerator-r1:src/accelerators/build/gates.py` (NFR-02).</constraint>
    <constraint source="ADR-028">Every package's MCP action uses the existing dedicated connector client and OAuth registration; registration A1 is never changed.</constraint>
    <constraint source="project">Each package uses a fresh app id (BR-2) and dynamic discovery (BR-5); variant (b) instructions stay at or under 8,000 characters.</constraint>
  </constraints>

  <knowledge>
    <files>
      <file>projects/specialist-legal-agents-r1/CLAUDE.md</file>
      <file>projects/specialist-legal-agents-r1/spec.md</file>
      <file>projects/specialist-legal-agents-r1/notes/agent-package-identity-and-distribution.md</file>
      <file>.claude/skills/declarative-agent/SKILL.md</file>
      <file>.claude/skills/dataverse-deploy/SKILL.md</file>
      <file>docs/guides/PCF-DEPLOYMENT-GUIDE.md</file>
      <file>.claude/constraints/ai.md</file>
      <file>.claude/patterns/ai/streaming-endpoints.md</file>
      <file>.claude/adr/ADR-028-spaarke-auth-architecture.md</file>
    </files>
  </knowledge>

  <steps mode="directional">
    <step order="1">Copy the G8 dynamic-discovery package as the template</step>
    <step order="2">Build one package per G1 variant (a, b, c) with instructions per the G1-NDA kit; build the G5 area agent with three functions; build the G2 variant with one SKILL.md</step>
    <step order="3">Run the FORBIDDEN_IN_PACKAGE check over every package</step>
    <step order="4">Add each package to the phase0/README.md inventory and send its R4 row to coordination; quote the row in the test README</step>
    <step order="5">Ask the owner to upload and install for the owner and the test user only</step>
    <step order="6">Update tasks/TASK-INDEX.md: change this task's status cell to `✅ [done]` (the bracketed token is mandatory) and set the POML &lt;status&gt; to completed; run pwsh scripts/check-task-status-drift.ps1</step>
    <step order="7">Record any deviation from the plan in projects/specialist-legal-agents-r1/notes/decisions.md (one dated line)</step>
  </steps>

  <escalation>
    <trigger>When the next step is a tenant click, a prompt run by the owner or test user, a Dataverse write or a deploy, STOP, write the exact instructions into the task README, and ask the owner in chat; do not perform or simulate it.</trigger>
    <trigger>If any input, sample or source this task would use contains or references answer-key/ or a real NDA, STOP: do not copy it, and escalate per root CLAUDE.md §6.</trigger>
  </escalation>
  <tools>
    <tool name="terminal">Run shell commands (git show for read-only accelerator content)</tool>
  </tools>

  <outputs>
    <output type="data">projects/specialist-legal-agents-r1/phase0/g1-nda/packages/</output>
    <output type="data">projects/specialist-legal-agents-r1/phase0/g5/package/</output>
    <output type="data">projects/specialist-legal-agents-r1/phase0/g2/package/</output>
    <output type="docs">projects/specialist-legal-agents-r1/phase0/README.md</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">Five packages exist (G1 a, b, c; G5; G2), each with a unique fresh app id.</criterion>
    <criterion testable="true">Each package passes the FORBIDDEN_IN_PACKAGE check (recorded).</criterion>
    <criterion testable="true">Every package has an R4 row sent before upload, quoted in its README, and an inventory row with a removal date.</criterion>
    <criterion testable="true">Variant (b) instructions are at most 8,000 characters.</criterion>
    <criterion testable="true">Negative: no package is uploaded by the agent; uploads are recorded as the owner's.</criterion>
  </acceptance-criteria>

  <notes>See spec.md for the FR this task implements.</notes>

  <execution>
    <skill>.claude/skills/task-execute/SKILL.md</skill>
    <protocol>Before starting, load all files listed in &lt;knowledge&gt;&lt;files&gt;. Follow task-execute for the pre-execution checklist.</protocol>
  </execution>
</task>
