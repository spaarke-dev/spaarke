  <metadata>
    <title>Phase 0 wrap-up</title>
    <phase>Wrap-up</phase>
    <gate>after all tasks</gate>
    <status>not-started</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>Project-close quality gates and documentation</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Checklist-driven wrap-up</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
