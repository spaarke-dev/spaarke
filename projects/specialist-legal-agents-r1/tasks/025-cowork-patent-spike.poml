<?xml version="1.0" encoding="UTF-8"?>
<task id="025" project="specialist-legal-agents-r1">
  <metadata>
    <title>Cowork patent-drafting spike</title>
    <phase>3 Test runs</phase>
    <gate>after 006</gate>
    <status>in-progress</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>Phase 3 integration testing with explicit constraints</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Run coordination and scoring against a written kit and pass rule</model-tier-reason>
    <effort>high</effort>
    <parallel-group>C</parallel-group>
    <parallel-safe>true</parallel-safe>
    <deps>006</deps>
    <tags>ai, testing</tags>
    <estimated-effort>3-4 hours</estimated-effort>
  </metadata>

  <prompt>With the drafting skill and each patent test profile in Cowork, draft one application section from a test disclosure; the owner judges each standard per profile.</prompt>
  <role>SPAARKE platform developer. Follow ADRs strictly. Expert in patent drafting evaluation.</role>
  <goal>projects/specialist-legal-agents-r1/phase0/patents/README.md records, per profile, the draft produced, the owner's pass/fail per standard, and whether the two drafts differ visibly on the differing standards.</goal>

  <context>
    <background>Spec FR-10. Cowork canvas output must be a usable Word document. The owner judges; no attorney review in Phase 0.</background>
    <relevant-files>
      <file role="modify">projects/specialist-legal-agents-r1/phase0/patents/README.md</file>
    </relevant-files>
    <dependencies>
      <dependency task="006" status="pending">Prerequisite task output</dependency>
    </dependencies>
  </context>

  <constraints>
    <constraint source="project">Tenant and admin-center actions (uploads, installs, switch-ons, removals), Dataverse writes and BFF deploys in this task are done by the owner or on the owner's explicit go in chat; the agent prepares instructions and records results.</constraint>
    <constraint source="project">Before the owner uploads or installs any tenant artifact named in this task, its R4 inventory row (artifact, owner project, scope = owner + test user, removal plan, removal date) is sent to COPILOT-PLATFORM-COORDINATION (Issue #3006) and quoted in the test README (FR-01, R7).</constraint>
    <constraint source="project">Every file this task writes is synthetic or drawn from public sources. No file, prompt or package written by this task quotes, copies, links or names a path under `answer-key/`, or contains text from the real NDAs (Corteva, RPX/Helios); check each written file against the `FORBIDDEN_IN_PACKAGE` list in `origin/work/spaarke-legal-ai-accelerator-r1:src/accelerators/build/gates.py` (NFR-02).</constraint>
    <constraint source="project">Files are written only under the output paths listed in this task; no file under .claude/, src/, tests/ or another project folder is changed on work/specialist-legal-agents-r1.</constraint>
  </constraints>

  <knowledge>
    <files>
      <file>projects/specialist-legal-agents-r1/CLAUDE.md</file>
      <file>projects/specialist-legal-agents-r1/spec.md</file>
      <file>projects/specialist-legal-agents-r1/phase0/g8/README.md</file>
      <file>.claude/constraints/ai.md</file>
      <file>.claude/patterns/ai/streaming-endpoints.md</file>
    </files>
  </knowledge>

  <steps mode="directional">
    <step order="1">Prepare the skill upload instructions and R4 row</step>
    <step order="2">Ask the owner to run the draft with profile A, then B, on the same disclosure</step>
    <step order="3">Record the owner's judgement per standard and whether the drafts differ</step>
    <step order="4">Update tasks/TASK-INDEX.md: change this task's status cell to `✅ [done]` (the bracketed token is mandatory) and set the POML &lt;status&gt; to completed; run pwsh scripts/check-task-status-drift.ps1</step>
    <step order="5">Record any deviation from the plan in projects/specialist-legal-agents-r1/notes/decisions.md (one dated line)</step>
  </steps>

  <escalation>
    <trigger>When the next step is a tenant click, a prompt run by the owner or test user, a Dataverse write or a deploy, STOP, write the exact instructions into the task README, and ask the owner in chat; do not perform or simulate it.</trigger>
  </escalation>
  <tools>
    <tool name="terminal">Run shell commands (git show for read-only accelerator content)</tool>
  </tools>

  <outputs>
    <output type="docs">projects/specialist-legal-agents-r1/phase0/patents/README.md</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">Both drafts are recorded (file reference) with the owner's pass/fail for each standard.</criterion>
    <criterion testable="true">The README states whether the drafts differ visibly on each differing standard.</criterion>
    <criterion testable="true">The skill upload has an R4 row quoted.</criterion>
  </acceptance-criteria>

  <notes>See spec.md for the FR this task implements.</notes>

  <execution>
    <skill>.claude/skills/task-execute/SKILL.md</skill>
    <protocol>Before starting, load all files listed in &lt;knowledge&gt;&lt;files&gt;. Follow task-execute for the pre-execution checklist.</protocol>
  </execution>
</task>
