<task id="052" project="spaarkeai-compose-r4">
  <metadata>
    <title>HTTP 423 (Office lock) → user-actionable ProblemDetails (FR-08)</title>
    <phase>5 Concurrency + save</phase>
    <gate>blocked</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>BFF implementation on the Compose endpoint + save path modifying .cs; failure-mapping correctness (423 vs generic 5xx); tags include bff-api + spe.</rigor-reason>
    <model-tier>sonnet</model-tier>
