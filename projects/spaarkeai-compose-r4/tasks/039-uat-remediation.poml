<task id="039" project="spaarkeai-compose-r4">
  <metadata>
    <title>UAT remediation — fix born-in-editor 2nd-save error (no-errors) + duplicate-records + UX polish</title>
    <phase>6 Hardening</phase>
    <gate>startable</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Fixes a hard save error on the born-in-editor save path (data-path, no-errors bar) + touches BFF endpoint validation + client save orchestration. High blast radius; FULL per root §8.</rigor-reason>
    <model-tier>opus</model-tier>
    <model-tier-reason>BUG A is a subtle save-baseline lifecycle fix (born-in-editor create→replace transition); getting the discriminant + server acceptance right without regressing the tracked stored-doc path needs opus judgment.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>Touches ComposeWorkspace.tsx save path + ComposeEndpoints.cs + ComposeFormatToolbar.tsx — the most-shared Compose surfaces; sequential.</parallel-reason>
