<task id="041" project="spaarkeai-compose-r4">
  <metadata>
    <title>Validate returned anchors before apply; fuzzy-as-comment last resort (FR-07, apply)</title>
    <phase>4 AI anchoring</phase>
    <gate>blocked</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
