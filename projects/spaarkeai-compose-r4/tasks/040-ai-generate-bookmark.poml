<task id="040" project="spaarkeai-compose-r4">
  <metadata>
    <title>Drift-proof AI anchoring — generate-window bookmark + resolve-on-return (FR-07, capture)</title>
    <phase>4 AI anchoring</phase>
    <gate>blocked</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Frontend + AI implementation modifying .ts/.tsx on the generate/apply path; subtle AI-correctness surface under concurrent edits; tags include frontend + ai + docx.</rigor-reason>
    <model-tier>opus</model-tier>
    <model-tier-reason>Drift-proofing under concurrent edits is the subtle AI-correctness surface — position rebasing via ProseMirror Mapping tied to a request id is easy to get subtly wrong; high blast radius on the AI generate path.</model-tier-reason>
    <effort>xhigh</effort>
    <parallel-group>W4</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>Modifies the client AI toolbar surface + the generate path shared with 041; step→operation interceptor (020) and the generate window overlap the same editor state.</parallel-reason>
    <deps>020,006</deps>
