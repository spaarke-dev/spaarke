<task id="050" project="spaarkeai-compose-r4">
  <metadata>
    <title>Version-stamp every save + re-anchor-on-stale (FR-08)</title>
    <phase>5 Concurrency + save</phase>
    <gate>blocked</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>BFF implementation on the ComposeService save path modifying .cs; brownfield concurrency correctness; tags include bff-api + docx + spe.</rigor-reason>
