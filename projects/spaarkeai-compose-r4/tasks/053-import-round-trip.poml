<task id="053" project="spaarkeai-compose-r4">
  <metadata>
    <title>Import round-trip — pre-existing Word revisions/comments render as first-class tracked changes/threads (FR-10)</title>
    <phase>5 Concurrency + save</phase>
    <gate>open</gate>
    <status>completed</status>
    <rigor>FULL</rigor>
    <rigor-reason>Frontend + BFF implementation modifying .ts/.tsx/.cs; a new editor mount surface for imported revisions/comments; tags include frontend + bff-api + docx.</rigor-reason>
