<task id="035" project="spaarkeai-compose-r4">
  <metadata>
    <title>Deploy patch-engine core to dev + publish-size/CVE/NetArch report</title>
    <phase>3 Patch Engine</phase>
    <gate>blocked</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>BFF deploy step with publish-size/CVE/NetArch gates and a `/conflict-check` on a contended service; tags include `deploy`. FULL per root §8.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Deploy + reporting against the `bff-deploy` skill; prescriptive sequence, no design judgment.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>Deploy step — mutates the dev environment; must be sequential after the cutover (032) + corpus proof (034).</parallel-reason>
    <deps>032,034</deps>
    <tags>bff-api,deploy</tags>
    <estimated-effort>0.5 day</estimated-effort>
