      <file>docs/standards/MODAL-DECISION-CRITERIA.md</file>
      <file>.claude/patterns/ui/record-modal-selection.md</file>
      <file>.claude/constraints/testing.md</file>
      <file>.claude/patterns/testing/unit-test-structure.md</file>
      <file>.claude/patterns/testing/mocking-patterns.md</file>
      <file>docs/adr/ADR-038-testing-strategy.md</file>
    </files>
  </knowledge>

  <steps mode="directional">
    <step order="0" name="Context + rigor declaration">Load the knowledge files, read the relevant files listed above, declare rigor and model tier per task-execute Step 0.5.</step>
    <step order="1">Draft the two field sets in the task notes; ask the owner to approve (proceed with the draft if the owner says so).</step>
    <step order="2">Create intakeRegistry (requestType → component, label) and intake-client (submit).</step>
    <step order="3">Build the two wizards on WizardShell with validation and a success screen linking to the Service Requests tab.</step>
    <step order="4">Change the nda-assessment and policy-question actions (and their More Services entries) to open the wizard instead of a widget.</step>
    <step order="5">Tests: card opens wizard; required fields block submit; submit posts the right requestType and answers; success screen; server 403 shows an error.</step>
    <step order="6">In src/client/external-spa run `npm run typecheck`, `npm run lint`, `npm test` and `npm run build` (all exit 0; install with `npm install --legacy-peer-deps --no-audit --no-fund` if node_modules is missing).</step>
    <step order="7">Update tasks/TASK-INDEX.md: set this task's status cell to `✅ [done]` and this POML's &lt;status&gt; to completed; run `pwsh scripts/check-task-status-drift.ps1`.</step>
    <step order="8">Record deviations, decisions and measurements in projects/spaarke-SPA-external-access-platform-r3/notes/task-052-notes.md.</step>
  </steps>

  <escalation>
    <trigger>If the owner wants the existing 'nda' or 'policy-library' widgets kept as the card target (with the wizard elsewhere), STOP and follow that instead.</trigger>
  </escalation>

  <justification>
    <existing>No intake wizard exists in Spaarke.UI.Components or external-spa (name search 2026-10-10); the cards open placeholder widgets.</existing>
    <extension>Partly: WizardShell/InAppWizardHost and the CreateRecordWizard pattern are reused; the per-type step content is new.</extension>
    <cost-of-doing-nothing>Quick-start cards open no wizard and no request can be submitted (R2 UAT 4B, FR-05).</cost-of-doing-nothing>
  </justification>

  <ui-tests>
    <test name="NDA wizard">
      <url>https://green-dune-0c4f1221e.7.azurestaticapps.net/</url>
      <steps><step>Sign in as a workforce user</step><step>Click the NDA Assessment card</step><step>Fill all steps and submit</step></steps>
      <expected>Success screen; the request appears in the Service Requests tab</expected>
    </test>
    <test name="Policy Question from More Services">
      <url>https://green-dune-0c4f1221e.7.azurestaticapps.net/</url>
      <steps><step>Open More Services</step><step>Choose Policy Question</step><step>Submit</step></steps>
      <expected>Wizard opens and submits</expected>
    </test>
    <test name="Dark Mode Compliance (ADR-021)">
      <url>https://green-dune-0c4f1221e.7.azurestaticapps.net/</url>
      <steps><step>Switch the SPA to dark theme (or OS dark mode)</step><step>Open the surface this task changed</step><step>Check backgrounds, text and icons</step></steps>
      <expected>No white backgrounds or black text in dark mode; all colours come from Fluent v9 tokens</expected>
    </test>
  </ui-tests>

  <tools>
    <tool name="npm">Typecheck, lint, test and build external-spa</tool>
    <tool name="terminal">Run shell commands</tool>
  </tools>

  <outputs>
    <output type="code">src/client/external-spa/src/intake/intakeRegistry.ts</output>
    <output type="code">src/client/external-spa/src/intake/NdaAssessmentWizard.tsx</output>
    <output type="code">src/client/external-spa/src/intake/PolicyQuestionWizard.tsx</output>
    <output type="test">src/client/external-spa/tests/IntakeWizards.test.tsx</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">The NDA Assessment card and its More Services entry open the NDA wizard; the Policy Question card and entry open the Policy Question wizard.</criterion>
    <criterion testable="true">Required fields block submission with field-level messages.</criterion>
    <criterion testable="true">Submitting posts requestType and answers to /api/v1/external/servicerequests and shows a success screen.</criterion>
    <criterion testable="true">The submitted request appears in the Service Requests tab.</criterion>
    <criterion testable="true">A 403 from the server shows an error and keeps the entered answers.</criterion>
    <criterion testable="true">The owner-approved field sets are recorded in the task notes.</criterion>
    <criterion testable="true">typecheck, lint, tests and the production build of external-spa all pass.</criterion>
  </acceptance-criteria>

  <notes>Spec FR-05.</notes>

