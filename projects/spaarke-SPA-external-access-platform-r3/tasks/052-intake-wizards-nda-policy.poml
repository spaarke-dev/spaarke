<?xml version="1.0" encoding="UTF-8"?>
<task id="052" project="spaarke-SPA-external-access-platform-r3">
  <metadata>
    <title>Intake wizards part 1: wiring + NDA Assessment + Policy Question (FR-05)</title>
    <phase>5 SPA features</phase>
    <gate>after 035</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>New frontend wizards (tags frontend)</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Wizard implementation following CreateRecordWizard + WizardShell</model-tier-reason>
    <effort>high</effort>
    <parallel-group>G</parallel-group>
    <parallel-safe>true</parallel-safe>
    <deps>035</deps>
    <tags>frontend, modal, testing</tags>
    <estimated-effort>2-4 hours</estimated-effort>
  </metadata>

  <prompt>Wire the Legal Front Door quick-start cards and the More Services modal to open intake wizards, and build the NDA Assessment and Policy Question wizards that submit to POST /api/v1/external/servicerequests.</prompt>
  <role>SPAARKE platform developer. React + Fluent UI v9 developer. Follow ADRs strictly.</role>
  <goal>A small intake-wizard registry maps request types to wizard components; the nda-assessment and policy-question cards and their More Services entries open WizardShell-based wizards (via InAppWizardHost) that collect the answers, submit, show a success screen, and the new request appears in the Service Requests tab.</goal>

  <context>
    <background>QuickStartPane.tsx:79-111 QUICK_START_ACTIONS: nda-assessment opens widget 'nda' (:88), policy-question opens 'policy-library' (:98), invention-submission 'inventions' (:108), trademark-search has no target (:111); non-card actions fall through to the More Services FormModal. WizardModal/WizardRegistry were deleted 2026-10-03 (Spaarke.UI.Components/src/components/index.ts:197); the current framework is Wizard/WizardShell.tsx + InAppWizardHost.tsx + WizardSuccessScreen.tsx, and CreateRecordWizard is the structural pattern. Request types are stored in sprk_requesttype; answers as JSON in sprk_intakedata (task 020).</background>
    <relevant-files>
      <file role="new">src/client/external-spa/src/intake/intakeRegistry.ts</file>
      <file role="new">src/client/external-spa/src/intake/NdaAssessmentWizard.tsx</file>
      <file role="new">src/client/external-spa/src/intake/PolicyQuestionWizard.tsx</file>
      <file role="new">src/client/external-spa/src/api/intake-client.ts</file>
      <file role="modify">src/client/external-spa/src/components/shell/QuickStartPane.tsx</file>
      <file role="canonical-reference">src/client/shared/Spaarke.UI.Components/src/components/Wizard/WizardShell.tsx</file>
      <file role="canonical-reference">src/client/shared/Spaarke.UI.Components/src/components/Wizard/InAppWizardHost.tsx</file>
      <file role="canonical-reference">src/client/shared/Spaarke.UI.Components/src/components/CreateRecordWizard/CreateRecordWizard.tsx</file>
      <file role="new-artifact">src/client/external-spa/tests/IntakeWizards.test.tsx</file>
    </relevant-files>
  </context>

  <constraints>
    <constraint source="ADR-021">Every component this task adds or changes uses Fluent UI v9 semantic tokens only (no hard-coded colours) and renders correctly in dark mode.</constraint>
    <constraint source="ADR-012">Reuse @spaarke/ui-components (src/client/shared/Spaarke.UI.Components) before writing a new component; extend a shared component only where the Xrm-free external host needs it, without breaking its existing consumers.</constraint>
    <constraint source="project">Every BFF call this task adds goes through the external plane (/api/v1/external/**) via bffApiCall/bffApiBlob (src/client/external-spa/src/auth/bff-client.ts) and the active token acquirer (acquireActiveBffToken). No call uses a BFF URL or scope taken from a link or query string.</constraint>
    <constraint source="ADR-050">Wizards render through WizardShell/InAppWizardHost (the canonical modal/wizard shell); no hand-rolled dialog.</constraint>
    <constraint source="project">Wizard fields per type are drafted in the task notes for owner approval before build: NDA Assessment (counterparty, purpose, mutual or one-way, deadline, upload of the NDA draft optional later via task 054), Policy Question (topic, question, urgency).</constraint>
    <constraint source="project">Cards stay entitlement-gated (QuickStartPane isEntitled :132); the server enforces it too (task 035).</constraint>
  </constraints>

  <knowledge>
    <topic>intake wizards</topic>
    <files>
      <file>projects/spaarke-SPA-external-access-platform-r3/CLAUDE.md</file>
      <file>projects/spaarke-SPA-external-access-platform-r3/spec.md</file>
      <file>.claude/constraints/pcf.md</file>
