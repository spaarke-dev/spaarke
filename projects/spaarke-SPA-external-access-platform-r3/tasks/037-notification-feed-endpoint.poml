<?xml version="1.0" encoding="UTF-8"?>
<task id="037" project="spaarke-SPA-external-access-platform-r3">
  <metadata>
    <title>In-portal notification feed + last-seen marker (FR-08)</title>
    <phase>3 BFF features</phase>
    <gate>after 034 and 035</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>New external read endpoint over grants and messages (tags bff-api, auth)</rigor-reason>
    <model-tier>opus</model-tier>
    <model-tier-reason>Feed must never leak records outside the accessible set</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>endpoint-registration chain in ExternalAccessEndpoints.cs: 033 → 035 → 037</parallel-reason>
    <deps>034, 035</deps>
    <tags>bff-api, auth, cache, testing</tags>
    <estimated-effort>2-4 hours</estimated-effort>
  </metadata>

  <prompt>Add GET /api/v1/external/notifications and POST /api/v1/external/notifications/seen that derive the caller's feed from recent grants and new messages on accessible records, with a per-user last-seen marker driving the unread count.</prompt>
  <role>SPAARKE platform developer. ASP.NET Core developer. Follow ADRs strictly.</role>
  <goal>The feed returns up to 30 days of (a) grants where the caller's contact is the grantee (sprk_externalrecordaccess.sprk_granteddate) and (b) messages on records in the caller's accessible set not sent by the caller (internal-only excluded for non-systemusers), each with record type:id, title and timestamp, plus unreadCount = items newer than the Redis last-seen marker; POST /seen sets the marker to now.</goal>

  <context>
    <background>Owner 2026-10-08: derived feed, no new table. appnotification targets systemusers only. Last-seen is stored in Redis (ADR-009; notes/decisions.md) keyed by principal id with a 30-day TTL refreshed on write; losing it only re-marks 30 days as unread. The message read rules come from task 033.</background>
    <relevant-files>
      <file role="new">src/server/api/Sprk.Bff.Api/Api/ExternalAccess/ExternalNotificationFeedEndpoints.cs</file>
      <file role="modify">src/server/api/Sprk.Bff.Api/Api/ExternalAccess/ExternalAccessEndpoints.cs</file>
      <file role="modify">src/server/api/Sprk.Bff.Api/Infrastructure/ExternalAccess/ExternalDataService.cs</file>
      <file role="canonical-reference">src/server/api/Sprk.Bff.Api/Api/ExternalAccess/ExternalMessageEndpoints.cs</file>
      <file role="canonical-reference">.claude/patterns/caching/distributed-cache.md</file>
      <file role="new-artifact">tests/unit/Sprk.Bff.Api.Tests/Api/ExternalAccess/ExternalNotificationFeedTests.cs</file>
    </relevant-files>
  </context>

  <constraints>
    <constraint source="project">Every route this task adds or modifies is mapped inside the /api/v1/external group (Api/ExternalAccess/ExternalAccessEndpoints.cs:60-63) so it inherits the ExternalCollaboration policy and CallerPrincipalAuthorizationFilter. No route in this task is mapped outside that group.</constraint>
    <constraint source="ADR-028">No OBO on the external plane: every Dataverse and SPE call this task adds is app-only and scoped to the caller's accessible set (spec NFR-01).</constraint>
    <constraint source="bff-extensions">State the Placement Justification in the PR (cite .claude/constraints/bff-extensions.md). Measure the publish-size delta against a fresh master build: more than +5 MB needs written justification; the total must stay at or under 60 MB. No new HIGH CVE.</constraint>
    <constraint source="project">Build only on the net10 SDK (10.0.1xx). Run /conflict-check before opening the PR: Api/ExternalAccess/** and Infrastructure/ExternalAccess/** are shared with unified-access-control-r2.</constraint>
    <constraint source="ADR-009">The last-seen marker uses the existing IDistributedCache (Redis) registration with a key prefix that includes the principal id; no new cache client.</constraint>
    <constraint source="project">Every feed item's record is checked against the caller's accessible set at read time; a grant row for a record no longer accessible is dropped (fail-closed).</constraint>
    <constraint source="project">The feed query is bounded: last 30 days, at most 100 items, newest first.</constraint>
  </constraints>

