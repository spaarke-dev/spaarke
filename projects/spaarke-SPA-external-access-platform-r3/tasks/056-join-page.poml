<?xml version="1.0" encoding="UTF-8"?>
<task id="056" project="spaarke-SPA-external-access-platform-r3">
  <metadata>
    <title>Join page for workforce-contact self-registration (FR-13)</title>
    <phase>5 SPA features</phase>
    <gate>after 003 (approach chosen) and 041; ships behind a flag until 060</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Sign-in flow change (tags auth, frontend)</rigor-reason>
    <model-tier>opus</model-tier>
    <model-tier-reason>New sign-in flow with a registration-only client; tenant-isolation sensitive</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
    <parallel-reason>touches auth/* after 041</parallel-reason>
    <deps>003, 041</deps>
    <tags>auth, frontend, testing</tags>
    <estimated-effort>2-4 hours</estimated-effort>
  </metadata>

  <prompt>Build https://external.spaarke.com/join?customer={key} so a licence-free employee signs in with their home company account, is registered by the shared service (task 060), and is handed off to normal workforce sign-in — implementing whichever approach task 003 chose.</prompt>
  <role>SPAARKE platform developer. Frontend identity developer. Follow ADRs strictly.</role>
  <goal>A /join route (feature-flagged) validates the customer key through the 041 seam, signs the user into their home tenant with a registration-only client requesting only profile scopes, calls the registration service, shows clear outcomes (registered, already registered, company not allowed, guest of another tenant), and then starts normal Spaarke-tenant workforce sign-in.</goal>

  <context>
    <background>Owner 2026-10-09: automatic approval when home tenant ∈ CustomerTenantIds and acct = 0; nobody is created in advance. If task 003 chose Entra's built-in self-service sign-up flow, this page becomes a thin redirect into that flow; record which. The registration service is task 060; until it exists the page stays behind a flag (VITE_JOIN_ENABLED). T240d S1 (ii): an existing account surfaces as ObjectConflict — show 'already registered — sign in'.</background>
    <relevant-files>
      <file role="new">src/client/external-spa/src/pages/JoinPage.tsx</file>
      <file role="new">src/client/external-spa/src/auth/registration-client.ts</file>
      <file role="modify">src/client/external-spa/src/App.tsx</file>
      <file role="modify">src/client/external-spa/staticwebapp.config.json</file>
      <file role="canonical-reference">projects/spaarke-SPA-external-access-platform-r3/notes/spikes/fr-12-self-registration-decision.md</file>
      <file role="new-artifact">src/client/external-spa/tests/JoinPage.test.tsx</file>
    </relevant-files>
  </context>

  <constraints>
    <constraint source="ADR-021">Every component this task adds or changes uses Fluent UI v9 semantic tokens only (no hard-coded colours) and renders correctly in dark mode.</constraint>
    <constraint source="ADR-012">Reuse @spaarke/ui-components (src/client/shared/Spaarke.UI.Components) before writing a new component; extend a shared component only where the Xrm-free external host needs it, without breaking its existing consumers.</constraint>
    <constraint source="project">Every BFF call this task adds goes through the external plane (/api/v1/external/**) via bffApiCall/bffApiBlob (src/client/external-spa/src/auth/bff-client.ts) and the active token acquirer (acquireActiveBffToken). No call uses a BFF URL or scope taken from a link or query string.</constraint>
    <constraint source="project">The registration-only client requests only openid/profile (User.Read at most); it never requests a BFF scope. Its authority is /organizations (home tenant) — this is the one place a non-Spaarke authority is allowed, and its token is sent only to the registration service.</constraint>
    <constraint source="project">The customer key must resolve through the 041 seam; an unknown key shows 'link not recognised'.</constraint>
    <constraint source="project">Behind VITE_JOIN_ENABLED (default false) until task 060 ships the service.</constraint>
  </constraints>

  <knowledge>
    <topic>self-registration UI</topic>
    <files>
      <file>projects/spaarke-SPA-external-access-platform-r3/CLAUDE.md</file>
      <file>projects/spaarke-SPA-external-access-platform-r3/spec.md</file>
      <file>.claude/constraints/auth.md</file>
      <file>.claude/patterns/auth/spaarke-sso-binding.md</file>
      <file>.claude/patterns/auth/oauth-scopes.md</file>
      <file>.claude/adr/ADR-028-spaarke-auth-architecture.md</file>
      <file>docs/guides/auth-deployment-setup.md</file>
      <file>.claude/constraints/pcf.md</file>
      <file>.claude/patterns/pcf/theme-management.md</file>
      <file>.claude/adr/ADR-021-fluent-design-system.md</file>
      <file>.claude/adr/ADR-012-shared-components.md</file>
      <file>.claude/skills/ui-test/SKILL.md</file>
      <file>.claude/constraints/testing.md</file>
      <file>.claude/patterns/testing/unit-test-structure.md</file>
      <file>.claude/patterns/testing/mocking-patterns.md</file>
      <file>docs/adr/ADR-038-testing-strategy.md</file>
    </files>
  </knowledge>

  <steps mode="directional">
    <step order="0" name="Context + rigor declaration">Load the knowledge files, read the relevant files listed above, declare rigor and model tier per task-execute Step 0.5.</step>
    <step order="1">Read the task-003 decision; follow its approach.</step>
    <step order="2">Add the /join route and JoinPage with the states above.</step>
    <step order="3">Implement registration-client (MSAL instance for the registration-only client; call the service; map responses).</step>
    <step order="4">After success, start normal workforce sign-in for the selected customer.</step>
    <step order="5">Tests: unknown key; each service outcome; hand-off starts workforce sign-in; flag off → route shows 'not available'.</step>
    <step order="6">In src/client/external-spa run `npm run typecheck`, `npm run lint`, `npm test` and `npm run build` (all exit 0; install with `npm install --legacy-peer-deps --no-audit --no-fund` if node_modules is missing).</step>
    <step order="7">Update tasks/TASK-INDEX.md: set this task's status cell to `✅ [done]` and this POML's &lt;status&gt; to completed; run `pwsh scripts/check-task-status-drift.ps1`.</step>
    <step order="8">Record deviations, decisions and measurements in projects/spaarke-SPA-external-access-platform-r3/notes/task-056-notes.md.</step>
  </steps>

  <escalation>
    <trigger>If task 003 chose the built-in flow and it cannot be keyed per customer, STOP and escalate.</trigger>
  </escalation>

  <justification>
    <existing>No join or registration page exists in external-spa.</existing>
    <extension>No: the SPA has no pre-sign-in registration flow to extend; it reuses the 041 seam and MSAL setup.</extension>
    <cost-of-doing-nothing>Licence-free customer staff have no way to get access (owner requirement 2026-10-09; FR-13).</cost-of-doing-nothing>
  </justification>

  <ui-tests>
    <test name="Join allowed">
      <url>https://green-dune-0c4f1221e.7.azurestaticapps.net/join?customer={key}</url>
      <steps><step>Open /join?customer={key} with VITE_JOIN_ENABLED</step><step>Sign in as a member of an allow-listed test tenant</step></steps>
      <expected>Registered; then signed in to the SPA as a workforce contact</expected>
    </test>
    <test name="Join refused">
      <url>https://green-dune-0c4f1221e.7.azurestaticapps.net/join?customer={key}</url>
      <steps><step>Sign in as a member of a non-listed tenant</step></steps>
      <expected>'Your company is not set up for access' message; no registration</expected>
    </test>
    <test name="Dark Mode Compliance (ADR-021)">
      <url>https://green-dune-0c4f1221e.7.azurestaticapps.net/join?customer={key}</url>
      <steps><step>Switch the SPA to dark theme (or OS dark mode)</step><step>Open the surface this task changed</step><step>Check backgrounds, text and icons</step></steps>
      <expected>No white backgrounds or black text in dark mode; all colours come from Fluent v9 tokens</expected>
    </test>
  </ui-tests>

  <tools>
    <tool name="npm">Typecheck, lint, test and build external-spa</tool>
    <tool name="terminal">Run shell commands</tool>
  </tools>

  <outputs>
    <output type="code">src/client/external-spa/src/pages/JoinPage.tsx</output>
    <output type="code">src/client/external-spa/src/auth/registration-client.ts</output>
    <output type="test">src/client/external-spa/tests/JoinPage.test.tsx</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">With the flag on and a known key, an allow-listed member goes from the link to a signed-in SPA in one flow (against the dev service or a mock of it in tests).</criterion>
    <criterion testable="true">An unknown customer key shows 'link not recognised' and makes no service call.</criterion>
    <criterion testable="true">A non-listed tenant and a guest of another tenant each show a clear refusal.</criterion>
    <criterion testable="true">An already-registered user is told to sign in and is handed off to sign-in.</criterion>
    <criterion testable="true">The registration-only client never requests a BFF scope.</criterion>
    <criterion testable="true">With the flag off, /join shows 'not available'.</criterion>
    <criterion testable="true">typecheck, lint, tests and the production build of external-spa all pass.</criterion>
  </acceptance-criteria>

  <notes>Spec FR-13. NFR-07: test against a stamp-shaped customer configuration, not dev's.</notes>

  <execution>
    <skill>.claude/skills/task-execute/SKILL.md</skill>
    <protocol>Before starting this task, load all files listed in &lt;knowledge&gt;&lt;files&gt;. Follow the task-execute skill for the mandatory pre-execution checklist.</protocol>
  </execution>
</task>
