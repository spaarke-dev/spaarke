<task id="010" project="spaarke-notification-spine-r1">
  <metadata>
    <title>Author ADR-047 — Notification &amp; Action Spine (Concise + Full)</title>
    <phase>1 Layer B + Contract + ADR-047</phase>
    <gate>blocked-until:001</gate>
    <status>not-started</status>
