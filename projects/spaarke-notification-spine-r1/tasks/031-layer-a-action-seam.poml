      <file>src/server/api/Sprk.Bff.Api/Services/Ai/PublicContracts/IBriefingAi.cs</file>
      <file>src/server/api/Sprk.Bff.Api/Services/Ai/PublicContracts/BriefingAi.cs</file>
      <file>src/server/api/Sprk.Bff.Api/Services/Ai/PublicContracts/NullBriefingAi.cs</file>
      <file>src/server/api/Sprk.Bff.Api/Services/Ai/DispositionRoutability.cs</file>
      <file>src/server/api/Sprk.Bff.Api/Services/Ai/OutputRouter.cs</file>
      <file>src/server/api/Sprk.Bff.Api/Api/Ai/DispatchSessionEndpoint.cs</file>
      <file>tests/unit/Sprk.Bff.Api.Tests/Services/Ai/Nodes/CreateTaskNodeExecutorTests.cs</file>
      <file>tests/unit/Sprk.Bff.Api.Tests/Services/Ai/Nodes/UpdateRecordNodeExecutorTests.cs</file>
      <file>tests/integration/seam/Ai/Nodes/CreateNotificationNodeExecutorSeamTests.cs</file>
      <file>tests/integration/seam/Ai/Nodes/CreateTaskNodeExecutorSeamTests.cs</file>
