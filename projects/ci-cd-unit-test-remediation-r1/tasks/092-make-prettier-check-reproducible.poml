<task id="CICD-092" project="ci-cd-unit-test-remediation-r1">
  <metadata>
    <title>Tier 2 Prettier check is not developer-reproducible: CI 1907 files vs local 46 (#850)</title>
    <status>completed</status>
    <estimated-effort>2-4 hours</estimated-effort>
    <phase>4 - Deliverable defect repair (adopted 2026-08-28)</phase>
