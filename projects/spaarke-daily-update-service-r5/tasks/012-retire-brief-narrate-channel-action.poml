    <step order="6">dotnet build src/server/api/Sprk.Bff.Api/ (0 errors); run the eval suite; run dotnet publish and report size.</step>
    <step order="7">Update TASK-INDEX.md: task 012 status to completed. Record deviations in notes/.</step>
  </steps>

  <escalation>
