<task id="035" project="spaarke-daily-update-service-r5">
  <metadata>
    <title>Jest tests for buildSegments, isEmptyResponse, useInlineTodoCreate, actionToBadge/reasonToLabel</title>
    <phase>B: Hardening</phase>
    <status>not-started</status>
    <estimated-hours>4</estimated-hours>
    <dependencies>none</dependencies>
