<task id="016" project="spaarke-daily-update-service-r5">
  <metadata>
    <title>Briefing-accuracy eval family (mixed-item corpus) + deterministic-renderer unit tests + CI merge gate</title>
    <phase>A: Accuracy core</phase>
    <status>completed</status>
    <estimated-hours>4</estimated-hours>
