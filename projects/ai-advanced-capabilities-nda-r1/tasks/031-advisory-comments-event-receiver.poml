<task id="031" project="ai-advanced-capabilities-nda-r1">
  <metadata>
    <title>Advisory-comments event + receiver — materialize AI comments in the Compose doc</title>
    <phase>3 Compose Review Experience</phase>
    <gate>blocked</gate>
    <status>completed</status>
