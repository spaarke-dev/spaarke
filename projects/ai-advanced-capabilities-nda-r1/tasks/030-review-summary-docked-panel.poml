<?xml version="1.0" encoding="UTF-8"?>
<task id="030" project="ai-advanced-capabilities-nda-r1">
  <metadata>
    <title>Review-summary docked panel in Compose (single surface)</title>
    <phase>3 Compose Review Experience</phase>
    <gate>blocked</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>New Fluent v9 panel component in Compose client (.tsx); frontend feature.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>New component following the existing ComposeCommentThread docked-panel convention with a concrete reference to mirror.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>C</parallel-group>
    <parallel-safe>true</parallel-safe>
    <parallel-reason>New panel file; independent of 031's event receiver and 041's server writer. Shares ComposeWorkspace shell — coordinate the mount point but no file overlap with 031/041.</parallel-reason>
    <deps>023</deps>
    <tags>frontend, react, fluent-ui, pcf</tags>
    <estimated-effort>3-4 hours</estimated-effort>
  </metadata>

  <prompt>
    Add a review-summary docked panel inside Compose that renders the concise cited flagged-section summary
    (overall risk + bulleted findings with page/section/paragraph refs) from the orchestration payload. Compose is
    the single surface — no separate Analysis widget. Follow the ComposeCommentThread/ComposeFindReplace docked-panel
    convention.
  </prompt>

  <role>
    SPAARKE Compose client developer. Expert in React 18, Fluent UI v9 (ADR-021), and the ComposeWorkspace column
    shell + docked-panel convention.
  </role>

  <goal>
    A docked panel in Compose shows overallRisk + the flaggedSections summary (each with its citation) from the
    ledgered NDA-REVIEW result; it mirrors the existing docked-panel styling and is dark-mode compliant.
  </goal>

  <context>
    <background>
      Reuse-first: ComposeWorkspace.tsx is the column shell; ComposeCommentThread/ComposeFindReplace are the docked
      panels to mirror. The summary content is the concise cited bullet list (spec FR-07). No architectural change,
      no Analysis widget.
    </background>
    <relevant-files>
      <file>src/client/shared/Spaarke.Compose.Components/src/widgets/ComposeWorkspace.tsx</file>
      <file>src/client/shared/Spaarke.Compose.Components/src/components/ComposeCommentThread.tsx</file>
      <file>src/client/shared/Spaarke.Compose.Components/src/ (new: NdaReviewSummaryPanel.tsx)</file>
    </relevant-files>
    <dependencies>023 (summary payload from orchestration).</dependencies>
  </context>

  <constraints>
    <constraint source="ADR-021">Fluent v9 semantic tokens; dark-mode compliant; icons use currentColor.</constraint>
    <constraint source="ADR-012">New component lives in the shared Compose components lib and is exported through the lib index.</constraint>
    <constraint source="project">Follow the docked-panel convention (ComposeCommentThread) — do not invent a new panel framework. Summary is concise + citation-bearing; clicking a finding may scroll to its section (nice-to-have, not required for AC).</constraint>
  </constraints>

  <knowledge>
    <files>
      <file>.claude/adr/ADR-021-fluent-design-system.md</file>
      <file>.claude/adr/ADR-012-shared-components.md</file>
      <file>.claude/adr/ADR-049-compose-shadow-document.md</file>
      <file>.claude/patterns/ui/fluent-v9-component-authoring.md</file>
      <file>.claude/patterns/ui/embedded-widget-sizing.md</file>
    </files>
    <patterns>
      <pattern name="Docked panel" location="src/client/shared/Spaarke.Compose.Components/src/components/ComposeCommentThread.tsx">
        Mirror this panel's mount, styling, and open/close for the review-summary panel.
      </pattern>
    </patterns>
  </knowledge>

  <steps mode="directional">
    <step order="1">Study ComposeCommentThread + ComposeFindReplace docked-panel structure and how ComposeWorkspace mounts them.</step>
    <step order="2">Build NdaReviewSummaryPanel rendering overallRisk + flaggedSections (citation per bullet).</step>
    <step order="3">Wire it to the summary payload from the orchestration result; mount it in the Compose shell.</step>
    <step order="4">Export from the shared lib index; verify dark-mode tokens.</step>
    <step order="5">Run the UI tests below; update TASK-INDEX.md: mark 030 ✅.</step>
  </steps>

  <tools>
    <tool name="npm">Build the shared Compose lib + code page.</tool>
  </tools>

  <outputs>
    <output type="code">src/client/shared/Spaarke.Compose.Components/src/ (NdaReviewSummaryPanel.tsx + index export)</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">Given a completed NDA-REVIEW, when Compose renders, then the docked panel shows overallRisk + each flagged section with its page/section/paragraph citation.</criterion>
    <criterion testable="true">The panel mirrors the ComposeCommentThread docked-panel convention (no new panel framework).</criterion>
    <criterion testable="true">The panel renders correctly in dark mode using Fluent v9 semantic tokens.</criterion>
  </acceptance-criteria>

  <ui-tests>
    <test name="Review summary panel renders">
      <url>https://{org}.crm.dynamics.com/main.aspx?pagetype=webresource&amp;webresourceName=sprk_SpaarkeAi</url>
      <steps>
        <step>Run NDA-REVIEW on a sample NDA and open the Compose tab</step>
        <step>Verify the review-summary docked panel shows overall risk + cited findings</step>
        <step>Check console for errors</step>
      </steps>
      <expected>Panel renders findings with citations; no console errors.</expected>
    </test>
    <test name="Dark Mode Compliance (ADR-021)">
      <steps>
        <step>Toggle dark mode</step>
        <step>Verify panel colors adapt (no white in dark mode)</step>
      </steps>
      <expected>All colors use Fluent v9 semantic tokens per ADR-021.</expected>
    </test>
  </ui-tests>

  <notes>
    Single-surface decision: this panel replaces the earlier NdaAnalysisWidget idea. Keep it concise + cited.
  </notes>

  <execution>
    <skill>.claude/skills/task-execute/SKILL.md</skill>
    <protocol>Load knowledge files. Follow task-execute incl. Step 9.7 ui-test.</protocol>
  </execution>
</task>
