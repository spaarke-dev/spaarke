<task id="042" project="ai-advanced-capabilities-nda-r1">
  <metadata>
    <title>SPE save + versioning verification (test only)</title>
    <phase>4 Export &amp; Persistence</phase>
    <gate>blocked</gate>
    <status>not-started</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>Test-only; asserts existing inherited behavior; tags include testing/integration-test (TEST-MODIFYING → gates apply).</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Test authoring against an existing, known save→SPE path; no new production code.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>D</parallel-group>
    <parallel-safe>true</parallel-safe>
    <parallel-reason>Test-only; independent of 041's writer (different files).</parallel-reason>
