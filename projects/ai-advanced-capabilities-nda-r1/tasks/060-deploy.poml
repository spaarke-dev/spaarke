<task id="060" project="ai-advanced-capabilities-nda-r1">
  <metadata>
    <title>Deploy — BFF, SpaarkeAi code page, Dataverse Actions/Bindings, AI Search index</title>
    <phase>6 Deploy &amp; Wrap-up</phase>
    <gate>blocked</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Multi-surface deployment; irreversible/ordered; publish-size gate; tags include deploy.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Deployment execution against known deploy skills/scripts; prescriptive sequence, no design judgment.</model-tier-reason>
