<?xml version="1.0" encoding="UTF-8"?>
<task id="021" project="ai-advanced-capabilities-nda-r1">
  <metadata>
    <title>NDA-STANDARD-SUMMARY Action (UC3) — plain-language summary of the standard</title>
    <phase>2 NDA Review Capability</phase>
    <gate>blocked</gate>
    <status>not-started</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>New JPS Action but low blast radius; reuses the Action authoring pattern; single-purpose summary.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Straightforward Action authoring following the task-020 pattern with a clear reference; Fast-tier summary.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>B</parallel-group>
    <parallel-safe>true</parallel-safe>
    <parallel-reason>Separate Action JSON; independent of 022/023.</parallel-reason>
    <deps>012,020</deps>
    <tags>ai, azure-openai, dataverse</tags>
    <estimated-effort>2 hours</estimated-effort>
  </metadata>

  <prompt>
    Author the NDA-STANDARD-SUMMARY Action (UC3): a plain-language summary of the Spaarke NDA standard for
    non-lawyers — what the firm's default positions are and why — grounded on the seeded standard, on the Fast
    tier. This is the "explain the standard" companion to the review.
  </prompt>

  <role>
    SPAARKE AI capability author. Expert in JPS Actions and plain-language legal summarization.
  </role>

  <goal>
    A validated NDA-STANDARD-SUMMARY Action returns a concise plain-language summary of the seeded standard;
    jps-validate passes.
  </goal>

  <context>
    <background>
      UC3 (plain-language standard summary) is KEPT in r1 (UC2 fresh-draft is deferred). The standard is seeded in
      task 012. This can either be a new lightweight Action or point a summary binding at the standard source.
    </background>
    <relevant-files>
      <file>infra/dataverse/actions/nda-review.action.json</file>
      <file>infra/dataverse/actions/ (new: nda-standard-summary.action.json)</file>
      <file>projects/ai-advanced-capabilities-nda-r1/notes/spaarke-nda-standard-baseline.md</file>
    </relevant-files>
    <dependencies>012 (standard seeded), 020 (Action authoring pattern established).</dependencies>
  </context>

  <constraints>
    <constraint source="ADR-039">Summary of the firm's OWN standard is largely deterministic/factual — cite the standard clauses it summarizes; plain-language rephrasing is permitted under the advisory tier.</constraint>
    <constraint source="ADR-016">Fast tier is sufficient (simple summarization); do not use Reasoning here.</constraint>
    <constraint source="project">Non-lawyer audience; concise; not-legal-advice framing.</constraint>
  </constraints>

  <knowledge>
    <files>
      <file>.claude/adr/ADR-039-grounded-execution.md</file>
      <file>.claude/patterns/ai/analysis-scopes.md</file>
      <file>.claude/skills/jps-action-create/SKILL.md</file>
      <file>.claude/skills/jps-validate/SKILL.md</file>
    </files>
    <patterns>
      <pattern name="NDA-REVIEW Action" location="infra/dataverse/actions/nda-review.action.json">
        Reuse the Action authoring approach from task 020, simplified to a Fast-tier grounded summary.
      </pattern>
    </patterns>
  </knowledge>

  <steps mode="directional">
    <step order="1">Decide: new Action vs a summary binding over the standard source (prefer the lighter option per §11).</step>
    <step order="2">Author the prompt + minimal output schema (plain-language summary sections).</step>
    <step order="3">Set Fast tier; ground on the seeded standard.</step>
    <step order="4">Run jps-validate; sample-run and confirm it cites the standard clauses.</step>
    <step order="5">Update TASK-INDEX.md: mark 021 ✅.</step>
  </steps>

  <tools>
    <tool name="terminal">jps-validate + sample run.</tool>
  </tools>

  <outputs>
    <output type="config">infra/dataverse/actions/nda-standard-summary.action.json</output>
  </outputs>

  <acceptance-criteria>
    <criterion testable="true">jps-validate passes on the summary Action.</criterion>
    <criterion testable="true">Given the seeded standard, when the Action runs, then it returns a concise plain-language summary citing the standard's clauses.</criterion>
    <criterion testable="true">The Action runs on the Fast tier.</criterion>
  </acceptance-criteria>

  <notes>
    §11 justification: prefer extending an existing summary binding if one fits; only add a new Action if none does.
  </notes>

  <execution>
    <skill>.claude/skills/task-execute/SKILL.md</skill>
    <protocol>Load knowledge files. Follow task-execute checklist.</protocol>
  </execution>
</task>
