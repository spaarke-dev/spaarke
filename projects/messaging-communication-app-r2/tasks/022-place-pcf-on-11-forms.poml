<task id="022" project="messaging-communication-app-r2">
  <metadata>
    <title>Place the regarding-mode `CommunicationTimeline` PCF on ALL 11 regarding-family entity forms + form config + 11-entity smoke pass</title>
    <phase>W2 — Record Threads View (Surface 1)</phase>
    <status>not-started</status>
    <estimated-hours>10</estimated-hours>
