<task id="080" project="messaging-communication-app-r2">
  <metadata>
    <title>Vertical-slice seam tests: `by-regarding` + filtered `query` + `participant=` facet + auto-threading 3 tiers; 11-entity pass; access-parity negatives; preserve email/messaging characterization</title>
    <phase>W8 — Tests + Docs + Wrap</phase>
