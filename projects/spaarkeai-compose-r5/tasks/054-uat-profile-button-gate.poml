<task id="054" project="spaarkeai-compose-r5">
  <metadata>
    <title>UAT #9 — surface the Refresh-Profile button once the doc has a record id (relax gate)</title>
    <phase>5 UAT remediation</phase>
    <gate>dep:042</gate>
    <status>pending</status>
    <rigor>STANDARD</rigor>
    <rigor-reason>Tiny client-only gate change on an existing, fully-wired button; no server/engine change. STANDARD, but runs the Step 9.5 gates because it edits the contended .tsx alongside 050/052/053.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Single-condition visibility relax on an already-wired button; trivial.</model-tier-reason>
    <effort>high</effort>
    <parallel-group>none</parallel-group>
    <parallel-safe>false</parallel-safe>
