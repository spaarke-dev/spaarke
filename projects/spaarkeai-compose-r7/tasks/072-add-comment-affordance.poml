  <ui-tests>
    <test name="Add Comment creates a comment">
      <steps>
        <step>Select text; click Add Comment.</step>
        <step>Verify a comment is created via the shipped round-trip path.</step>
      </steps>
      <expected>Comment created through existing machinery.</expected>
