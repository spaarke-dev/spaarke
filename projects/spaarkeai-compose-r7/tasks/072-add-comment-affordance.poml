    </relevant-files>
    <dependencies>
      <dependency task="001" status="pending">Coordination gate.</dependency>
    </dependencies>
  </context>

  <constraints>
    <constraint source="ADR-021">The Add Comment control MUST use Fluent v9 semantic tokens; verify dark mode (ADR-021).</constraint>
    <constraint source="project">Wire the affordance to the EXISTING R6 comment machinery (024/026); MUST NOT build a parallel comment pipeline (root §11). MUST NOT delete docxBridge.ts.</constraint>
  </constraints>

  <knowledge>
