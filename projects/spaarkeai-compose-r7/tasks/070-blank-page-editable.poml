<task id="070" project="spaarkeai-compose-r7">
  <metadata>
    <title>Blank page mounts editable (R6 D8 / FR-08)</title>
    <phase>7 Accepted Defers + Hardening</phase>
    <gate>blocked</gate>
    <status>not-started</status>
    <rigor>FULL</rigor>
    <rigor-reason>Modifies .tsx mount/seed path; frontend behavior fix.</rigor-reason>
    <model-tier>sonnet</model-tier>
    <model-tier-reason>Narrow empty-seed path fix with explicit anchors (@2252→2276, @3018); low ambiguity.</model-tier-reason>
