<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Sprk.Bff.Api</AssemblyName>
    <RootNamespace>Sprk.Bff.Api</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <UserSecretsId>cbc576fa-6ea6-485a-bb2a-d96130f21f20</UserSecretsId>
    <!-- FR-A1: framework-dependent linux-x64 publish (App Service is Linux). Trims multi-platform native RIDs. -->
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal members to test assemblies -->
    <InternalsVisibleTo Include="Sprk.Bff.Api.Tests" />
    <!-- Allow Moq dynamic proxy generation to intercept internal virtual methods (e.g. UpdateSessionCacheAsync) -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    <!-- Allow integration test assembly to access internal members -->
    <InternalsVisibleTo Include="Spe.Integration.Tests" />
    <!-- Sprk.Bff.Api.IntegrationTests: BFF Dataverse passthrough endpoint tests (task 016) reach
         internal DataverseAuthorizationFilter / IDataversePrivilegeChecker / IFetchXmlEntityExtractor /
         EntitySource / SavedQueryService / FetchService / FetchRequestDto / SavedQueryDto types. -->
    <InternalsVisibleTo Include="Sprk.Bff.Api.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Agent Framework (Phase 1 - AIPL-002, AIPL-050) - PINNED: Do NOT upgrade without testing -->
    <!-- Microsoft.Agents.AI 1.0.0-rc1 requires Microsoft.Extensions.AI >= 10.3.0 -->
    <!-- Microsoft.Extensions.AI.OpenAI 10.3.0 requires OpenAI >= 2.8.0 (added in AIPL-050 for IChatClient bridge) -->
    <PackageReference Include="Azure.AI.Projects" Version="1.0.0-beta.8" />
    <PackageReference Include="Microsoft.Agents.Hosting.AspNetCore" Version="1.0.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.3.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.3.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.0.0-rc1" />
    <!-- OpenAI pinned to 2.8.0: required by Microsoft.Extensions.AI.OpenAI 10.3.0 IChatClient bridge -->
    <PackageReference Include="OpenAI" Version="2.8.0" />

    <!-- JsonSchema.Net 7.3.4: Draft 2020-12 meta-schema validation for sprk_analysistool
         JSON Schemas (R6 audit item 1, 2026-06-07). Used by ToolHandlerToAIFunctionAdapter
         constructor + AnalysisToolService.MapJsonSchema to refuse malformed schemas before
         the LLM sees them. Sole transitive dep: Json.More.Net. +300 KB compressed delta
         (well within R6 NFR-02 budget of +5 MB). -->
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />

    <!-- Azure packages -->
    <!-- Azure.Communication.Identity 1.3.1 — ACS identity plane + server-side chat-token minting
         (messaging-communication-app-r1 task 010 / FR-03). Thin over the already-present Azure.Core;
         spike 003 measured +0.22 MB compressed (only Azure.Communication.{Identity,Common}.dll are new).
         Uses the DI-injected central TokenCredential (ADR-028 / NFR-05) — NEVER a connection-string key. -->
    <PackageReference Include="Azure.Communication.Identity" Version="1.3.1" />
    <!-- Azure.Communication.Chat 1.4.0 — ACS thread + membership ops (messaging-communication-app-r1
         task 011 / FR-15). Thin over the already-present Azure.Core + Azure.Communication.Common (added
         with Identity above); spike 003 compile-verified the exact retention API
         (ThreadCreationDateRetentionPolicy(deleteThreadAfterDays:30)) and measured the ACS SDK trio at
         +0.22 MB compressed total — Chat adds only its own ~0.1 MB DLL. ChatClient auth is a server-minted
         chat token rooted in the DI-injected central TokenCredential via the identity plane (ADR-028 /
         NFR-05) — NEVER a connection-string key. -->
    <PackageReference Include="Azure.Communication.Chat" Version="1.4.0" />
    <!-- Microsoft.Azure.SignalR.Management 1.33.1 — Layer-C notification-spine delivery (Serverless/publish-only
         mode) added by spaarke-notification-spine-r1 FR-01 spike (task 001). GO decision: send-only spine
         topology structurally favors Serverless (no hosted hub); measured +0.30 MB compressed publish delta,
         0 new HIGH CVE. See projects/spaarke-notification-spine-r1/notes/spikes/fr-01-signalr-footprint.md.
         NOTE: reference is intentionally unwired here — task 020 adds the negotiate endpoint + DI (ADR-032
         null-object) + Placement Justification (CLAUDE.md §10) and runs /conflict-check before its BFF PR. -->
    <PackageReference Include="Microsoft.Azure.SignalR.Management" Version="1.33.1" />
    <!-- Cosmos DB SDK v3 — AI persistence (AIPU2-030: SessionPersistenceService, AIPU2-033: AuditLogService) -->
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.62.1" />
    <PackageReference Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
    <!-- Azure.AI.OpenAI 2.8.0-beta.1: restores compat with OpenAI 2.8.0 (2.1.0 threw MissingMethodException on SerializedAdditionalRawData) -->
    <PackageReference Include="Azure.AI.OpenAI" Version="2.8.0-beta.1" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
    <PackageReference Include="Azure.Search.Documents" Version="11.6.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
    <PackageReference Include="Handlebars.Net" Version="2.4.3" />
    <!-- Microsoft.ApplicationInsights.AspNetCore (classic SDK) removed in dotnet-10-upgrade-r1
         task 014 (FR-06 telemetry consolidation). Telemetry now flows solely through the
         OpenTelemetry → Azure Monitor pipeline (Azure.Monitor.OpenTelemetry.AspNetCore +
         UseAzureMonitor(), below). The classic TelemetryClient was never registered after
         redis-cache-remediation-r1 R7-S7, so its custom events/metrics were already inert. -->

    <!-- Caching -->
    <!-- Microsoft.Extensions.Caching.Abstractions 10.0.3: bumped from 10.0.1 to satisfy Microsoft.Extensions.AI 10.3.0 dependency chain -->
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />

    <!-- Microsoft Graph SDK v6.x (dotnet-10-upgrade-r1 task 033, 2026-08-13): bumped 5.105.0 -> 6.5.0.
         Pulls Microsoft.Graph.Core 4.0.1 + transitive Microsoft.Kiota.* 2.0.x, which supersedes the
         CVE-2026-44503 (GHSA-7j59-v9qr-6fq9, High/CVSS 7.0) 1.22.0 floor, so the 7 direct Kiota pins
         below were retired; the version-match invariant (see CLAUDE.md Package Management) is now
         satisfied transitively. See notes/graph6-kiota2-break-assessment.md for the full call-site
         sizing (mechanical break, ServiceException retained in Graph.Core 4.x). -->
    <PackageReference Include="Microsoft.Graph" Version="6.5.0" />

    <!-- Microsoft Identity (CRITICAL - must be 3.x or higher) -->
    <!-- Identity.Web 3.8.2+ fixes CVE-2025-32016; requires Identity.Client >= 4.70.0 -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.87.0" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageReference Include="Microsoft.Identity.Web.MicrosoftGraph" Version="4.14.2" />
    <!-- MimeKit 4.15.1: fixes CVE-2026-30227 (CRLF injection in SMTP envelope address) -->
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="MsgReader" Version="6.1.0" />
    <!-- HtmlSanitizer (namespace Ganss.Xss) 9.1.973 — the AUTHORITATIVE server-side XSS boundary for the
         .eml -> sanitized-HTML reading-pane render (email-communication-solution-r5 task 010 / spec NFR-03).
         Owner-approved Path-A exception (CLAUDE.md §6.5): the BFF had no HTML sanitizer (direct or transitive)
         and regex-sanitizing an XSS boundary is a known-unsafe anti-pattern, so a purpose-built allow-list
         sanitizer is required. Consumed only by EmlToHtmlRenderer. Pulls AngleSharp (maintained HTML parser)
         as its sole notable transitive; publish-size delta measured + reported in the task notes
         (well under the +5 MB single-task line and the 60 MB ceiling — CLAUDE.md §10 / NFR-01). -->
    <PackageReference Include="HtmlSanitizer" Version="9.2.995" />

    <!-- Observability -->
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <!-- Redis tracing instrumentation (spaarke-redis-cache-remediation-r1 task 040 closure).
         Without this, App Insights' standard SDK does NOT capture StackExchange.Redis
         dependency calls. Pinned to 1.12.0-beta.1 (current stable-ish for OTel 1.15.x). -->
    <PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.12.0-beta.1" />
    <!-- spaarke-redis-cache-remediation-r1 R7-S7 closure (2026-06-26): wire the OTel pipeline
         to Azure Monitor so the 12 registered Meters + AddRedisInstrumentation() actually
         flow to App Insights. Replaces classic AddApplicationInsightsTelemetry() in Program.cs. -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />

    <!-- Polly (CRITICAL - must be 8.x) -->
    <PackageReference Include="Polly" Version="8.7.0" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.8" />
    <PackageReference Include="QuestPDF" Version="2025.12.1" />

    <!-- net10 retarget (task 004): System.Text.RegularExpressions AND System.Security.Cryptography.Xml
         CVE-override pins REMOVED. NU1510 confirmed the net10 framework supersedes both (framework 10.0.x
         version ≥ the CVE-fixed pins). This also clears the 8 HIGH System.Security.Cryptography.Xml 8.0.x
         advisories (GHSA-37gx/w3x6/g8r8/8q5v/cvvh/23rf/mmjf/6588) that the 8.0.4 pin was chasing — the
         framework version is 10.0.x, above all of them. Net reduction in dependency surface (design §6.2).
         Evidence: notes/pin-removals.md (task 004). -->

    <!-- R4 task 080 (2026-05-27): patch OpenMcdf transitive 3.1.0 -> 3.1.4 to fix two CVEs:
         (1) CVE-2026-41511 / GHSA-jxpf-xq2m-q525 (Moderate, DoS via crafted CFB infinite-loop
             in directory traversal); fixed in 3.1.3.
         (2) CVE-2026-45785 / GHSA-5qwm-7pvp-w988 (Moderate, DoS via cyclic directory-tree
             links in TryGetDirectoryEntry); fixed in 3.1.4.
         Real Spaarke exposure: chat now accepts 25 MB attachments per A-4; uploaded legacy
         Office docs (.doc/.xls/.ppt) can lock a BFF thread. Same-minor-version bump. -->
    <PackageReference Include="OpenMcdf" Version="3.2.0" />
    <!-- R4 task 080 (2026-05-27): patch OpenTelemetry.Api transitive 1.15.0 -> 1.15.3 to fix
         CVE-2026-40894 / GHSA-g94r-2vxg-569j (Moderate, memory DoS via malformed propagation
         headers — baggage/B3/Jaeger). Same-minor-version bump. -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.17.0" />

    <!-- Document Generation -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />

    <!-- Compose R3 E1 redline engine: NO external diff dependency. The E1 delta save synthesizes the
         tracked-change redline itself (ComposeParagraphRedlineSynthesizer, Option C — design §4.2):
         a word-level diff of each paraId-keyed edited paragraph, emitted as native w:ins/w:del via
         DocumentFormat.OpenXml (already referenced above). The originally-planned Docxodus WmlComparer
         (task 001) was REMOVED after the NFR-09 hardening gate (task 003) proved WmlComparer strips
         w14:paraId + drops tables on real firm templates in BOTH 6.4.0 (net8) and 7.1.0 (net10) —
         so removing it also drops the transitive SkiaSharp packages + their native-asset exclusions. -->

    <!-- Power BI Embedded Reporting (PBI-001) -->
    <PackageReference Include="Microsoft.PowerBI.Api" Version="4.21.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Spaarke.Core\Spaarke.Core.csproj" />
    <ProjectReference Include="..\..\shared\Spaarke.Dataverse\Spaarke.Dataverse.csproj" />
    <!-- R3 task 010 (FR-2.1): Spaarke.Scheduling in-process job host (~50KB Cronos). -->
    <ProjectReference Include="..\..\shared\Spaarke.Scheduling\Spaarke.Scheduling.csproj" />
  </ItemGroup>

  <!-- Insights Engine playbook node configs (.json) — loaded at runtime by the
       the playbook execution path. The Web SDK auto-includes .json as Content by default; we
       Update to set CopyToOutputDirectory.
       Wave C-G4 (task 022) retired the on-disk Prompts/ directory (.txt + .schema.json).
       Prompts now live in sprk_analysisaction.sprk_systemprompt rows (per Wave C2 / 021).  -->
  <ItemGroup>
    <Content Update="Services\Ai\Insights\Playbooks\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Registration email templates embedded as resources -->
  <ItemGroup>
    <EmbeddedResource Include="Services\Registration\EmailTemplates\*.html" />
  </ItemGroup>

  <!-- Exclude template config from publish - all config comes from Azure App Settings -->
  <ItemGroup>
    <Content Update="appsettings.template.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- FR-A2: exclude JS sourcemaps from publish (keep in source tree for dev debugging) -->
  <ItemGroup>
    <Content Update="wwwroot\**\*.js.map" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
