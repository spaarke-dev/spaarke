<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Spaarke.Dataverse</AssemblyName>
    <RootNamespace>Spaarke.Dataverse</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Core" Version="1.50.0" />
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.87.0" />
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.26" />

    <!-- net10 retarget (task 003): System.Formats.Asn1 / System.Text.Json / System.Text.RegularExpressions
         CVE pins REMOVED — NU1510 confirmed the net10 framework supersedes them (framework version ≥ the
         CVE-fixed pin). System.Security.Cryptography.Pkcs is NOT framework-pruned (no NU1510) so its pin is
         retained until the transitive graph is confirmed ≥ 8.0.1. Evidence: notes/pin-removals.md. -->
    <!-- CVE-2023-29331 (HIGH): System.Security.Cryptography.Pkcs 6.0.1 → 8.0.1; bumped to 10.0.11 (task 004)
         to match the S.S.C.Xml 10.0.11 pin below, which drags Pkcs >= 10.0.11 (would otherwise NU1605). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.11" />
    <!-- net10 retarget (task 004): pin System.Security.Cryptography.Xml to a non-vulnerable 10.0.x.
         The transitive 8.0.2 (via Dataverse.Client/MSAL) carries 8 HIGH advisories that NoWarn=NU1903
         was silently masking. Non-web lib → framework does NOT prune S.S.C.Xml (no NU1510) → explicit
         override required. 10.0.11 clears all 8. Enabled deleting NoWarn=NU1903. Owner Option 1, 2026-08-11. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internal members to the test assembly (unified-access-control-r2 task 005, FR-04).
         Matches the established Sprk.Bff.Api.csproj convention: the rights mapper is `internal` rather
         than `private` so it can be exercised directly, WITHOUT reflection into a private member
         (banned by ADR-038 §7 / tests CLAUDE.md ban B8). Its acceptance criterion — "the snapshot never
         exceeds the caller's actual Dataverse rights, asserted by test with a mocked Dataverse answer" —
         is not satisfiable any other way: the surrounding call is an HTTP request, and mocking that
         transport is banned by B1. -->
    <InternalsVisibleTo Include="Sprk.Bff.Api.Tests" />
  </ItemGroup>

</Project>