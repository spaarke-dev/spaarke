<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Spaarke.Core</AssemblyName>
    <RootNamespace>Spaarke.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />

    <!-- net10 retarget (task 003): System.Formats.Asn1 / System.Text.Json / System.Text.RegularExpressions
         CVE pins REMOVED — NU1510 confirmed the net10 framework supersedes them (framework version ≥ the
         CVE-fixed pin). System.Security.Cryptography.Pkcs is NOT framework-pruned (no NU1510) so its pin is
         retained until the transitive graph is confirmed ≥ 8.0.1. Evidence: notes/pin-removals.md. -->
    <!-- CVE-2023-29331 (HIGH): System.Security.Cryptography.Pkcs 6.0.1 → 8.0.1; bumped to 10.0.11 (task 004), then 10.0.13 on 2026-10-13 (GHSA-846f-f764-76mx, HIGH),
         to match the S.S.C.Xml 10.0.11 pin below, which drags Pkcs >= 10.0.11 (would otherwise NU1605). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- net10 retarget (task 004): pin System.Security.Cryptography.Xml to a non-vulnerable 10.0.x.
         The transitive 8.0.2 (via Dataverse.Client/MSAL) carries 8 HIGH advisories that NoWarn=NU1903
         was silently masking. This lib is non-web so the framework does NOT prune S.S.C.Xml (no NU1510) —
         an explicit override is required. 10.0.11 cleared all 8 advisories; bumped to 10.0.13 on 2026-10-13
         (GHSA-r955-8q5j-3h83, -7hqp-7c5m-4vq6, -c399-9853-6jmj, HIGH). This let NoWarn=NU1903 be
         deleted. Owner-approved Option 1, 2026-08-11. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spaarke.Dataverse\Spaarke.Dataverse.csproj" />
  </ItemGroup>

</Project>