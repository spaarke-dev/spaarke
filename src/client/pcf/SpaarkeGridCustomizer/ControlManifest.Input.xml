<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="Spaarke.Controls" constructor="SpaarkeGridCustomizer" version="1.1.0" display-name-key="Spaarke Grid Customizer" description-key="Power Apps grid customizer: the four core-ancestor root columns are not editable; regarding links" control-type="virtual">
    <external-service-usage enabled="false">
    </external-service-usage>
    <!--
      The Power Apps grid customizer contract (Microsoft Learn, "Customize the editable grid control"):
      the grid passes EventName, and init fires that event with the cell renderer / editor overrides.
      v1.1.0 (unified-access-control-r2 task 168 f1) replaced the earlier data-set element, which the
      grid never used, with this property.
    -->
    <property name="EventName" display-name-key="EventName" description-key="End point to communicate with the Power Apps grid" of-type="SingleLine.Text" usage="input" required="true" />
    <resources>
      <code path="index.ts" order="1" />
      <css path="styles.css" order="1" />
      <!-- Platform-provided libraries: DO NOT bundle -->
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>
    <feature-usage>
      <uses-feature name="Utility" required="true" />
    </feature-usage>
  </control>
</manifest>
