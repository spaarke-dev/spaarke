<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="Spaarke" constructor="SpeDocumentViewer" version="1.0.29" display-name-key="SpeDocumentViewer" description-key="SpeDocumentViewer_Desc" control-type="virtual">
    <external-service-usage enabled="true">
      <domain>*.azurewebsites.net</domain>
      <domain>login.microsoftonline.com</domain>
    </external-service-usage>

    <!-- REQUIRED: At least one bound property for field control discoverability -->
    <property name="value"
              display-name-key="Value_Display_Key"
              description-key="Value_Desc_Key"
              of-type="SingleLine.Text"
              usage="bound"
              required="true" />

    <!-- Document ID (optional - defaults to form record ID) -->
    <property name="documentId"
              display-name-key="DocumentId_Display_Key"
              description-key="Document ID (GUID). If empty, uses form record ID."
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <!-- BFF API Configuration -->
    <!-- bffApiUrl property removed in v1.0.27 (task 024). The PCF now resolves the
         BFF base URL from the Dataverse environment variable sprk_BffApiBaseUrl at
         init time (via getApiBaseUrl in pcf/shared/utils/environmentVariables.ts).
         Single source of truth across all Spaarke clients (Code Pages, PCFs).
         Existing form customizations may show a warning about the removed property
         — Power Apps will simply ignore the stored value. -->

    <!-- Auth properties: OPTIONAL and IGNORED since v1.0.28 (task 124, #1453). The control
         reads sprk_TenantId (else the Xrm organization tenant), sprk_MsalClientId and
         sprk_BffApiAppId; a missing or non-GUID value fails closed (no /organizations).
         The form's values are dev ids shipped in SpaarkeMaster, so they are never used.
         Kept, not removed, so existing form customizations stay valid. -->
    <property name="clientAppId"
              display-name-key="ClientAppId_Display_Key"
              description-key="Ignored since v1.0.28 (sprk_MsalClientId is used)"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <property name="bffAppId"
              display-name-key="BffAppId_Display_Key"
              description-key="Ignored since v1.0.28 (sprk_BffApiAppId is used)"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <property name="tenantId"
              display-name-key="TenantId_Display_Key"
              description-key="Ignored since v1.0.28 (sprk_TenantId, else the Xrm organization tenant, is used)"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <!-- Feature Flags -->
    <property name="enableEdit"
              display-name-key="EnableEdit_Display_Key"
              description-key="Enable check-out/check-in editing workflow"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="true" />

    <property name="enableDelete"
              display-name-key="EnableDelete_Display_Key"
              description-key="Enable delete document button"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="false" />

    <property name="enableDownload"
              display-name-key="EnableDownload_Display_Key"
              description-key="Enable download document button"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="true" />

    <property name="showToolbar"
              display-name-key="ShowToolbar_Display_Key"
              description-key="Show toolbar with document actions (set false when using ribbon buttons)"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="false" />

    <!-- UI Configuration -->
    <property name="controlHeight"
              display-name-key="ControlHeight_Display_Key"
              description-key="Minimum height in pixels (responsive)"
              of-type="Whole.None"
              usage="input"
              required="false"
              default-value="600" />

    <resources>
      <code path="index.ts" order="1"/>
      <css path="css/SpeDocumentViewer.css" order="1" />
      <resx path="strings/SpeDocumentViewer.1033.resx" version="1.0.0" />
      <!-- Host-provided libraries: DO NOT bundle React/Fluent -->
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>

    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
      <uses-feature name="Utility" required="true" />
    </feature-usage>
  </control>
</manifest>
