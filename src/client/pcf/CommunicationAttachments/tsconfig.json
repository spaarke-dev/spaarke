{
  "extends": "./node_modules/pcf-scripts/tsconfig_base.json",
  "compilerOptions": {
    "outDir": "./out",
    "typeRoots": ["node_modules/@types"],
    "jsx": "react",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "@spaarke/communication-components/logic/attachments": [
        "../../shared/Spaarke.Communication.Components/src/logic/attachments/index"
      ],
      "@spaarke/communication-components/components/AttachmentList": [
        "../../shared/Spaarke.Communication.Components/src/components/AttachmentList/index"
      ],
      "@spaarke/communication-components/*": ["../../shared/Spaarke.Communication.Components/src/*"]
    }
  },
  "exclude": [
    "node_modules",
    "out",
    "__tests__",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
