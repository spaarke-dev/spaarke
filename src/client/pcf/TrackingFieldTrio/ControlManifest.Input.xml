<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="Spaarke.Controls"
           constructor="TrackingFieldTrio"
           version="1.0.13"
           display-name-key="Tracking Field Trio"
           description-key="Compact 3-field control for tracking flags (v1.0.13). Combines two Yes/No toggles (Monitor, High Priority) with a 3-value segmented picker (Access Permission), plus an opt-in governance toolbar (grant-access modal + email-members icons). The grant modal is polymorphic across Project/Matter/Work Assignment and uses the side-pane Advanced Lookup for the contact + organization pickers. Designed to fit inside a 33% form column."
           control-type="standard">
    <!-- task 041 — the grant modal calls the BFF external-access endpoints via
         @spaarke/auth's authenticatedFetch (MSAL), so this control now needs
         external-service-usage declared for the auth + BFF hosts, mirroring
         SemanticSearchControl's manifest. -->
    <external-service-usage enabled="true">
      <domain>*.azurewebsites.net</domain>
      <domain>login.microsoftonline.com</domain>
    </external-service-usage>

    <property name="monitor"
              display-name-key="Monitor"
              description-key="Bound Two-Option field for the Monitor flag"
              of-type="TwoOptions"
              usage="bound"
              required="true" />

    <property name="highPriority"
              display-name-key="High Priority"
              description-key="Bound Two-Option field for the High Priority flag"
              of-type="TwoOptions"
              usage="bound"
              required="true" />

    <property name="accessPermission"
              display-name-key="Access Permission"
              description-key="Bound OptionSet field with three values: Standard (100000000), Limited (100000001), Restricted (100000002)"
              of-type="OptionSet"
              usage="bound"
              required="true" />

    <!-- v1.0.1 — display toggles. v1.0.3 — showTitle default flipped to true
         so captions render out of the box (matches the visual rhythm of the
         standard field labels on adjacent cards). Set to No in form editor
         to hide when a compact layout is preferred. -->
    <property name="showTitle"
              display-name-key="Show Title"
              description-key="Show the field caption labels (Monitor, High Priority, Access Permission) above each control. When hidden, the row moves up. Default: visible."
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="true" />

    <property name="showVersion"
              display-name-key="Show Version"
              description-key="Show the version badge in the bottom-right corner. Default: hidden."
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="false" />

    <!-- v1.0.9 (task 041, teams-app-r1) — auth config for the access-grant
         modal's BFF calls (@spaarke/auth). Mirrors SemanticSearchControl's
         established property naming. All optional: when omitted, @spaarke/auth
         falls back to window.__SPAARKE_MSAL_CLIENT_ID__ / __SPAARKE_BFF_URL__
         (see authInit.ts), so an environment that already sets those globals
         needs no manifest configuration. -->
    <property name="apiBaseUrl"
              display-name-key="API Base URL"
              description-key="BFF API base URL used by the access-grant modal (task 041)"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <property name="clientAppId"
              display-name-key="Client App ID"
              description-key="Azure AD application (client) ID for PCF MSAL authentication"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <property name="bffAppId"
              display-name-key="BFF App ID"
              description-key="BFF API application ID for OAuth scope construction"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <resources>
      <code path="index.ts" order="1" />
      <css path="styles.css" order="1" />
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>

    <!-- v1.0.13 (external-access-r2 task 073 UAT fix) — the access-grant modal + email-members
         read the record's role fields / existing grants via context.webAPI.retrieveRecord /
         retrieveMultipleRecords (host-context, per DATA-ACCESS-DECISION-CRITERIA.md). That API is
         only available when the WebAPI feature is declared here; without it every read throws
         "Feature 'WebAPI.retrieveRecord' is required ... in the <uses-feature> section", surfacing as
         the modal's "Failed to load access data" error. Latent since teams-app-r1 (task 041/042 wired
         the webAPI reads but never added this declaration — the modal was never opened live). -->
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>
