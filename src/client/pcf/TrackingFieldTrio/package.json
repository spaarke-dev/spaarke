{
  "name": "spaarke-tracking-field-trio",
  "version": "1.0.0",
  "description": "PCF field control that combines Monitor + High Priority toggles with an Access Permission segmented picker in a compact 3-column layout",
  "scripts": {
    "prebuild": "node ../../shared/Spaarke.UI.Components/scripts/ensure-dist-fresh.js",
    "build": "pcf-scripts build",
    "prebuild:prod": "node ../../shared/Spaarke.UI.Components/scripts/ensure-dist-fresh.js",
    "build:prod": "pcf-scripts build --buildMode production",
    "clean": "pcf-scripts clean",
    "lint": "pcf-scripts lint",
    "lint:fix": "pcf-scripts lint fix",
    "rebuild": "pcf-scripts rebuild",
    "start": "pcf-scripts start",
    "start:watch": "pcf-scripts start watch",
    "refreshTypes": "pcf-scripts refreshTypes"
  },
  "dependencies": {
    "@spaarke/auth": "file:../../shared/Spaarke.Auth",
    "@spaarke/ui-components": "file:../../shared/Spaarke.UI.Components",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@azure/msal-browser": "^3.30.0",
    "@fluentui/react-components": "^9.46.0",
    "@fluentui/react-icons": "^2.0.0",
    "@microsoft/eslint-plugin-power-apps": "^0.2.51",
    "@types/node": "^18.19.0",
    "@types/powerapps-component-framework": "^1.3.15",
    "@types/react": "^16.14.0",
    "@types/react-dom": "^16.9.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "pcf-scripts": "^1",
    "pcf-start": "^1",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "typescript": "^5.0.0"
  }
}
