{
  "extends": "./node_modules/pcf-scripts/tsconfig_base.json",
  "compilerOptions": {
    "outDir": "./out",
    "typeRoots": ["node_modules/@types"],
    "jsx": "react",
    "paths": {
      "@spaarke/ui-components": [
        "../../shared/Spaarke.UI.Components/dist/index"
      ],
      "@spaarke/ui-components/*": ["../../shared/Spaarke.UI.Components/dist/*"],
      "@spaarke/communication-components/logic/connections": [
        "../../shared/Spaarke.Communication.Components/src/logic/connections/index"
      ],
      "@spaarke/communication-components/logic/connections/provenance": [
        "../../shared/Spaarke.Communication.Components/src/logic/connections/provenance"
      ],
      "@spaarke/communication-components/*": [
        "../../shared/Spaarke.Communication.Components/src/*"
      ]
    },
    "baseUrl": "."
  },
  "exclude": [
    "node_modules",
    "out",
    "__tests__",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
