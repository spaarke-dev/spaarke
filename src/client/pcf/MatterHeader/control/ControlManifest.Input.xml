<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="Spaarke.Records" constructor="MatterHeader" version="1.0.1"
           display-name-key="Matter Header"
           description-key="Compact 5-field summary card + 3-action toolbar for Matter records. Part of the record-header-and-notepad-r1 shared primitive set. (v1.0.1)"
           control-type="virtual">

    <!-- Bound field: any SingleLine.Text field on the host entity (Matter). The PCF replaces
         this fields rendering with the custom header card. The bound value itself is not
         semantically important - the PCF reads recordId from context.mode.contextInfo.entityId.
         Common binding: sprk_matternumber. usage=bound + required=true is what makes the PCF
         appear in Dataverses form designer Add component to field gallery. -->
    <property name="boundField" display-name-key="Bound field"
              description-key="Any SingleLine.Text field on the host entity. PCF replaces this fields rendering with the record header card. Bind to sprk_matternumber on Matter for standard placement."
              of-type="SingleLine.Text" usage="bound" required="true" />

    <resources>
      <code path="index.ts" order="1"/>
      <!-- Platform-provided libraries (not bundled) per ADR-022 -->
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>

    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
      <uses-feature name="Utility" required="true" />
      <uses-feature name="Navigation" required="true" />
    </feature-usage>
  </control>
</manifest>
