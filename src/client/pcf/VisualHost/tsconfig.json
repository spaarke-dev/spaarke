{
  "extends": "pcf-scripts/tsconfig_base.json",
  "compilerOptions": {
    "typeRoots": ["node_modules/@types"],
    // "module" intentionally NOT overridden here (task 012,
    // visual-host-create-button-r1) — inherits "es2020" from
    // pcf-scripts/tsconfig_base.json, like every other PCF in this repo (e.g.
    // SemanticSearchControl). The override was originally dropped for the
    // shared `wizardRegistry.ts`'s dynamic `import()` (TS1323 under "es2015");
    // that module was deleted 2026-10-03 (reuse audit C-20), but the inherited
    // default remains the correct, consistent setting.
    "moduleResolution": "node",
    "jsx": "react",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["control/**/*"],
  "exclude": ["control/**/__tests__/**/*"]
}
