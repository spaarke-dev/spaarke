# Production environment
# Placeholders below are overridden at build time: deploy-external-spa.yml sets every VITE_* value from the GitHub
# environment variables of the target environment (`external-spa-prod` for production, `external-spa-dev` for dev), and
# Vite gives process env vars priority over this file. No value is baked here (task 043, FR-20).

# BFF API base URL — dev fallback only (task 041): the backend is selected at run time (T240c directory, or
# VITE_BACKENDS / this one-entry fallback until it ships). An unsubstituted placeholder counts as unset.
VITE_BFF_API_URL=#{BFF_API_URL}#

# Optional backend list (JSON; see .env.example) - when set it replaces the one-entry VITE_BFF_API_URL fallback.
# An unset or empty value, or this placeholder, counts as unset.
VITE_BACKENDS=#{BACKENDS}#

# MSAL / Entra External ID (CIAM) authentication (authorization code + PKCE)
# MSAL_AUTHORITY = full CIAM authority URL (https://{subdomain}.ciamlogin.com/{ciam-tenant-id})
# MSAL_CLIENT_ID = SPA public-client app registered in the CIAM tenant
# MSAL_BFF_SCOPE = api://{ciam-bff-api-app-id}/user_impersonation (must match BFF Ciam:Audience; ADR-028 A8 — any
#   other scope is refused; dev fallback only, task 041)
VITE_MSAL_AUTHORITY=#{MSAL_AUTHORITY}#
VITE_MSAL_CLIENT_ID=#{MSAL_CLIENT_ID}#
VITE_MSAL_TENANT_ID=#{MSAL_TENANT_ID}#
VITE_MSAL_BFF_SCOPE=#{MSAL_BFF_SCOPE}#

# Workforce plane (Teams host + the stored-link guest token) — ADR-028 Amendment A8 (task 040) — optional;
# getWorkforceEnvConfig() in config.ts throws a fail-loud error only if the workforce plane is actually used
# AND these are still unsubstituted. CI/CD (deploy-external-spa.yml) overrides them at build time from the environment variables.
# TEAMS_MSAL_CLIENT_ID = the single-tenant Spaarke public client; TEAMS_MSAL_TENANT_ID = Spaarke's tenant id (GUID;
# the authority is pinned to it); TEAMS_MSAL_BFF_SCOPE = api://{customer BFF app id}/user_impersonation.
VITE_TEAMS_MSAL_CLIENT_ID=#{TEAMS_MSAL_CLIENT_ID}#
VITE_TEAMS_MSAL_TENANT_ID=#{TEAMS_MSAL_TENANT_ID}#
VITE_TEAMS_MSAL_BFF_SCOPE=#{TEAMS_MSAL_BFF_SCOPE}#

# Workforce HOME sign-in (the browser "company account" choice) - ADR-028 Amendment A9 (task 058) - REQUIRED: the
# deploy-external-spa.yml preflight fails closed when the repo variable VITE_WORKFORCE_HOME_MSAL_CLIENT_ID is unset or not
# a GUID (the SPA itself reads it only when that sign-in is used). WORKFORCE_HOME_MSAL_CLIENT_ID = the ONE multitenant public client (authority `organizations`
# for sign-in only; a different application from TEAMS_MSAL_CLIENT_ID - deploy-external-spa.yml fails closed if equal).
VITE_WORKFORCE_HOME_MSAL_CLIENT_ID=#{WORKFORCE_HOME_MSAL_CLIENT_ID}#
