# Development environment — Spaarke External Access (CIAM external tenant: spaarkeextid)
# This file is committed. Do NOT put secrets here.
# For local overrides, use .env.local (gitignored).

# BFF API base URL — the dev backend (task 041: the one-entry dev fallback list; VITE_BACKENDS is unset here, so this
# URL plus the two scopes below make dev's single configured backend, customer key "default").
VITE_BFF_API_URL=https://spaarke-bff-dev.azurewebsites.net

# MSAL / Entra External ID (CIAM) authentication (authorization code + PKCE)
# CIAM external tenant: spaarkeextid.onmicrosoft.com (7052feba-bfc4-43e0-b09e-65014b429131)
VITE_MSAL_AUTHORITY=https://spaarkeextid.ciamlogin.com/7052feba-bfc4-43e0-b09e-65014b429131
VITE_MSAL_TENANT_ID=7052feba-bfc4-43e0-b09e-65014b429131

# CIAM app registrations (created in the CIAM tenant 2026-07-20 — DI-028-01 resolved):
#   SPA public client:  Spaarke External Workspace SPA  (bd57e54e-b339-4500-b55c-e451009fd907)
#   BFF API (audience): Spaarke External BFF API        (4a4d5126-91b0-4865-8e3a-134b7209013e)
#   SPA→BFF delegated permission: user_impersonation (ADR-028 A7, both planes; task 041 removed the former scope).
#   OWNER STEP before this works live: expose user_impersonation on 4a4d5126 and grant + admin-consent it to the
#   SPA client (projects/spaarke-SPA-external-access-platform-r3/notes/task-041-notes.md).
VITE_MSAL_CLIENT_ID=bd57e54e-b339-4500-b55c-e451009fd907
VITE_MSAL_BFF_SCOPE=api://4a4d5126-91b0-4865-8e3a-134b7209013e/user_impersonation

# Workforce plane — browser "My organization" and the Teams tab (ADR-028 Amendment A7; task 040, FR-16).
# One single-tenant Spaarke public client in Spaarke's tenant; authority
# https://login.microsoftonline.com/{VITE_TEAMS_MSAL_TENANT_ID} (organizations/common are refused);
# scope api://{customer BFF app id}/user_impersonation (the only scope A7 allows). The key names keep
# their VITE_TEAMS_ prefix (already wired in CI) although the browser workforce plane reads them too.
#
# INTERIM CLIENT ID: the dedicated single-tenant client ("Spaarke Workspace") is not registered yet
# (owner step 1 in projects/spaarke-SPA-external-access-platform-r3/notes/task-040-notes.md). Until it
# is, dev keeps the dev BFF app (SDAP-BFF-SPE-API) as its own client, which A7 retires. REPLACE the
# client id below with the new registration's client id once it exists.
VITE_TEAMS_MSAL_CLIENT_ID=1e40baad-e065-4aea-a8d4-4b7ab273458c
# Spaarke's tenant (config/environments.json dev.tenantId).
VITE_TEAMS_MSAL_TENANT_ID=a221a95e-6abc-4434-aecc-e48338a1b2f2
# Dev BFF app's user_impersonation scope (config/environments.json dev.appRegistrations.bffApi.scopeUri).
VITE_TEAMS_MSAL_BFF_SCOPE=api://1e40baad-e065-4aea-a8d4-4b7ab273458c/user_impersonation
