# Copy this file to .env.local and fill in the values for your local environment.
# .env.local is gitignored — never commit real secrets.
#
# For local development, .env.development provides dev defaults.
# For production, CI/CD token substitution populates .env.production.

# BFF API base URL (Spaarke backend)
VITE_BFF_API_URL=https://your-bff-api.azurewebsites.net

# MSAL / Entra External ID (CIAM) authentication
# Full CIAM authority URL: https://{subdomain}.ciamlogin.com/{ciam-tenant-id}
VITE_MSAL_AUTHORITY=https://your-subdomain.ciamlogin.com/your-ciam-tenant-id
# SPA public-client app registration (registered IN the CIAM tenant) client ID
VITE_MSAL_CLIENT_ID=your-ciam-spa-client-id
# CIAM external tenant ID
VITE_MSAL_TENANT_ID=your-ciam-tenant-id
# BFF API scope — BFF API app exposed in the CIAM tenant (must match BFF Ciam:Audience)
VITE_MSAL_BFF_SCOPE=api://your-ciam-bff-app-id/SDAP.Access
