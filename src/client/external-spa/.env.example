# Copy this file to .env.local and fill in the values for your local environment.
# .env.local is gitignored — never commit real secrets.
#
# For local development, .env.development provides dev defaults.
# For production, CI/CD token substitution populates .env.production.

# Customer backends (task 041, FR-17). The SPA picks the BFF URL and scope at RUN TIME from Spaarke-owned data —
# the T240c directory once it ships, dev configuration until then — never from a link or query string (a link may
# carry only ?customer={key}, which must match a configured/directory key or it is ignored). The scope on BOTH planes
# is api://{bffAppId}/user_impersonation (ADR-028 A7).
#
# Option A — a backend list (JSON; one line). ciamBffAppId is optional: a dev-only override when the CIAM audience is
# a separate app in the CIAM tenant (on a stamp the customer BFF app is also the CIAM audience).
# VITE_BACKENDS=[{"customerKey":"contoso","displayName":"Contoso","bffBaseUrl":"https://contoso-bff.example.net","bffAppId":"your-contoso-bff-app-id"},{"customerKey":"fabrikam","displayName":"Fabrikam","bffBaseUrl":"https://fabrikam-bff.example.net","bffAppId":"your-fabrikam-bff-app-id","ciamBffAppId":"your-fabrikam-ciam-bff-app-id"}]
#
# Option B (used when VITE_BACKENDS is unset) — ONE backend: this URL, with the app ids taken from
# VITE_TEAMS_MSAL_BFF_SCOPE (workforce) and VITE_MSAL_BFF_SCOPE (CIAM) below.
VITE_BFF_API_URL=https://your-bff-api.azurewebsites.net
#
# T240c directory service client (a stub until provisioning task 240c ships; 'true' fails closed until then).
# VITE_USE_DIRECTORY_SERVICE=false

# MSAL / Entra External ID (CIAM) authentication
# Full CIAM authority URL: https://{subdomain}.ciamlogin.com/{ciam-tenant-id}
VITE_MSAL_AUTHORITY=https://your-subdomain.ciamlogin.com/your-ciam-tenant-id
# SPA public-client app registration (registered IN the CIAM tenant) client ID
VITE_MSAL_CLIENT_ID=your-ciam-spa-client-id
# CIAM external tenant ID
VITE_MSAL_TENANT_ID=your-ciam-tenant-id
# Option B CIAM backend scope — the BFF API app exposed in the CIAM tenant (must match BFF Ciam:Audience).
# Only .../user_impersonation is accepted (ADR-028 A7, both planes; the former CIAM-only scope is refused).
VITE_MSAL_BFF_SCOPE=api://your-ciam-bff-app-id/user_impersonation

# Workforce plane — browser "My organization" and the Teams tab (ADR-028 Amendment A7; task 040, FR-16).
# OPTIONAL: only required when a caller signs in on the workforce plane (inside Teams, or the browser
# "My organization" choice); the CIAM-only SPA builds and runs without these.
# One single-tenant public client registered in Spaarke's tenant (not the BFF app registration).
VITE_TEAMS_MSAL_CLIENT_ID=your-spaarke-workspace-single-tenant-client-id
# Spaarke's Entra tenant id (a GUID). The authority is https://login.microsoftonline.com/{this id};
# organizations / common / consumers are refused.
VITE_TEAMS_MSAL_TENANT_ID=your-spaarke-tenant-id-guid
# Option B workforce backend scope — the customer BFF app's delegated scope. Only .../user_impersonation is
# accepted (ADR-028 A7). Not needed when VITE_BACKENDS is set.
VITE_TEAMS_MSAL_BFF_SCOPE=api://your-customer-bff-app-id/user_impersonation
