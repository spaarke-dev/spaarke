{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@spaarke/ui-components": ["../Spaarke.UI.Components/dist/index.d.ts"],
      "@spaarke/ui-components/*": ["../Spaarke.UI.Components/dist/*"],
      "@spaarke/auth": ["../Spaarke.Auth/dist/index.d.ts"],
      // @spaarke/communication-components — declaration-only build (mirrors
      // the ui-components dist-based mapping above); required because
      // this package's own build is a REAL `tsc` emit with an explicit
      // `rootDir` — mapping to raw SOURCE pulled files outside that rootDir
      // into the program (TS6059). messaging-communication-app-r2 task 030.
      //
      // BUILD ORDER (Pattern D P-11, 2026-11-18): these entries need the package's `dist/`, which a clean checkout
      // does not have. Build it first: `npm --prefix ../Spaarke.Communication.Components run build` (its `prebuild`
      // builds Auth + UI.Components); `.github/workflows/ci-standalone-checks.yml` does the same before this
      // package's `tsc --noEmit`. Pointing these at `src/` instead was tried and does NOT work: this package's
      // `tsc` emit has `rootDir: ./src`, so the source of a sibling package fails with TS6059 (verified with both
      // `tsc --noEmit` and `tsc`). Without a `dist/`, TypeScript falls back to the linked package's own `types`
      // (`src/index.ts`) and the check still passes; the hazard is the opposite one: a STALE `dist/` is used
      // silently, so rebuild it after changing that package's exports.
      "@spaarke/communication-components": ["../Spaarke.Communication.Components/dist/index.d.ts"],
      "@spaarke/communication-components/*": ["../Spaarke.Communication.Components/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.spec.tsx",
    "**/*.test.tsx",
    "**/__tests__",
    "**/__mocks__",
    "**/__test-harness__"
  ]
}
