{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "isolatedModules": false,
    "jsx": "react-jsx",
    "types": ["node", "jest", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "@spaarke/auth": ["./test/__mocks__/spaarke-auth.ts"],
      "@spaarke/ui-components": ["./test/__mocks__/spaarke-ui-components.tsx"],
      "@spaarke/ui-components/services": ["./test/__mocks__/spaarke-ui-components-services.ts"],
      // Type-only subpath (task 092, 2026-10-04): DailyBriefingApp.tsx imports
      // `ILookupItem` via `import type`, which is erased at runtime (no mock
      // needed), but ts-jest's diagnostics still resolve it at compile time.
      // Unlike the bare specifier above, no wildcard `@spaarke/ui-components/*`
      // path existed here at all (the base tsconfig.json has one, pointing at
      // dist/*, but tsconfig.test.json doesn't extend it for paths — paths
      // don't merge across `extends`). Point this one narrow subpath straight
      // at the real compiled declaration rather than adding a broad wildcard
      // that could silently stop routing other subpaths through their mocks.
      "@spaarke/ui-components/types/LookupTypes": ["../Spaarke.UI.Components/dist/types/LookupTypes.d.ts"],
      "@spaarke/compose-components": ["./test/__mocks__/spaarke-compose-components.tsx"],
      "@spaarke/ai-widgets": ["./test/__mocks__/spaarke-ai-widgets.tsx"]
    }
  },
  "include": ["src", "test"]
}
