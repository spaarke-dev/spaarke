{
  "name": "@spaarke/notifications",
  "version": "1.0.0",
  "description": "Host-agnostic Spaarke notification-spine client library — negotiates + connects to the Layer-C SignalR delivery service, routes incoming envelopes by kind, and falls back to poll on disconnect (spec FR-05).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2"
  },
  "keywords": [
    "spaarke",
    "notifications",
    "signalr",
    "push",
    "notification-spine"
  ],
  "author": "Spaarke Engineering Team",
  "license": "UNLICENSED",
  "peerDependencies": {
    "@microsoft/signalr": "^8.0.0",
    "@spaarke/auth": "*"
  },
  "devDependencies": {
    "@microsoft/signalr": "^8.0.7",
    "@spaarke/auth": "file:../Spaarke.Auth",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.4",
    "typescript": "^5.3.3"
  }
}
