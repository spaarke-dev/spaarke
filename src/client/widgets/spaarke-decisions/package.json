    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
