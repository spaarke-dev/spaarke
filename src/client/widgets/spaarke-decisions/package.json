{
  "name": "spaarke-decisions-widget",
  "version": "1.0.0",
  "private": true,
  "description": "Spaarke MCP App widget ui://spaarke/decisions.html (spaarkeai-mcp-bff-api-r1 task 030). One self-contained HTML file, embedded in Sprk.Bff.Api and served through MCP resources/read.",
  "type": "module",
  "scripts": {
