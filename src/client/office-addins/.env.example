# Office Add-in Configuration
# Copy this file to .env and update ALL values before building.
# All four variables below are REQUIRED — the build will fail if any are missing.

# Azure AD App Registration for Office Add-in
ADDIN_CLIENT_ID=your-addin-client-id-here

# Spaarke Tenant
TENANT_ID=your-tenant-id-here

# BFF API Configuration
BFF_API_CLIENT_ID=your-bff-api-client-id-here
BFF_API_BASE_URL=https://your-bff-api-url-here

# Optional: fallback MSAL popup redirect URI, used only when the Office host does
# NOT support Nested App Authentication (@spaarke/auth's OfficeNaaStrategy legacy-
# client fallback path — see public/auth-callback.html). Defaults to
# `${origin}/auth-callback.html` when unset.
# FALLBACK_REDIRECT_URI=https://your-addin-url/auth-callback.html

# Optional: SmartTodo Code Page URL — enables the Outlook "Create To Do" ribbon action
# (smart-todo-decoupling-r3 FR-27 / task 070).
# When set, the ribbon button opens the CreateTodo wizard from this URL with
# launch-context query params. Leave blank to disable the ribbon action entirely.
# Example: https://your-org.crm.dynamics.com/main.aspx?pagetype=webresource&webresourceName=sprk_smarttodo
# SMARTTODO_CODEPAGE_URL=

# Optional: Dataverse org URL for the SaveView "Quick Create" deep link
# (email-communication-solution-r4 task 072 / FR-25). Config-driven — no add-in
# code may hardcode an org URL. Leave blank to disable Quick Create's Dataverse
# deep-link (degrades to a no-op, not a broken link).
# Example: https://your-org.crm.dynamics.com
# ORG_URL=

# Optional: base URL the unified Outlook manifest's runtime/ribbon URLs point at.
# Defaults to https://localhost:3000 for dev builds and the deployed Azure Static
# Web App (https://icy-desert-0bfdbb61e.6.azurestaticapps.net) for production
# builds. Override only for a custom domain.
# ADDIN_BASE_URL=
