{
  "name": "ap-export",
  "version": "1.0.0",
  "private": true,
  "description": "AP Export - dialog Code Page opened from the sprk_invoice and sprk_billingexport ribbons: export a selection of invoices to AP as one batch (task 150 route), download the batch files and mark Sent to AP invoices Paid (task 151a routes). ebilling-r1 task 151b, EB-D-181. Web resource sprk_apexport.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "node ../../../scripts/tsc-surface-gate.mjs",
    "check:html-reset": "node ../../../scripts/check-html-css-reset.mjs",
    "build": "node ../../../scripts/check-html-css-reset.mjs && node ../../../scripts/tsc-surface-gate.mjs && vite build && node --input-type=module -e \"import{renameSync}from'fs';renameSync('dist/index.html','dist/sprk_apexport.html');\"",
    "preview": "vite preview",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.6.2",
    "@fluentui/react-components": "^9.54.0",
    "@fluentui/react-icons": "^2.0.323",
    "@hello-pangea/dnd": "^18.0.1",
    "@lexical/html": "^0.42.0",
    "@lexical/list": "^0.42.0",
    "@lexical/react": "^0.42.0",
    "@lexical/rich-text": "^0.42.0",
    "@lexical/selection": "^0.42.0",
    "@microsoft/applicationinsights-web": "^3.3.11",
    "@microsoft/signalr": "^8.0.0",
    "@spaarke/auth": "file:../../client/shared/Spaarke.Auth",
    "@spaarke/ui-components": "file:../../client/shared/Spaarke.UI.Components",
    "d3-force": "^3.0.0",
    "diff": "^8.0.4",
    "dompurify": "^3.4.17",
    "lexical": "^0.42.0",
    "mammoth": "^1.13.0",
    "marked": "^17.0.6",
    "pdfjs-dist": "^6.4.299",
    "react-window": "^1.8.11",
    "scheduler": "^0.27.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "jest": "^30.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "overrides": {
    "@nevware21/ts-utils": "^0.14.0"
  }
}
