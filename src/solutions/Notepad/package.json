{
  "name": "sprk-notepad",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Standalone entity-agnostic Notepad code page for Spaarke. Reads/writes sprk_memo via Xrm.WebApi using the PolymorphicResolverService pattern.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').renameSync('dist/index.html','dist/notepad.html')\"",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.54.0",
    "@fluentui/react-icons": "^2.0.0",
    "@spaarke/ui-components": "file:../../client/shared/Spaarke.UI.Components"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "ts-jest": "^29.4.4",
    "typescript": "~5.7.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
