{
  "name": "email-page",
  "version": "1.0.0",
  "private": true,
  "description": "Email - standalone Code Page rendering the shared EmailWorkspace surface (email-communication-solution-r5 task 042, FR-02/NFR-07)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "node ../../../scripts/tsc-surface-gate.mjs",
    "check:html-reset": "node ../../../scripts/check-html-css-reset.mjs",
    "build": "node ../../../scripts/check-html-css-reset.mjs && node ../../../scripts/tsc-surface-gate.mjs && vite build && node --input-type=module -e \"import{renameSync}from'fs';renameSync('dist/index.html','dist/sprk_emailpage.html');\"",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.6.2",
    "@fluentui/react-components": "^9.54.0",
    "@fluentui/react-icons": "^2.0.323",
    "@microsoft/applicationinsights-web": "^3.3.11",
    "@microsoft/signalr": "^8.0.0",
    "@spaarke/auth": "file:../../client/shared/Spaarke.Auth",
    "@spaarke/communication-components": "file:../../client/shared/Spaarke.Communication.Components",
    "@spaarke/ui-components": "file:../../client/shared/Spaarke.UI.Components"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "overrides": {
    "@nevware21/ts-utils": "^0.14.0"
  }
}
