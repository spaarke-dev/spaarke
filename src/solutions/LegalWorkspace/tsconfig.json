{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@spaarke/auth": ["../../client/shared/Spaarke.Auth/src/index.ts"],
      "@spaarke/auth/*": ["../../client/shared/Spaarke.Auth/src/*"],
      "@spaarke/ui-components": ["../../client/shared/Spaarke.UI.Components/src/index.ts"],
      "@spaarke/ui-components/*": ["../../client/shared/Spaarke.UI.Components/src/*"],
      "@spaarke/events-components": ["../../client/shared/Spaarke.Events.Components/src/index.ts"],
      "@spaarke/events-components/*": ["../../client/shared/Spaarke.Events.Components/src/*"],
      "@spaarke/communication-components": ["../../client/shared/Spaarke.Communication.Components/src/index.ts"],
      "@spaarke/communication-components/*": ["../../client/shared/Spaarke.Communication.Components/src/*"],
      "@spaarke/ai-widgets": ["../../client/shared/Spaarke.AI.Widgets/src/index.ts"],
      "@spaarke/ai-widgets/*": ["../../client/shared/Spaarke.AI.Widgets/src/*"],
      "@spaarke/daily-briefing-components": ["../../client/shared/Spaarke.DailyBriefing.Components/src/index.ts"],
      "@spaarke/daily-briefing-components/*": ["../../client/shared/Spaarke.DailyBriefing.Components/src/*"],
      "@spaarke/compose-components": ["../../client/shared/Spaarke.Compose.Components/src/index.ts"],
      "@spaarke/compose-components/*": ["../../client/shared/Spaarke.Compose.Components/src/*"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    },
    "typeRoots": ["./node_modules/@types"],
    "types": ["node", "jest", "powerapps-component-framework"]
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
