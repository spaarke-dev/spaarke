        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
      }
      /* Allow scroll but hide scrollbar chrome */
      #root {
        overflow: auto;
        scrollbar-width: none; /* Firefox */
