// | where timestamp > ago(7d) and name == "eventpath.bound_denial"
// | extend event = tostring(customDimensions["event"]), reason = tostring(customDimensions["reason"])
// | summarize denials = sum(valueSum) by day = bin(timestamp, 1d), event, reason
// | order by day desc
