{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/quality/post-edit-lint.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/quality/task-quality-gate.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/reinject-project-state.ps1\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "ask": [
      "Bash(az keyvault secret delete *)",
      "Bash(az keyvault secret purge *)",
      "Bash(az keyvault secret recover *)",
      "Bash(az keyvault secret set *ClientSecret*)",
      "PowerShell(az keyvault secret delete *)",
      "PowerShell(az keyvault secret purge *)",
      "PowerShell(az keyvault secret recover *)",
      "PowerShell(az keyvault secret set *ClientSecret*)",
      "PowerShell(Remove-AzKeyVaultSecret *)",
      "PowerShell(Set-AzKeyVaultSecret *ClientSecret*)"
    ],
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Skill(*)",
      "Task(*)",
      "Bash",
      "PowerShell",
      "mcp__dataverse__read_query",
      "mcp__dataverse__describe",
      "mcp__dataverse__describe_table",
      "mcp__dataverse__list_tables",
      "mcp__dataverse__search",
      "mcp__dataverse__search_data",
      "mcp__dataverse__fetch",
      "mcp__dataverse__create_record",
      "mcp__dataverse__update_record",
      "mcp__dataverse__update_table",
      "Read(//c/code_files/spaarke-wt-ai-document-relationship-visuals/src/client/shared/Spaarke.UI.Components/**)",
      "Bash(xargs -I {} basename {})",
      "Read(//c/code_files/spaarke-wt-sdap-file-upload-document-r2/**)",
      "Bash(npm ls d3-force)"
    ]
  }
}
